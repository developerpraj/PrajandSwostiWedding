    d.setAttribute('role', 'alert');
    d.innerHTML = '<span>' + esc(I18N.t(platform() === 'ios' ? 'inapp.tipIos' : 'inapp.tipAndroid')) + '</span>' +
      '<button type="button" class="btn sm" data-copy>' + esc(I18N.t('pwa.copyLink')) + '</button>' +
      '<button type="button" class="btn ghost sm" data-x aria-label="' + esc(I18N.t('pwa.close')) + '">' + esc(I18N.t('pwa.close')) + '</button>';
    d.addEventListener('click', async e => {
      if (e.target.closest('[data-x]')) { sessionStorage.setItem('inAppHide', '1'); d.remove(); }
      if (e.target.closest('[data-copy]')) { try { await navigator.clipboard.writeText(location.href); e.target.textContent = '✅'; } catch (x) { } }
    });
    document.body.prepend(d);
