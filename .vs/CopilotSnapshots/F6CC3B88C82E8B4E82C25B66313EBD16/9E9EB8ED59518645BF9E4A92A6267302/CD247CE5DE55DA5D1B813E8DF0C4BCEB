  function inAppBrowser(ua) {
    return /FBAN|FBAV|FB_IAB|Messenger|Instagram|WhatsApp|Viber|Line\/|Snapchat|TikTok|MicroMessenger|; wv\)/i.test(ua || navigator.userAgent);
  }

  // WhatsApp/Viber webviews block install, often the file picker, offline caching and Google sign-in.
  function inAppBanner() {
    if (!inAppBrowser() || sessionStorage.getItem('inAppHide') || document.getElementById('inAppBanner')) return;
    const d = document.createElement('div');
    d.id = 'inAppBanner';
