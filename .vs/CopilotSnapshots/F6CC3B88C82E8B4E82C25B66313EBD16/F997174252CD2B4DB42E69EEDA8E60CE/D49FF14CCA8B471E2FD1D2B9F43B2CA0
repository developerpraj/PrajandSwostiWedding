  const KEY = 'lang';
  function mode() {
    return localStorage.getItem(KEY) || window.__defaultLang || 'mix';
  }
  function bi(en, ne) {
    en = en == null ? '' : String(en);
    ne = ne == null ? '' : String(ne);
    const m = mode();
    if (m === 'en') return en || ne;
    if (m === 'ne') return ne || en;
    if (!en) return ne;
    if (!ne || ne === en) return en;
    // Nepanglish: one language per text, never both. Short labels/greetings in Nepali, sentences in English.
    return en.trim().split(/\s+/).length <= 3 ? ne : en;
  }
  function t(key) {
    const p = D[key];
    return p ? bi(p[0], p[1]) : key;
  }
  // Mixed mode as markup: CSS stacks Devanagari above English under 640px instead of side-by-side.
  function biHtml(en, ne) {
    const e = s => String(s).replace(/[&<>"']/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
    en = en == null ? '' : String(en); ne = ne == null ? '' : String(ne);
    return e(bi(en, ne));
  }
  function apply(root) {
    (root || document).querySelectorAll('[data-i18n]').forEach(el => {
      const p = D[el.dataset.i18n];
      if (p && el.tagName !== 'OPTION' && el.tagName !== 'TITLE') el.innerHTML = biHtml(p[0], p[1]);
      else el.textContent = t(el.dataset.i18n);
    });
    (root || document).querySelectorAll('[data-i18n-ph]').forEach(el => { el.placeholder = t(el.dataset.i18nPh); });
    document.documentElement.lang = mode() === 'en' ? 'en' : 'ne';
  }
  function set(m) {
    localStorage.setItem(KEY, m);
    apply();
    document.dispatchEvent(new CustomEvent('langchange'));
  }
  window.I18N = { t: t, bi: bi, biHtml: biHtml, mode: mode, set: set, apply: apply };
})();
