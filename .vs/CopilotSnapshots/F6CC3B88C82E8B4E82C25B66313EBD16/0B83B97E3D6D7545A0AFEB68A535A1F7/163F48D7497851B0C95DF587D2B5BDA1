  // First arrival wins: repeat scans never move CheckedInAt (mirrors firstCheckIn_ in Code.gs).
  function firstIn(t, k, v, at) {
    const r = by(t, k, v);
    if (!r) throw new Error('Not found');
    if (bool(r.CheckedIn) && r.CheckedInAt) return Object.assign({ alreadyIn: true }, r);
    return update(t, k, v, { CheckedIn: 'TRUE', CheckedInAt: at || nowS() });
  }

  function guard(g) {
    if (!g) return;
    if (String(g.LinkRevoked).toUpperCase() === 'TRUE') throw new Error('This invitation link has been turned off. Please contact the family.');
    if (g.LinkExpires && new Date() > new Date(g.LinkExpires)) throw new Error('This invitation link has expired. Please contact the family.');
  }

  function banner() {
    if (document.getElementById('demoBanner')) return;
    const b = document.createElement('div');
