      ' <button type="button" style="background:#fff;color:#3f5d4a;border:0;border-radius:999px;padding:3px 8px;font:inherit;cursor:pointer">Reset</button>';
    b.querySelector('button').onclick = () => window.DEMO_API.reset();
    document.body.appendChild(b);
  }
  // Demo file ids are not real Drive files - swap them for placeholder photos.
  function fixImgs(root) {
    (root.querySelectorAll ? root.querySelectorAll('img') : []).forEach(img => {
      const m = /drive\.google\.com\/thumbnail\?id=(demo[^&]*)/.exec(img.getAttribute('src') || '');
      if (m) img.src = pic(m[1].replace(/^demo/, 'wed'), 800, 800);
    });
  }
  new MutationObserver(list => list.forEach(r => r.addedNodes.forEach(n => n.nodeType === 1 && fixImgs(n.parentNode || n))))
    .observe(document.documentElement, { childList: true, subtree: true });

  if (document.body) banner(); else document.addEventListener('DOMContentLoaded', banner);
