(function () {
  const $ = id => document.getElementById(id);
  const esc = s => App.esc(s);
  const msg = (t, type) => App.msg($('msg'), t, type);
  let guests = [], rooms = [], requests = [], timer = null, role = '';

  const siteRoot = () => location.origin + location.pathname.replace(/admin\/[^/]*$/, '');
  const inviteUrl = id => siteRoot() + 'index.html?g=' + encodeURIComponent(id);
  const yes = v => v === true || String(v).toUpperCase() === 'TRUE';

  async function call(action, data) {
    try { return await API.call(action, data); }
    catch (e) {
      if (e.message === 'unauthorized') { sessionStorage.removeItem('adminKey'); location.reload(); }
      msg(e.message, 'err');
      throw e;
    }
  }

  // Shrink a phone photo to ~1600px JPEG and store it privately in Wedding/Envelopes.
  async function callUpload(file) {
    const img = await createImageBitmap(file), s = Math.min(1, 1600 / Math.max(img.width, img.height));
    const c = document.createElement('canvas'); c.width = img.width * s; c.height = img.height * s;
    c.getContext('2d').drawImage(img, 0, 0, c.width, c.height);
    return call('admin.envelopePhoto', { data: c.toDataURL('image/jpeg', 0.8) });
  }

  // ---------- Login ----------
  $('loginForm').addEventListener('submit', async e => {
    e.preventDefault();
    sessionStorage.setItem('adminKey', e.target.key.value);
    try { await API.call('admin.login'); start(); }
    catch (err) { sessionStorage.removeItem('adminKey'); msg('Invalid passcode', 'err'); }
  });
  $('logout').addEventListener('click', e => { e.preventDefault(); sessionStorage.removeItem('adminKey'); location.reload(); });

  function start() {
    $('loginForm').hidden = true;
    $('app').hidden = false;
    $('logout').hidden = false;
    msg('');
    refreshStats();
    timer = setInterval(refreshStats, APP_CONFIG.ADMIN_REFRESH_MS);
    loadGuests();
    fetchEvents();
    call('admin.me').then(me => {
      role = me.role || 'owner';
      document.body.dataset.role = role;
      $('logout').textContent = '👤 ' + me.name + ' · Logout';
      document.querySelectorAll('[data-role="owner"]').forEach(el => el.hidden = me.role !== 'owner');
      applyDuties(me.tabs);
    }).catch(() => { });
  }

  // ---------- Duty run-sheet: helpers only see their assigned tabs ----------
  function applyDuties(tabs) {
    if (!tabs || !tabs.length) return;
    document.body.classList.add('duty-view');
    document.querySelectorAll('#tabs button[data-tab]').forEach(b => b.hidden = tabs.indexOf(b.dataset.tab) < 0);
    const first = document.querySelector('#tabs button[data-tab="' + tabs[0] + '"]');
    if (first) first.click();
  }

  // ---------- Thank-you engine ----------
  let tq = [], tqF = 'todo';
  async function loadThanks() { tq = await call('admin.thankQueue'); renderThanks(); }
  function renderThanks() {
    const q = ($('tqSearch').value || '').toLowerCase(), ne = $('tqNe').checked;
    const list = tq.filter(o => (!tqF || (tqF === 'todo' ? !o.sentAt : !!o.sentAt)) && (!q || JSON.stringify(o).toLowerCase().indexOf(q) >= 0));
    $('tqList').innerHTML = list.map((o, i) => {
      const m = ne ? o.messageNe : o.message, ph = String(o.phone || '').replace(/\D/g, ''), t = encodeURIComponent(m);
      return '<div class="tq-item" data-k="' + esc(o.key) + '"><div class="row-between"><b>' + esc(o.name) + '</b><small class="muted">' + esc([o.relation, o.events.join(', ')].filter(Boolean).join(' · ')) + '</small></div>' +
        '<textarea rows="3">' + esc(m) + '</textarea><div class="btn-row">' +
        (ph ? '<a class="btn sm" target="_blank" data-ch="whatsapp" href="https://wa.me/' + ph + '?text=' + t + '">WhatsApp</a><a class="btn ghost sm" data-ch="sms" href="sms:+' + ph + '?body=' + t + '">SMS</a>' : '') +
        (o.email ? '<a class="btn ghost sm" data-ch="email" href="mailto:' + esc(o.email) + '?subject=' + encodeURIComponent('Thank you 🙏') + '&body=' + t + '">Email</a>' : '') +
        '<button class="btn ghost sm" data-ch="manual">✓ Done</button>' +
        (o.sentAt ? ' <small>✅ ' + esc(String(o.sentAt).slice(0, 10) + ' ' + (o.sentVia || '')) + '</small>' : '') + '</div></div>';
    }).join('') || '<p class="muted">Nothing here 🎉</p>';
  }
  $('tqList').addEventListener('input', e => {
    // keep the links in sync with an edited message
    const box = e.target.closest('.tq-item'); if (!box) return;
    const t = encodeURIComponent(e.target.value);
    box.querySelectorAll('a[data-ch]').forEach(a => a.href = a.href.replace(/(text=|body=)[^&]*$/, '$1' + t));
  });
  $('tqList').addEventListener('click', e => {
    const b = e.target.closest('[data-ch]'); if (!b) return;
    const box = b.closest('.tq-item'), o = tq.find(x => x.key === box.dataset.k);
    call('admin.logThanks', { guestId: o.guestId, giftIds: o.giftIds, name: o.name, channel: b.dataset.ch, to: b.dataset.ch === 'email' ? o.email : o.phone, message: box.querySelector('textarea').value })
      .then(() => { o.sentAt = new Date().toISOString(); o.sentVia = b.dataset.ch; setTimeout(renderThanks, 600); });
  });
  $('tqFilter').addEventListener('click', e => {
    const b = e.target.closest('[data-f]'); if (!b) return;
    tqF = b.dataset.f; $('tqFilter').querySelectorAll('button').forEach(x => x.classList.toggle('on', x === b)); renderThanks();
  });
  $('tqSearch').addEventListener('input', renderThanks);
  $('tqNe').addEventListener('change', renderThanks);

  // ---------- Admin team ----------
  async function loadTeam() {
    const t = await call('admin.admins');
    $('teamTable').innerHTML = '<tr><th>Name</th><th>Role</th><th>Duties</th><th>Passcode</th><th>Last seen</th><th></th></tr>' + t.map(a =>
      '<tr data-e="' + esc(a.Email) + '" data-d="' + esc(a.Duties || '') + '"><td>' + esc(a.Name) + '<br><small>' + esc(a.Email) + '</small></td><td>' + esc(a.Role) + '</td><td>' + (esc(a.Duties || '') || '<small class="muted">all helper tools</small>') + '</td><td>' + esc(a.Passcode) + '</td><td>' + esc(String(a.LastSeen || '').slice(0, 16)) + '</td><td>' +
      (String(a.Active).toUpperCase() === 'FALSE' ? 'disabled' : '<button class="btn ghost sm" data-t="reset">New code</button> <button class="btn ghost sm" data-t="off">Disable</button>') + '</td></tr>').join('');
  }
  const showCode = (name, r) => { if (r.passcode) { $('teamNew').hidden = false; $('teamNew').textContent = 'Passcode for ' + name + ': ' + r.passcode + ' (shown once — send privately)'; } };
  $('teamForm').addEventListener('submit', async e => {
    e.preventDefault();
    const d = Object.fromEntries(new FormData(e.target).entries());
    delete d.duty;
    d.Duties = [].map.call(e.target.querySelectorAll('input[name="duty"]:checked'), x => x.value).join(',');
    showCode(d.Name, await call('admin.saveAdmin', d)); e.target.reset(); loadTeam();
  });
  $('teamTable').addEventListener('click', async e => {
    const b = e.target.closest('[data-t]'); if (!b) return;
    const em = b.closest('tr').dataset.e;
    if (b.dataset.t === 'off' && confirm('Disable ' + em + '?')) await call('admin.deleteAdmin', { email: em });
    if (b.dataset.t === 'reset') { const row = b.closest('tr'), name = row.cells[0].firstChild.textContent; showCode(name, await call('admin.saveAdmin', { Email: em, Name: name,
      Role: row.cells[1].textContent, Duties: row.dataset.d, reset: true })); }
    loadTeam();
  });

  // ---------- Events & who is invited to which day ----------
  let allEvents = [];
  const picksOf = g => String((g && g.Events) || '').split(',').map(x => x.trim()).filter(Boolean);
  const sortedEvents = () => allEvents.slice().sort((a, b) => (Number(a.Order) || 0) - (Number(b.Order) || 0) || String(a.DateTime).localeCompare(String(b.DateTime)));

  async function fetchEvents() { allEvents = await call('admin.events').catch(() => []); renderGuestEventPicks(); return allEvents; }

  function renderGuestEventPicks(selected) {
    const box = $('guestEventPicks'); if (!box) return;
    const sel = selected || [];
    box.innerHTML = sortedEvents().map(e => '<label class="check"><input type="checkbox" value="' + esc(e.EventId) + '"' + (sel.includes(e.EventId) ? ' checked' : '') + '> ' +
      esc(e.NameEn) + ' <small class="muted">' + esc(String(e.DateTime || '').slice(0, 10)) + '</small></label>').join('') || '<span class="muted">No events yet — create them in the Events tab.</span>';
  }

  async function loadEvents() {
    await fetchEvents();
    if (!guests.length) await loadGuests();
    $('eventTable').innerHTML = '<tr><th>Event</th><th>When</th><th>Venue</th><th>Invited</th><th>Visible</th><th></th></tr>' + sortedEvents().map(e => {
      const n = guests.filter(g => picksOf(g).includes(e.EventId)).length;
      return '<tr data-e="' + esc(e.EventId) + '"><td><b>' + esc(e.NameEn) + '</b><br><small>' + esc(e.NameNe || '') + '</small></td><td>' + esc(String(e.DateTime || '').replace('T', ' ').slice(0, 16)) +
        '</td><td>' + esc(e.Venue || '') + '</td><td>' + n + ' picked' + (e.Groups && e.Groups !== 'All' ? '<br><small>groups: ' + esc(e.Groups) + '</small>' : '') + '</td><td>' + (yes(e.Visible) ? '✅' : '—') +
        '</td><td><button class="btn ghost sm" data-ev="edit">Edit</button> <button class="btn ghost sm" data-ev="del">Delete</button></td></tr>';
    }).join('');
    renderMatrix();
  }

  function renderMatrix() {
    const q = ($('matrixSearch').value || '').toLowerCase();
    const evs = sortedEvents();
    const list = guests.filter(g => !q || [g.Name, g.Family, g.Relation, g.Side].join(' ').toLowerCase().includes(q));
    $('inviteMatrix').innerHTML = '<tr><th>Household</th>' + evs.map(e => '<th>' + esc(e.NameEn) + '<br><button class="btn ghost sm" data-all="' + esc(e.EventId) + '">All</button></th>').join('') + '</tr>' +
      list.map(g => { const p = picksOf(g); return '<tr data-g="' + esc(g.GuestId) + '"><td>' + esc(g.Name) + ' <small class="muted">' + esc(g.Side || '') + '</small></td>' +
        evs.map(e => '<td class="center"><input type="checkbox" data-pick="' + esc(e.EventId) + '"' + (p.includes(e.EventId) ? ' checked' : '') + ' aria-label="' + esc(g.Name + ' - ' + e.NameEn) + '"></td>').join('') + '</tr>'; }).join('');
  }

  async function savePicks(g, picks) {
    const v = picks.join(',');
    await call('admin.saveGuest', { GuestId: g.GuestId, Events: v });
    g.Events = v;
  }

  $('inviteMatrix').addEventListener('change', async e => {
    const cb = e.target.closest('[data-pick]'); if (!cb) return;
    const g = guests.find(x => x.GuestId === cb.closest('tr').dataset.g);
    const p = picksOf(g).filter(x => x !== cb.dataset.pick);
    if (cb.checked) p.push(cb.dataset.pick);
    try { await savePicks(g, p); } catch (err) { cb.checked = !cb.checked; }
  });
  $('inviteMatrix').addEventListener('click', async e => {
    const b = e.target.closest('[data-all]'); if (!b) return;
    const ev = b.dataset.all, q = ($('matrixSearch').value || '').toLowerCase();
    const list = guests.filter(g => (!q || [g.Name, g.Family, g.Relation, g.Side].join(' ').toLowerCase().includes(q)) && !picksOf(g).includes(ev));
    if (!list.length || !confirm('Invite ' + list.length + ' shown households to this event?')) return;
    for (const g of list) await savePicks(g, picksOf(g).concat(ev));
    msg('Invited ' + list.length + ' households', 'ok');
    loadEvents();
  });
  $('matrixSearch').addEventListener('input', renderMatrix);

  $('eventTable').addEventListener('click', async e => {
    const b = e.target.closest('[data-ev]'); if (!b) return;
    const ev = allEvents.find(x => x.EventId === b.closest('tr').dataset.e);
    if (b.dataset.ev === 'edit') {
      const f = $('eventForm');
      ['EventId', 'NameEn', 'NameNe', 'Venue', 'MapLink', 'DressCode', 'Groups', 'Order'].forEach(k => f[k].value = ev[k] == null ? '' : ev[k]);
      f.DateTime.value = ev.DateTime ? toLocal(ev.DateTime) : ''; f.UnlockAt.value = ev.UnlockAt ? toLocal(ev.UnlockAt) : ''; f.Visible.checked = yes(ev.Visible);
      f.scrollIntoView({ behavior: 'smooth' });
    } else if (confirm('Delete ' + ev.NameEn + '? Guests will no longer see it.')) {
      await call('admin.deleteEvent', { eventId: ev.EventId });
      await loadGuests(); loadEvents();
    }
  });

  $('eventForm').addEventListener('submit', async e => {
    e.preventDefault();
    const f = e.target, d = Object.fromEntries(new FormData(f).entries());
    d.Visible = f.Visible.checked ? 'TRUE' : 'FALSE';
    ['DateTime', 'UnlockAt'].forEach(k => { if (d[k]) d[k] = new Date(d[k]).toISOString(); });
    if (!d.EventId) delete d.EventId;
    await call('admin.saveEvent', d);
    f.reset(); f.EventId.value = '';
    msg('Event saved', 'ok');
    loadEvents();
  });

  // ---------- Tabs ----------
  $('tabs').addEventListener('click', e => {
    const b = e.target.closest('button[data-tab]');
    if (!b) return;
    if (b.dataset.role === 'owner' && role && role !== 'owner') { msg('Unauthorized: owners only', 'err'); return; }
    document.querySelectorAll('#tabs button').forEach(x => x.classList.toggle('active', x === b));
    document.querySelectorAll('.panel').forEach(p => p.classList.toggle('active', p.id === 'panel-' + b.dataset.tab));
    const fn = { door: loadDoor, live: () => { loadRituals(); loadFreeze(); }, guests: loadGuests,
      gifts: loadGifts, thanks: loadThanks, team: loadTeam, settings: loadSettings, events: loadEvents }[b.dataset.tab];
    if (fn) fn();
  });

  // Dashboard shortcuts jump straight to the most common wedding-day jobs.
  if ($('quickActions')) $('quickActions').addEventListener('click', e => {
    const q = e.target.closest('[data-go]'); if (!q) return;
    const t = document.querySelector('#tabs [data-tab="' + q.dataset.go + '"]');
    if (!t || t.hidden) { msg('That tool is not part of your duty.', 'err'); return; }
    t.click(); t.scrollIntoView({ block: 'nearest', inline: 'center' });
    if (q.dataset.then && $(q.dataset.then)) setTimeout(() => $(q.dataset.then).click(), 150);
  });
  if ($('pwToggle')) $('pwToggle').addEventListener('click', () => {
    const k = $('adminKey'), show = k.type === 'password';
    k.type = show ? 'text' : 'password'; $('pwToggle').textContent = show ? 'Hide' : 'Show';
  });
  if ($('demoHint') && window.APP_CONFIG && APP_CONFIG.MODE === 'demo') $('demoHint').hidden = false;

  // ---------- Analytics & logistics ----------
  const li = (rows, k, v) => rows.map(r => '<li><span>' + esc(r[k]) + '</span><b>' + esc(r[v]) + '</b></li>').join('') || '<li class="muted">–</li>';
  // Demo analytics shown until real activity exists (or with ?demo=1). Remove once live.
  const DEMO_ANALYTICS = {
    activity: {
      activeToday: 46, activeWeek: 183, today: 612, devices: { phone: 164, desktop: 19 },
      byHour: [0, 0, 0, 0, 0, 1, 4, 9, 14, 18, 22, 25, 31, 28, 20, 17, 24, 38, 52, 61, 47, 30, 12, 3],
      topPages: [{ k: 'Home', n: 420 }, { k: 'RSVP', n: 288 }, { k: 'Photos', n: 241 }, { k: 'Gift', n: 96 }, { k: 'Games', n: 88 }],
      topActions: [{ k: 'register', n: 141 }, { k: 'upload', n: 117 }, { k: 'markAttended', n: 92 }, { k: 'sendGift', n: 54 }, { k: 'lightDiya', n: 33 }]
    },
    notRegistered: [{ name: 'Ram Bahadur Thapa', phone: '9779841000001', side: 'Groom' }, { name: 'Sita Karki', phone: '9779851000002', side: 'Bride' }, { name: 'Hari & Gita Shrestha', phone: '', side: 'Both' }],
    invites: { requested: 4 }, proofsPending: 2, accommodation: { unassigned: 7 },
    media: { total: 538, videos: 61, sizeGB: 14.2, byEvent: [{ event: 'Mehendi', count: 142 }, { event: 'Haldi', count: 98 }, { event: 'Wedding', count: 251 }, { event: 'Reception', count: 47 }], topUploaders: [{ name: 'Anisha (cousin)', count: 64 }, { name: 'Bikash', count: 41 }, { name: 'Prakriti', count: 33 }] },
    gifts: { count: 128, notThanked: 37, total: { NPR: 845000, USD: 1200 } },
    ages: { 'Under 12': 18, '13-25': 64, '26-40': 97, '41-60': 81, '60+': 39 },
    venues: [{ venue: 'Hotel Annapurna', guests: 210 }, { venue: 'Family home', guests: 88 }],
    perEvent: [
      { name: 'Mehendi', invited: 120, yes: 96, attended: 89 }, { name: 'Haldi', invited: 80, yes: 71, attended: 66 },
      { name: 'Wedding', invited: 320, yes: 274, attended: 251 }, { name: 'Reception', invited: 300, yes: 238, attended: 0 }
    ],
    thanks: { queue: 164, sent: 127, byChannel: { whatsapp: 98, sms: 17, email: 12 } }
  };
  async function loadAnalytics() {
    let a, demo = /[?&]demo=1/.test(location.search);
    if (!demo) { try { a = await call('admin.analytics'); } catch (e) { demo = true; } }
    if (!a || (!a.activity.activeWeek && !a.gifts.count)) demo = true;
    if (demo) a = DEMO_ANALYTICS;
    const card = (n, l) => '<div class="card stat"><div class="num">' + esc(n) + '</div><div class="muted">' + esc(l) + '</div></div>';
    $('anDemo').hidden = !demo;
    const pe = a.perEvent || [], th = a.thanks;
    $('anAttend').innerHTML = pe.length ? '<tr><th>Function</th><th>Invited</th><th>RSVP yes</th><th>Attended</th><th></th></tr>' + pe.map(e =>
      '<tr><td>' + esc(e.name) + '</td><td>' + e.invited + '</td><td>' + e.yes + '</td><td>' + (e.attended || '—') + '</td><td><div class="bar"><span style="width:' + (e.invited ? Math.round((e.attended || e.yes) * 100 / e.invited) : 0) + '%"></span></div></td></tr>').join('') : '';
    $('anThanks').innerHTML = th ? card(th.sent + ' / ' + th.queue, 'Thank-yous sent') + Object.keys(th.byChannel).map(k => card(th.byChannel[k], 'via ' + k)).join('') : '';
    $('anStats').innerHTML = [
      card(a.activity.activeToday, 'Active people today'), card(a.activity.activeWeek, 'Active this week'),
      card(a.activity.today, 'Actions today'), card(a.activity.devices.phone + ' / ' + a.activity.devices.desktop, 'Phone / desktop sessions'),
      card(a.notRegistered.length, 'Not registered'), card(a.invites.requested, 'Invites to approve'),
      card(a.proofsPending, 'Proofs to review'), card(a.accommodation.unassigned, 'Rooms to assign'),
      card(a.media.total + ' (' + a.media.videos + ' videos)', 'Uploads'), card(a.media.sizeGB + ' GB', 'Original media size'),
      card(a.gifts.count, 'Gifts / blessings'), card(a.gifts.notThanked, 'Thank-yous pending')
    ].join('');
    const max = Math.max.apply(null, a.activity.byHour.concat(1));
    $('anHours').innerHTML = a.activity.byHour.map((n, h) => '<span title="' + h + ':00 – ' + n + '" style="height:' + (n * 100 / max) + '%"></span>').join('');
    $('anPages').innerHTML = li(a.activity.topPages, 'k', 'n');
    $('anActions').innerHTML = li(a.activity.topActions, 'k', 'n');
    $('anAges').innerHTML = li(Object.keys(a.ages).map(k => ({ k: k, n: a.ages[k] })), 'k', 'n');
    $('anVenues').innerHTML = li(a.venues, 'venue', 'guests');
    $('anEvents').innerHTML = li(a.media.byEvent, 'event', 'count');
    $('anUploaders').innerHTML = li(a.media.topUploaders, 'name', 'count');
    $('anPending').innerHTML = '<tr><th>Name</th><th>Phone</th><th>Side</th></tr>' + a.notRegistered.map(g =>
      '<tr><td>' + esc(g.name) + '</td><td>' + (g.phone ? '<a href="https://wa.me/' + esc(String(g.phone).replace(/\D/g, '')) + '" target="_blank">' + esc(g.phone) + '</a>' : '') + '</td><td>' + esc(g.side) + '</td></tr>').join('');
  }

  // ---------- Gifts ----------
  let gifts = [], giftF = '', giftPeople = [];
  async function loadGifts() {
    gifts = await call('admin.gifts');
    const tot = {};
    gifts.forEach(g => { const c = g.Currency || 'NPR'; tot[c] = (tot[c] || 0) + (Number(g.Amount) || 0); });
    const todo = gifts.filter(g => !g.ThankedAt).length;
    $('giftTotals').textContent = gifts.length + ' gifts · ' + Object.keys(tot).map(c => c + ' ' + tot[c].toLocaleString()).join(' · ') + ' · ' + todo + ' to thank';
    const list = gifts.filter(g => !giftF || (giftF === 'todo' ? !g.ThankedAt : !!g.ThankedAt));
    $('giftTable').innerHTML = '<tr><th>From</th><th>Amount</th><th>Note</th><th>Thank you</th></tr>' + list.map(g => {
      const acts = g.ThankedAt ? '✅ <small>' + esc(g.ThankedVia || '') + '</small>' : '<button class="btn ghost sm" data-goto="thanks">💌 Thank</button>';
      return '<tr><td>' + esc(g.Name) + (g.Anon === 'TRUE' || g.Anon === true ? ' 🕶️' : '') + '<br><small>' + esc([g.Relation, g.Method, String(g.Timestamp).slice(0, 10)].filter(Boolean).join(' · ')) + '</small></td>' +
        '<td>' + esc(g.Amount ? g.Currency + ' ' + g.Amount : '') + auditBadge(g) + '</td><td>' + esc(g.Note) +
        (g.ProofFileId ? ' <a target="_blank" href="https://drive.google.com/file/d/' + esc(g.ProofFileId) + '/view">proof</a>' : '') +
                (g.PhotoId ? ' <a target="_blank" href="https://drive.google.com/file/d/' + esc(g.PhotoId) + '/view">🧧 envelope</a>' : '') + '</td><td>' + acts + '</td></tr>';
    }).join('');
    auditProgress();
    loadWhispers();
  }
  async function loadWhispers() {
    const w = await call('admin.whispers');
    $('whisperTable').innerHTML = '<tr><th>Message</th><th>Really from</th></tr>' + w.map(x =>
      '<tr><td>' + esc(x.Text) + (x.DriveFileId ? ' <a target="_blank" href="https://drive.google.com/file/d/' + esc(x.DriveFileId) + '/view">🎥 media</a>' : '') + '</td>' +
      '<td>' + esc(x.Name || 'Unknown') + '<br><small>' + esc([x.Side, String(x.Timestamp).slice(0, 16), x.Device].filter(Boolean).join(' · ')) + '</small></td></tr>').join('');
  }
  $('giftFilter').addEventListener('click', e => {
    const b = e.target.closest('[data-f]'); if (!b) return;
    giftF = b.dataset.f;
    $('giftFilter').querySelectorAll('button').forEach(x => x.classList.toggle('on', x === b));
    loadGifts();
  });
  $('giftTable').addEventListener('click', e => {
    if (e.target.closest('[data-goto]')) document.querySelector('#tabs [data-tab="thanks"]').click();
  });
  $('addCash').addEventListener('click', async () => {
    $('cashMsg').textContent = '';
    $('cashDlg').showModal();
    $('cashForm').name.focus();
    if (!giftPeople.length) {
      try { giftPeople = await call('admin.guests'); } catch (e) { giftPeople = []; }
      $('cashNames').innerHTML = giftPeople.map(p => '<option value="' + esc(p.Name) + '">').join('');
    }
  });
  $('cashForm').name.addEventListener('change', e => {
    const f = $('cashForm'), p = giftPeople.find(x => x.Name === e.target.value);
    if (p) { f.dataset.guestId = p.GuestId; f.relation.value = p.RelationTo || ''; if (!f.phone.value) f.phone.value = p.Phone || ''; }
    else delete f.dataset.guestId;
  });
