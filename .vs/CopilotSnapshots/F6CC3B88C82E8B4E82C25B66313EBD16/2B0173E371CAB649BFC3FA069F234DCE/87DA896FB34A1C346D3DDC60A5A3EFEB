// QR photo/video sharing: pick files -> auto upload straight to Google Drive -> shared gallery.
(async function () {
  const msg = document.getElementById('msg');
  let cfg;
  try { cfg = await App.boot(); } catch (e) { App.msg(msg, e.message, 'err'); return; }
  if (!App.on(cfg, 'feature.media')) { App.msg(msg, I18N.t('common.error'), 'err'); return; }
  const pauseUploads = on => {
    document.querySelectorAll('input[type="file"], label.btn').forEach(el => {
      el.classList.toggle('paused', on); if (on) el.setAttribute('aria-disabled', 'true'); else el.removeAttribute('aria-disabled');
      if (el.tagName === 'INPUT') el.disabled = on;
    });
    if (on) App.msg(msg, I18N.t('freeze.uploads'), 'warn'); else if (msg) msg.textContent = '';
  };
  if (App.frozen(cfg)) pauseUploads(true);
  // Pending uploads already in the queue are kept on the phone and retried after the freeze.
  document.addEventListener('app:freeze', e => pauseUploads(!!(e.detail && e.detail.on)));

  const gid = App.guestId();
  const params = new URLSearchParams(location.search);
  const presetEvent = params.get('e') || params.get('event') || '';
  let events = [];

  if (gid) {
    const d = await App.refreshHousehold();
    if (d) events = (d.events || []).filter(e => !e.locked);
    App.profileSwitcher(document.getElementById('whoSwitch'));
  }

  // Visitors who scan the venue QR without a personal link: remember name + relation on this phone.
  const visitorRow = document.getElementById('visitorRow');
  const vName = document.getElementById('visitorName');
  const vRel = document.getElementById('visitorRel');
  if (!gid) {
    if (!App.on(cfg, 'media.allowVisitors')) { App.msg(msg, I18N.t('common.invalidLink'), 'err'); }
    else {
      visitorRow.hidden = false;
      const fill = () => {
        const v = vRel.value || localStorage.getItem('visitorRel') || '';
        vRel.innerHTML = '<option value="">—</option>' + (cfg.relationTo || []).map(r =>
          '<option value="' + App.esc(r) + '">' + App.esc(I18N.t('rel.' + r)) + '</option>').join('');
        vRel.value = v;
      };
      fill();
      document.addEventListener('langchange', fill);
      vName.value = localStorage.getItem('visitorName') || '';
      vName.onchange = () => localStorage.setItem('visitorName', vName.value.trim());
      vRel.onchange = () => { localStorage.setItem('visitorRel', vRel.value); App.setSide(/^Bride/.test(vRel.value) ? 'Bride' : /^Groom/.test(vRel.value) ? 'Groom' : 'Both', cfg); };
    }
  }
  if (gid || App.on(cfg, 'media.allowVisitors')) document.getElementById('uploader').hidden = false;

  const eventSel = document.getElementById('eventSel');
  function fillEvents() {
    if (!events.length) return;
    document.getElementById('eventRow').hidden = false;
    const v = eventSel.value || presetEvent;
    eventSel.innerHTML = '<option value="">' + App.esc(I18N.t('photo.autoEvent')) + '</option>' + events.map(e =>
      '<option value="' + App.esc(e.EventId) + '">' + App.esc(I18N.bi(e.NameEn, e.NameNe)) + '</option>').join('');
    eventSel.value = v;
    if (!eventSel.value && v) { const m = events.find(e => [e.NameEn, e.NameNe, e.EventId].some(n => String(n || '').toLowerCase() === v.toLowerCase())); if (m) eventSel.value = m.EventId; }
  }
  const catSel = document.getElementById('catSel');
  const cats = String(cfg['media.categories'] || '').split('|').map(s => s.trim()).filter(Boolean);
  if (cats.length) {
    document.getElementById('catRow').hidden = false;
    catSel.innerHTML = '<option value="">—</option>' + cats.map(c => '<option>' + App.esc(c) + '</option>').join('');
    const pc = params.get('cat'); if (pc) catSel.value = cats.find(c => c.toLowerCase().indexOf(pc.toLowerCase()) >= 0) || '';
  }
  // Venue QR (?event=Reception&open=1): event preselected, one big tap opens the gallery picker.
  if (params.get('open') === '1') {
    const b = document.createElement('button');
    b.className = 'btn big'; b.type = 'button'; b.textContent = '📸 ' + I18N.t('photo.pick');
    b.onclick = () => { document.getElementById('filePick').click(); b.remove(); };
    document.querySelector('.upload-buttons').prepend(b);
  }
  fillEvents();
  document.addEventListener('langchange', fillEvents);

  // ---------- Upload ----------
  const queue = document.getElementById('queue');
  const pending = [];
  let busy = false, wake = null;
  document.addEventListener('visibilitychange', () => { if (!document.hidden && busy && navigator.wakeLock) navigator.wakeLock.request('screen').then(w => wake = w).catch(() => { }); });

  function onFiles(list) {
    if (!gid && (!vName.value.trim() || !vRel.value)) { App.msg(msg, I18N.t('photo.yourName') + ' / ' + I18N.t('rel.to'), 'err'); vName.focus(); return; }
    App.msg(msg, '');
    // Photos and videos have separate limits (videos default 250 MB). Anything that is not a photo/video is skipped.
    const maxImg = (Number(cfg['media.maxSizeMB']) || 500) * 1048576;
    const maxVid = (Number(cfg['media.maxVideoMB']) || 250) * 1048576;
    const odd = [...list].filter(f => !App.mediaKind(f));
    if (odd.length) App.msg(msg, I18N.t('photo.badType') + ' (' + odd.map(f => f.name).join(', ') + ')', 'err');
    list = [...list].filter(f => App.mediaKind(f));
    const limitOf = f => App.mediaKind(f) === 'video' ? maxVid : maxImg;
    const big = list.filter(f => f.size > limitOf(f));
    if (big.length) {
      const url = cfg['media.largeAlbumUrl'];
      msg.hidden = false; msg.className = 'msg warn';
      msg.innerHTML = App.esc(I18N.t('photo.tooBig') + ' (' + big.map(f => f.name + ' > ' + Math.round(limitOf(f) / 1048576) + ' MB').join(', ') + ')') +
        (url && /^https:\/\//.test(url) ? ' <a target="_blank" rel="noopener" href="' + App.esc(url) + '">' + App.esc(I18N.t('photo.largeAlbum')) + '</a>' : '');
      list = list.filter(f => f.size <= limitOf(f));
    }
    [...list].forEach(f => {
      const row = document.createElement('div');
      row.className = 'upload-item';
      row.innerHTML = '<span class="name"></span><progress max="100" value="0"></progress><span class="state">⏳</span>';
      row.querySelector('.name').textContent = f.name;
      queue.prepend(row);
      pending.push({ file: f, row: row });
    });
    next();
  }
  document.getElementById('filePick').onchange = e => { onFiles(e.target.files); e.target.value = ''; };
  document.getElementById('fileCam').onchange = e => { onFiles(e.target.files); e.target.value = ''; };

  async function next() {
    document.getElementById('keepOpen').hidden = !(busy || pending.length);
    if (busy || !pending.length) { if (!busy && wake) { wake.release().catch(() => { }); wake = null; } return; }
    busy = true;
    if (!wake && navigator.wakeLock) navigator.wakeLock.request('screen').then(w => wake = w).catch(() => { });
    const job = pending.shift();
    try { await upload(job); } catch (err) {
      job.row.querySelector('.state').textContent = '⚠️';
      job.row.title = err.message;
      job.row.classList.add('failed');
      const retry = document.createElement('button');
      retry.type = 'button'; retry.className = 'btn sm'; retry.textContent = '↻ ' + I18N.t('photo.retry');
      retry.onclick = ev => { ev.stopPropagation(); retry.remove(); job.row.classList.remove('failed'); job.row.onclick = null; pending.push(job); next(); };
      job.row.appendChild(retry);
      job.row.onclick = () => { job.row.classList.remove('failed'); job.row.onclick = null; pending.push(job); next(); };
    }
    busy = false;
    next();
  }

  async function upload(job) {
    const f = job.file;
    const state = job.row.querySelector('.state');
    const bar = job.row.querySelector('progress');
    state.textContent = '🔎';
    const isVid = App.mediaKind(f) === 'video';
    const thumb = isVid && App.on(cfg, 'media.thumbs') ? await App.videoThumb(f) : '';
    if (thumb) job.row.insertAdjacentHTML('afterbegin', '<img class="q-thumb" alt="" src="' + thumb + '">');
    let audioFlag = '', clipPct = 0;
    if (isVid && App.on(cfg, 'media.audioCheck')) {
      const pct = await App.audioClipPct(f, Number(cfg['media.audioCheckMaxMB']) || 150);
      if (pct != null) {
        clipPct = pct; audioFlag = pct >= (Number(cfg['media.clipPct']) || 50) ? 'distorted' : 'ok';
        if (audioFlag === 'distorted') job.row.insertAdjacentHTML('beforeend', '<div class="msg warn small">' + App.esc(I18N.t('photo.distorted')) + '</div>');
      }
    }
    const when = await App.takenAt(f);
    // EXIF can be missing (WhatsApp strips it), so the guess is shown on the row and can be changed with the event picker.
    const auto = App.eventForTime(events, when);
    const eventId = eventSel.value || auto;
    const ev = events.find(e => e.EventId === eventId);
    if (ev) job.row.insertAdjacentHTML('beforeend', '<div class="muted small q-event">' + App.esc((eventSel.value ? '' : I18N.t('photo.autoEvent') + ': ') + I18N.bi(ev.NameEn, ev.NameNe)) + '</div>');
    const saver = document.getElementById('compressPick');
    const viewable = isVid ? f : await App.toBrowserImage(f);
    const send = !isVid && saver && saver.checked ? await App.compressImage(viewable, (Number(cfg['media.compressMB']) || 1.5) * 1048576) : viewable;
    if (send !== f) job.row.title = Math.round(f.size / 1048576 * 10) / 10 + ' MB → ' + Math.round(send.size / 1048576 * 10) / 10 + ' MB';
    state.textContent = I18N.t('photo.uploading');
    const r = await App.uploadFile(send, { name: vName.value.trim(), relationTo: vRel.value, eventId: eventId, takenAt: when, anon: document.getElementById('anonPick').checked,
      category: catSel.value, audioFlag: audioFlag, clipPct: clipPct, thumb: thumb }, p => { bar.value = p; state.textContent = p + '%'; });
    bar.value = 100;
    state.textContent = r.pending ? '🕓' : '✅';
    job.row.title = r.pending ? I18N.t('photo.pending') : I18N.t('photo.done');
    if (!r.pending) { items.unshift(Object.assign(r.media, { mine: true })); render(); }
    if (!pending.length) App.msg(msg, r.pending ? I18N.t('photo.pending') : I18N.t('photo.done'), 'ok');
  }

  // ---------- Gallery (view + download for everyone; only owner can remove) ----------
  const gallery = document.getElementById('gallery');
  let items = [];
  let filter = 'all';
  const thumb = id => 'https://drive.google.com/thumbnail?id=' + encodeURIComponent(id) + '&sz=w400';
  const download = id => 'https://drive.google.com/uc?export=download&id=' + encodeURIComponent(id);

  async function load() {
    fillFilters(); render();
    catch
  }

  let typeF = 'all', eventF = '', sideF = '', layout = localStorage.getItem('galleryLayout') || 'grid';
  let shown = [];
  const eventName = id => { const e = events.find(x => x.EventId === id); return e ? I18N.bi(e.NameEn, e.NameNe) : ''; };
  const when = at => { const d = new Date(at); return isNaN(d) ? '' : d.toLocaleString([], { month: 'short', day: 'numeric', hour: 'numeric', minute: '2-digit' }); };
  const evSel = document.getElementById('eventFilter'), sideSel = document.getElementById('sideFilter');
  const layoutInput = document.querySelector('#layoutPick input[value="' + layout + '"]');
  if (layoutInput) layoutInput.checked = true;

  function fillFilters() {
    const evIds = [...new Set(items.map(i => i.eventId).filter(Boolean))];
    const sides = [...new Set(items.map(i => i.side).filter(Boolean))];
    evSel.innerHTML = '<option value="">All events</option>' + evIds.map(id => '<option value="' + App.esc(id) + '">' + App.esc(eventName(id) || id) + '</option>').join('');
    sideSel.innerHTML = '<option value="">Both sides</option>' + sides.map(s => '<option>' + App.esc(s) + '</option>').join('');
    evSel.value = evIds.includes(eventF) ? eventF : (eventF = '');
    sideSel.value = sides.includes(sideF) ? sideF : (sideF = '');
    sideSel.hidden = sides.length < 2;
  }

  function render() {
    shown = items.filter(i => (filter !== 'mine' || i.mine) &&
      (typeF === 'all' || (typeF === 'video') === (i.type === 'video')) &&
      (!eventF || i.eventId === eventF) && (!sideF || i.side === sideF));
    const photos = shown.filter(i => i.type !== 'video').length;
    document.getElementById('galleryCount').textContent = photos + ' 📷 · ' + (shown.length - photos) + ' 🎬';
    gallery.className = 'gallery' + (layout === 'feed' ? ' feed' : '');
    if (!shown.length) { gallery.innerHTML = '<p class="muted center">' + App.esc(I18N.t('photo.empty')) + '</p>'; return; }
    gallery.innerHTML = shown.map((m, i) =>
      '<button type="button" class="tile" data-i="' + i + '">' +
      '<img loading="lazy" src="' + thumb(m.fileId) + (layout === 'feed' ? '&sz=w1000' : '') + '" alt="">' +
      (m.type === 'video' ? '<span class="play">▶</span>' : '') +
      '<span class="by">' + App.esc(m.anon ? '🕶️ ' + I18N.t('anon.someone') : m.name || '') +
      (layout === 'feed' ? ' · ' + App.esc([eventName(m.eventId), when(m.at)].filter(Boolean).join(' · ')) : '') + '</span></button>').join('');
  }

  gallery.onclick = e => {
    const t = e.target.closest('.tile');
    if (t) openViewer(Number(t.dataset.i));
  };
  document.getElementById('filter').onchange = e => { filter = e.target.value; render(); };
  document.getElementById('typeFilter').onchange = e => { typeF = e.target.value; render(); };
  document.getElementById('layoutPick').onchange = e => { layout = e.target.value; localStorage.setItem('galleryLayout', layout); render(); };
  evSel.onchange = () => { eventF = evSel.value; render(); };
  sideSel.onchange = () => { sideF = sideSel.value; render(); };

  const viewer = document.getElementById('viewer');
  let viewIdx = -1;
  const closeViewer = () => { viewer.hidden = true; viewer.innerHTML = ''; viewIdx = -1; };
  document.addEventListener('keydown', e => {
    if (viewer.hidden) return;
    if (e.key === 'Escape') closeViewer();
    if (e.key === 'ArrowRight' && viewIdx < shown.length - 1) openViewer(viewIdx + 1);
    if (e.key === 'ArrowLeft' && viewIdx > 0) openViewer(viewIdx - 1);
  });
  let touchX = null;
  viewer.addEventListener('touchstart', e => { touchX = e.touches[0].clientX; }, { passive: true });
  viewer.addEventListener('touchend', e => {
    if (touchX === null) return;
    const dx = e.changedTouches[0].clientX - touchX; touchX = null;
    if (Math.abs(dx) > 60) { const n = viewIdx + (dx < 0 ? 1 : -1); if (n >= 0 && n < shown.length) openViewer(n); }
  });

  function openViewer(idx) {
    const m = shown[idx];
    if (!m) return;
    viewIdx = idx;
    const media = m.type === 'video'
      ? '<iframe src="https://drive.google.com/file/d/' + encodeURIComponent(m.fileId) + '/preview" allow="autoplay" allowfullscreen></iframe>'
      : '<img src="https://drive.google.com/thumbnail?id=' + encodeURIComponent(m.fileId) + '&sz=w1600" alt="">';
    viewer.innerHTML = '<div class="viewer-inner">' + media + '<div class="viewer-bar">' +
      (idx > 0 ? '<button class="btn ghost" data-prev aria-label="Previous">‹</button>' : '') +
      '<span>' + App.esc(m.anon ? I18N.t('anon.someone') : m.name || '') +
      ' · ' + App.esc([eventName(m.eventId), when(m.at)].filter(Boolean).join(' · ')) + ' (' + (idx + 1) + '/' + shown.length + ')</span>' +
      (idx < shown.length - 1 ? '<button class="btn ghost" data-next aria-label="Next">›</button>' : '') +
      '<a class="btn" href="' + download(m.fileId) + '" target="_blank" rel="noopener">⬇ ' + App.esc(I18N.t('photo.download')) + '</a>' +
      (m.mine && gid ? '<button class="btn ghost" data-del>' + App.esc(I18N.t('photo.delete')) + '</button>' : '') +
      '<button class="btn ghost" data-close>✕</button></div></div>';
    viewer.hidden = false;
    viewer.onclick = async ev => {
      if (ev.target.closest('[data-prev]')) return openViewer(viewIdx - 1);
      if (ev.target.closest('[data-next]')) return openViewer(viewIdx + 1);
      if (ev.target === viewer || ev.target.closest('[data-close]')) closeViewer();
      if (ev.target.closest('[data-del]')) {
        try {
          await API.call('deleteMedia', { guestId: gid, mediaId: m.id });
          items = items.filter(x => x.id !== m.id);
          viewer.hidden = true; viewer.innerHTML = '';
          render();
        } catch (err) { App.msg(msg, err.message, 'err'); }
      }
    };
  }

  document.addEventListener('langchange', render);
  load();
  setInterval(() => { if (!document.hidden && viewer.hidden) load(); }, 60000);
})();
