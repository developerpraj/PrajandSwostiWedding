/* ---------- Usability layer: clearer navigation, bigger tap targets, guided actions ---------- */

/* Keyboard and screen-reader friendliness everywhere */
:focus-visible { outline: 3px solid var(--accent); outline-offset: 2px; }
button, .btn, a, input, select, textarea { -webkit-tap-highlight-color: transparent; }
.btn, .tabs button, .seg label { min-height: 44px; }
.btn.sm { min-height: 36px; }
.btn.block { display: block; width: 100%; text-align: center; }
.btn:active:not(:disabled) { transform: translateY(1px); }
input, select, textarea { font-size: 16px; } /* stops iOS zoom on focus */
input:focus, select:focus, textarea:focus { border-color: var(--primary); box-shadow: 0 0 0 3px #a3172b22; outline: none; }
label { color: var(--text); }
.msg { font-weight: 600; }
.msg.warn { background: #fff6dd; color: #6b4b00; }

/* ---------- Admin login ---------- */
.login-card { max-width: 400px; margin: 3rem auto; text-align: center; }
.login-card label { text-align: left; }
.login-card .login-icon { font-size: 2.5rem; }
.pw-row { display: flex; gap: .5rem; align-items: center; }
.pw-row input { flex: 1; }
.small-hint { margin-top: .5rem; }

/* ---------- Admin navigation: grouped, labelled sections ---------- */
.admin-nav { display: flex; flex-wrap: wrap; gap: .75rem 1.25rem; padding: .75rem; background: var(--card);
  border: 1px solid var(--line); border-radius: var(--radius); position: sticky; top: 0; z-index: 20; margin-bottom: 1.25rem;
  box-shadow: 0 6px 18px -14px #2a1d1755; }
.tab-group { display: flex; flex-wrap: wrap; gap: .4rem; align-items: center; }
.tab-group[hidden] { display: none; }
.tab-group-label { width: 100%; font-size: .7rem; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; color: var(--muted); }
.admin-nav button { min-height: 40px; padding: .4rem .9rem; font-weight: 600; }
.admin-nav button:hover:not(.active) { border-color: var(--primary); color: var(--primary); }
.panel > h2:first-child, .panel > .card:first-child h2 { margin-top: .25rem; }

/* ---------- Dashboard quick actions ---------- */
.quick-actions { display: grid; grid-template-columns: repeat(auto-fit, minmax(170px, 1fr)); gap: .75rem; margin-bottom: 1rem; }
.qa { display: flex; flex-direction: column; align-items: flex-start; gap: .15rem; text-align: left; font: inherit; font-size: 1.6rem;
  background: var(--card); border: 1px solid var(--line); border-radius: var(--radius); padding: .9rem 1rem; cursor: pointer;
  transition: border-color .15s, box-shadow .15s, transform .1s; }
.qa b { font-size: 1rem; color: var(--primary); }
.qa small { font-size: .8rem; color: var(--muted); }
.qa:hover { border-color: var(--primary); box-shadow: 0 8px 20px -14px #a3172b88; }
.qa:active { transform: scale(.98); }
body.duty-view .quick-actions { display: none; }

@media (max-width: 640px) {
  /* Admin nav scrolls sideways on phones instead of becoming a wall of buttons */
  .admin-nav { flex-wrap: nowrap; overflow-x: auto; scrollbar-width: none; padding: .5rem; gap: 1rem; border-radius: 12px; }
  .admin-nav::-webkit-scrollbar { display: none; }
  .tab-group { flex-wrap: nowrap; }
  .tab-group-label { display: none; }
  .tab-group + .tab-group { border-left: 1px solid var(--line); padding-left: 1rem; }
  .admin-nav button { white-space: nowrap; }
  .quick-actions { grid-template-columns: 1fr 1fr; }
  .qa { padding: .75rem; }
  table { font-size: .85rem; }
}

/* ---------- Guest site ---------- */
.not-you { display: flex; flex-wrap: wrap; align-items: center; justify-content: center; gap: .5rem; padding: .6rem 1rem;
  background: var(--sand); border-bottom: 1px solid var(--line); font-size: 1rem; text-align: center; }
.hub { display: grid; gap: .75rem; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); }
.hub-tile { display: flex; flex-direction: column; gap: .2rem; text-decoration: none; color: inherit; transition: transform .1s, box-shadow .15s; }
.hub-tile:hover { box-shadow: 0 10px 26px -16px #2a1d1788; }
.hub-tile:active { transform: scale(.99); }
.hub-tile small { text-transform: uppercase; letter-spacing: .06em; font-weight: 700; color: var(--muted); font-size: .72rem; }
.hub-tile b { font-size: 1.1rem; }
#signinCta, a[href="register.html"].btn { margin: .25rem; }

@media (max-width: 640px) {
  /* Guest menu becomes a thumb-friendly bar pinned to the bottom of the screen */
  body:not(.admin-page) .topbar nav { position: fixed; left: 0; right: 0; bottom: 0; z-index: 50; order: 3; margin: 0;
    background: var(--card); border-top: 1px solid var(--line); box-shadow: 0 -6px 18px -12px #2a1d1766;
    padding: .35rem .25rem calc(.35rem + env(safe-area-inset-bottom)); justify-content: space-between; }
  body:not(.admin-page) .topbar nav a { flex: 1 0 64px; color: var(--muted); font-size: .7rem; text-align: center; opacity: 1;
    flex-direction: column; justify-content: center; padding: .2rem; border-radius: 10px; min-height: 52px; }
  body:not(.admin-page) .topbar nav a::before { content: attr(data-icon); display: block; font-size: 1.3rem; }
  body:not(.admin-page) .topbar nav a.current { color: var(--primary); background: #a3172b10; text-decoration: none; }
  body:not(.admin-page) main { padding-bottom: 5.5rem; }
  body:not(.admin-page) footer { padding-bottom: 6rem; }
}

@media (prefers-reduced-motion: reduce) {
  .qa, .hub-tile, .btn { transition: none !important; }
}

/* Gallery views */
.gallery-views{display:flex;flex-wrap:wrap;gap:.5rem;align-items:center;margin:.5rem 0 1rem}
.gallery-views select{width:auto;min-height:40px}
.gallery.feed{display:flex;flex-direction:column;gap:1rem}
.gallery.feed .tile{aspect-ratio:auto;width:100%}
.gallery.feed .tile img{width:100%;height:auto;max-height:80vh;object-fit:contain}
.viewer-bar{display:flex;flex-wrap:wrap;gap:.5rem;align-items:center;justify-content:center;margin-top:.5rem}
.viewer-bar [data-prev],.viewer-bar [data-next]{font-size:1.6rem;min-width:48px}

