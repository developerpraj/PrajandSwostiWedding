<!DOCTYPE html>
<html lang="ne">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
  <meta name="theme-color" content="#b3122e" />
  <meta name="mobile-web-app-capable" content="yes" />
  <meta name="apple-mobile-web-app-capable" content="yes" />
  <meta name="apple-mobile-web-app-title" content="शुभविवाह" />
  <link rel="manifest" href="manifest.json" />
  <link rel="apple-touch-icon" href="icons/apple-touch-icon.png" />
  <link rel="icon" type="image/png" href="icons/icon-192.png" />
  <link rel="preconnect" href="https://script.google.com" />
  <title>साइन इन · Sign in</title>
  <link rel="stylesheet" href="css/base.css" />
  <link rel="stylesheet" href="css/mobile.css" />
</head>
<body>
  <header class="topbar">
    <div class="brand">🪔 शुभविवाह</div>
    <nav>
      <a href="index.html" data-icon="🏠" data-i18n="nav.home">Home</a>
      <a href="photos.html" data-icon="📷" data-i18n="nav.photos" data-feature="feature.media">Photos</a>
    </nav>
    <div class="lang-switch" id="langSwitch"></div>
  </header>

  <main>
    <div id="msg" class="msg" hidden></div>
    <section class="card signin">
      <h1 data-i18n="signin.title">Welcome! Find your invitation</h1>

      <form id="phoneForm" hidden>
        <label data-i18n="signin.phone">Phone number</label>
        <input name="phone" type="tel" inputmode="tel" autocomplete="tel" required />
        <label data-i18n="signin.code">Invite code or date of birth</label>
        <input name="code" autocomplete="one-time-code" required />
        <p class="muted" data-i18n="signin.codeHelp"></p>
        <p><button class="btn big" data-i18n="signin.go">Continue</button></p>
      </form>

      <details id="findBox" class="find-pass">
        <summary data-i18n="find.title">Lost your link? Find my pass</summary>
        <form id="findForm">
          <label data-i18n="signin.phone">Phone number</label>
          <input name="phone" type="tel" inputmode="tel" autocomplete="tel" required />
          <label data-i18n="find.name">Your family name (surname)</label>
          <input name="name" autocomplete="family-name" required />
          <p><button class="btn big" data-i18n="find.go">Find my pass</button></p>
        </form>
      </details>

      <div id="googleBox" hidden>
        <p class="center muted" data-i18n="signin.or">or</p>
        <div id="gBtn" class="center"></div>
      </div>

      <p class="center"><a href="photos.html" data-i18n="signin.visitor">Just here to share photos?</a></p>
    </section>
  </main>

  <script src="js/config.js"></script>
  <script src="js/api.js"></script>
  <script src="js/i18n.js"></script>
  <script src="js/app.js"></script>
  <script>
    (async function () {
      const msg = document.getElementById('msg');
      let c;
      try { c = await App.boot(); } catch (e) { return; }
      const next = new URLSearchParams(location.search).get('next') || 'index.html';
      const done = res => { App.signedIn(res); location.href = res.registered ? next : 'register.html'; };

      if (App.on(c, 'auth.phone')) {
        const f = document.getElementById('phoneForm');
        f.hidden = false;
        f.addEventListener('submit', async e => {
          e.preventDefault();
          const b = f.querySelector('button'); b.disabled = true;
          try { done(await API.call('signIn', { method: 'phone', phone: f.phone.value, code: f.code.value.trim() })); }
          catch (err) { App.msg(msg, err.message, 'err'); b.disabled = false; }
        });
      }

      const ff = document.getElementById('findForm');
      ff.addEventListener('submit', async e => {
        e.preventDefault();
        const b = ff.querySelector('button'); b.disabled = true;
        try { done(await API.call('findPass', { phone: ff.phone.value, name: ff.name.value.trim() })); }
        catch (err) { App.msg(msg, err.message, 'err'); b.disabled = false; }
      });

      // Google blocks OAuth inside WhatsApp/Viber/Facebook webviews (disallowed_useragent).
      if (App.on(c, 'auth.google') && c['auth.googleClientId'] && App.inAppBrowser()) {
        App.msg(msg, I18N.t('inapp.google'), 'warn');
      } else if (App.on(c, 'auth.google') && c['auth.googleClientId']) {
        document.getElementById('googleBox').hidden = false;
        const s = document.createElement('script');
        s.src = 'https://accounts.google.com/gsi/client';
        s.async = true;
        s.onload = () => {
          google.accounts.id.initialize({
            client_id: c['auth.googleClientId'],
            callback: async r => {
              try { done(await API.call('signIn', { method: 'google', credential: r.credential, guestId: App.guestId() })); }
              catch (err) { App.msg(msg, err.message, 'err'); }
            }
          });
          google.accounts.id.renderButton(document.getElementById('gBtn'), { theme: 'outline', size: 'large', shape: 'pill' });
        };
        document.head.appendChild(s);
      }
    })();
  </script>
</body>
</html>
