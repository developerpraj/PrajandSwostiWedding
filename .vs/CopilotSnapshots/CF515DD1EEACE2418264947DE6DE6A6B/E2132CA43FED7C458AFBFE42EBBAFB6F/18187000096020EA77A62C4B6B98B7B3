// ---------- Entry points ----------

function doGet() {
  return json_({ ok: true, message: 'Wedding API running' });
}

function doPost(e) {
  try {
    const req = JSON.parse(e.postData.contents || '{}');
    const action = req.action || '';
    const data = req.data || {};
    if (action.indexOf('admin.') === 0) {
      const who = adminWho_(req.adminKey);
      if (!who) { activity_('admin', 'admin.denied', {}, req.client); return json_({ ok: false, error: 'unauthorized' }); }
      if (!roleAllows_(who.role, action)) return json_({ ok: false, error: 'Your role (' + who.role + ') cannot do this' });
      ADMIN_ = who;
      const fn = ADMIN_ACTIONS[action];
      if (!fn) return json_({ ok: false, error: 'unknown action' });
      const lock = /^admin\.(save|delete|import|thank|gen|check|verify|set|approve|reject)/.test(action) ? LockService.getScriptLock() : null;
      if (lock) lock.waitLock(20000);
      let out;
      try { out = fn(data); } finally { if (lock) lock.releaseLock(); }
      if (lock || /^admin\.(moderate|post|ritualNow|assignRoom|linkControl)/.test(action)) invalidateGuest_('');
      if (!/^admin\.(login|stats|guests|people|rooms|settings|events|media|games|memories|venues|planner|invites|proofs|logs)$/.test(action)) activity_('admin', action, Object.assign({ by: who.name }, data), req.client);
      return json_({ ok: true, data: out });
    }
    if (action === 'track') { activity_('guest', 'ui.' + str_(data.event).slice(0, 40), data, req.client); return json_({ ok: true, data: true }); }
    if (action === 'trackBatch') { activityBatch_(data.events || [], req.client); return json_({ ok: true, data: true }); }
    const fn = PUBLIC_ACTIONS[action];
    if (!fn) return json_({ ok: false, error: 'unknown action' });
    if (data.guestId) linkGuard_(tryGuest_(data.guestId));
    if (action !== 'getConfig' && isClosed_()) {
      const memorialAction = ['getMemorial', 'lightDiya', 'submitMemory'].indexOf(action) >= 0;
      if (!(memorialAction && settings_()['app.keepMemorialAfterEnd'] === 'TRUE')) return json_({ ok: false, error: 'closed' });
    }
    const out = PUBLIC_WRITE_ACTIONS.indexOf(action) >= 0 ? withLock_(() => fn(data, req.client)) : fn(data, req.client);
    if (PUBLIC_WRITE_ACTIONS.indexOf(action) >= 0 && data.guestId) invalidateGuest_(data.guestId);
    return json_({ ok: true, data: out });
  } catch (err) {
    return json_({ ok: false, error: String(err && err.message || err) });
  }
}

/** Runs fn inside the script lock so concurrent sheet writes queue instead of overwriting each other. */
function withLock_(fn) {
  const lock = LockService.getScriptLock();
  lock.waitLock(20000);
  try { return fn(); } finally { lock.releaseLock(); }
}

// ---------- Guest profile cache (6 h). Version keys make invalidation cheap: per guest + global (admin writes). ----------
const GUEST_CACHE_SECONDS = 21600;
function guestVersion_(guestId) {
  const c = CacheService.getScriptCache();
  return (c.get('gv_all') || '0') + '.' + (c.get('gv_' + guestId) || '0');
}
function invalidateGuest_(guestId) {
  try { CacheService.getScriptCache().put(guestId ? 'gv_' + guestId : 'gv_all', String(Date.now()), GUEST_CACHE_SECONDS); } catch (e) { }
}
function cachedGuest_(kind, d, fn) {
  if (!d || !d.guestId) return fn(d);
  const cache = CacheService.getScriptCache();
  const key = [kind, d.guestId, d.memberId || '', guestVersion_(d.guestId)].join('_').slice(0, 250);
  const hit = cache.get(key);
  if (hit) return JSON.parse(hit);
  const out = fn(d);
  // Do not keep a locked event hidden past its unlock time.
  const unlocks = ((out && out.events) || []).filter(e => e.locked && e.UnlockAt).map(e => new Date(e.UnlockAt).getTime()).filter(t => !isNaN(t));
  const ttl = unlocks.length ? Math.max(1, Math.min(GUEST_CACHE_SECONDS, Math.floor((Math.min.apply(null, unlocks) - Date.now()) / 1000))) : GUEST_CACHE_SECONDS;
  try { cache.put(key, JSON.stringify(out), ttl); } catch (e) { /* over 100KB */ }
  return out;
}

