// ---------- Silent activity logs (Google Drive spreadsheets, free) ----------

const SECRET_KEYS_ = /pass|key|credential|token|code|dob/i;

function logBook_(kind) {
  const props = PropertiesService.getScriptProperties();
  const prop = kind === 'admin' ? 'ADMIN_LOG_ID' : 'GUEST_LOG_ID';
  const id = props.getProperty(prop);
