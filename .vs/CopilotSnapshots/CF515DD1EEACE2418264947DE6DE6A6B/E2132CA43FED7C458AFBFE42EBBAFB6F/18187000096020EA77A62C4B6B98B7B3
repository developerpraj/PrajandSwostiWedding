// ---------- Setup / migration ----------

function setup() {
  const ss = SpreadsheetApp.getActive();
  Object.keys(SHEETS).forEach(name => {
    let sh = ss.getSheetByName(name);
    if (!sh) sh = ss.insertSheet(name);
    if (sh.getLastRow() === 0) {
      sh.appendRow(SHEETS[name]);
    } else {
      const head = sh.getRange(1, 1, 1, sh.getLastColumn()).getValues()[0];
      SHEETS[name].filter(c => head.indexOf(c) < 0).forEach(c => sh.getRange(1, sh.getLastColumn() + 1).setValue(c));
    }
    sh.setFrozenRows(1);
    sh.getRange(1, 1, 1, sh.getLastColumn()).setFontWeight('bold');
  });
  const existing = table_('Settings').map(s => s.Key);
  DEFAULT_SETTINGS.forEach(r => { if (existing.indexOf(r[0]) < 0) sheet_('Settings').appendRow(r); });
  const momKeys = table_('MomProfile').map(m => m.Key);
  DEFAULT_MOM.forEach(r => { if (momKeys.indexOf(r[0]) < 0) sheet_('MomProfile').appendRow(r); });
  if (table_('Games').length === 0) SAMPLE_GAMES.forEach(r => sheet_('Games').appendRow(r));
  if (table_('Rituals').length === 0) SAMPLE_RITUALS.forEach((r, i) => appendObj_('Rituals', { RitualId: 'R' + (i + 1), EventId: '', Order: i + 1, Icon: r[0], NameEn: r[1], NameNe: r[2], MeaningEn: r[3], MeaningNe: r[4], Status: 'upcoming', Visible: 'TRUE' }));
  if (table_('Traditions').length === 0) SAMPLE_TRADITIONS.forEach((r, i) => sheet_('Traditions').appendRow(['T' + (i + 1)].concat(r)));
  if (table_('Scenarios').length === 0) SAMPLE_SCENARIOS.forEach((r, i) => sheet_('Scenarios').appendRow(['S' + (i + 1)].concat(r)));

  const props = PropertiesService.getScriptProperties();
  if (!props.getProperty('ADMIN_PASSCODE')) props.setProperty('ADMIN_PASSCODE', 'change-me-now');
  if (!props.getProperty('ROOT_FOLDER_ID')) {
    const root = DriveApp.createFolder('Wedding');
    ['Invites', 'Mom'].forEach(n => root.createFolder(n));
    props.setProperty('ROOT_FOLDER_ID', root.getId());
  }
  uploadsFolder_();
  organizeDrive_();
  if (!ScriptApp.getProjectTriggers().some(t => t.getHandlerFunction() === 'nightlyBackup')) {
    ScriptApp.newTrigger('nightlyBackup').timeBased().everyDays(1).atHour(3).create();
  }
  const def = ss.getSheetByName('Sheet1');
  if (def && ss.getSheets().length > 1) ss.deleteSheet(def);
  CacheService.getScriptCache().removeAll(['config', 'settings']);
}

