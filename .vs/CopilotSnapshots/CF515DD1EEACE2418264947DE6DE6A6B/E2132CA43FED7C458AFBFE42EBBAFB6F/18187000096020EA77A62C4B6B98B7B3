const AGE_SCORE = { A: 5, B: 4, C: 3, D: 2, E: 1.5, F: 1 };   // A 20-30, B 30-40, C 40-50, D 1-10, E 50-60, F 60+
const FUN_SCORE = { A: 5, B: 4, C: 3, D: 2, E: 1, F: 0 };     // very funny ... very boring
const EPR_SCORE = { A: 3, B: 2, C: 1, D: 0.67, E: 0.33 };      // per letter, 3 letters (AAA = 9)

function vibeScore_(r) {
  const age = AGE_SCORE[String(r.AgeBand).toUpperCase()] || 0;
  const fun = FUN_SCORE[String(r.Fun).toUpperCase()] || 0;
  const epr = String(r.EduProf || '').toUpperCase().split('').reduce((a, c) => a + (EPR_SCORE[c] || 0), 0);
  const eprBand = !r.EduProf ? '' : epr > 7 ? 'Best' : epr >= 4 ? 'Average' : 'Okay';
  // Vibe = energy (fun, 50%) + youth/mix (age, 25%) + steadiness (EPR scaled to 5, 25%)
  const vibe = Math.round((fun * 0.5 + age * 0.25 + (epr / 9 * 5) * 0.25) * 100) / 100;
  return { age: age, fun: fun, epr: Math.round(epr * 100) / 100, eprBand: eprBand, vibe: vibe };
}

function adminPlanner_() {
  const people = table_('Vibe').map(r => Object.assign(r, vibeScore_(r)));
  const sides = {};
  people.forEach(p => {
    const k = p.Side || 'Other';
    const s = sides[k] = sides[k] || { people: 0, confirmed: 0, unconfirmed: 0, fun: 0, age: 0, epr: 0, vibe: 0, n: 0,
      funMix: { good: 0, okay: 0, boring: 0 }, eprMix: { Best: 0, Average: 0, Okay: 0 }, circles: {} };
    const count = Number(p.Attendance) || 0;
    s.people += count;
    if (bool_(p.Confirmed)) s.confirmed += count; else s.unconfirmed += count;
    s.n++; s.fun += p.fun; s.age += p.age; s.epr += p.epr; s.vibe += p.vibe;
    if (p.Fun) s.funMix[p.fun >= 4 ? 'good' : p.fun >= 2 ? 'okay' : 'boring']++;
    if (p.eprBand) s.eprMix[p.eprBand]++;
    s.circles[p.Circle || '—'] = (s.circles[p.Circle || '—'] || 0) + count;
  });
  Object.keys(sides).forEach(k => {
    const s = sides[k];
    ['fun', 'age', 'epr', 'vibe'].forEach(x => s[x + 'Avg'] = s.n ? Math.round(s[x] / s.n * 100) / 100 : 0);
  });
  const traditions = table_('Traditions');
  const boost = traditions.filter(t => bool_(t.Include)).reduce((a, t) => a + (Number(t.VibeBoost) || 0), 0);
  const all = people.length ? people.reduce((a, p) => a + p.vibe, 0) / people.length : 0;
  const tips = [];
  Object.keys(sides).forEach(k => {
    const s = sides[k];
    if (s.funAvg && s.funAvg < 3) tips.push(k + ': low energy (' + s.funAvg + '/5) - seat high-fun people at every table, add a game or procession.');
    if (s.unconfirmed > s.confirmed) tips.push(k + ': more unconfirmed than confirmed - send WhatsApp reminders.');
  });
  const ks = Object.keys(sides);
  if (ks.length >= 2) {
    const a = sides[ks[0]], b = sides[ks[1]];
    if (Math.max(a.people, b.people) > 1.5 * Math.max(1, Math.min(a.people, b.people))) tips.push('Sides are unbalanced in size - mix tables across sides and use Bride vs Groom team games.');
  }
  if (!traditions.some(t => bool_(t.Include))) tips.push('No traditions selected yet - pick 3-5 that fit the families.');
  return {
    people: people, sides: sides, traditions: traditions, scenarios: table_('Scenarios'),
    totals: { people: people.reduce((a, p) => a + (Number(p.Attendance) || 0), 0), vibePerPerson: Math.round(all * 100) / 100,
      traditionBoost: boost, forecast: Math.min(10, Math.round((all * 2 + boost) * 10) / 10) },
    tips: tips
  };
}

