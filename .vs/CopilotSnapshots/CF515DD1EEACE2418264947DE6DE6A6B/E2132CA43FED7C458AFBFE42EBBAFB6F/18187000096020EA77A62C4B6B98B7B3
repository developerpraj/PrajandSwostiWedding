/** Daily copy of the whole database into Wedding/Backups (keeps last 30). */
function nightlyBackup() {
  const b = subFolder_('Backups');
  const name = 'Wedding data ' + Utilities.formatDate(new Date(), Session.getScriptTimeZone(), 'yyyy-MM-dd');
  if (!b.getFilesByName(name).hasNext()) DriveApp.getFileById(SpreadsheetApp.getActive().getId()).makeCopy(name, b);
  const files = []; const it = b.getFiles(); while (it.hasNext()) files.push(it.next());
  files.sort((x, y) => y.getDateCreated() - x.getDateCreated()).slice(30).forEach(f => f.setTrashed(true));
}

