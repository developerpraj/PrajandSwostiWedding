/** Logistics + engagement analytics for admin (counts only; heavy log reading limited to last 5000 rows). */
function adminAnalytics_() {
  const guests = table_('Guests');
  const members = table_('Members').filter(m => !/^removed:/.test(m.GuestId));
  const media = table_('Media');
  const gifts = table_('Gifts');
  const inv = table_('Invites');
  const proofs = table_('Proofs');
  const acc = table_('Accommodation');
  const venues = {};
  guests.forEach(g => { if (g.VenueId) venues[g.VenueId] = (venues[g.VenueId] || 0) + 1; });
  const vnames = {};
  table_('Venues').forEach(v => vnames[v.VenueId] = v.NameEn || v.VenueId);
  const ages = { '0-12': 0, '13-17': 0, '18-35': 0, '36-60': 0, '60+': 0, unknown: 0 };
  members.forEach(m => {
    const a = ageFrom_(m.DOB);
    if (a === '') ages.unknown++; else if (a < 13) ages['0-12']++; else if (a < 18) ages['13-17']++; else if (a <= 35) ages['18-35']++; else if (a <= 60) ages['36-60']++; else ages['60+']++;
  });
  const byEvent = {};
  media.forEach(m => { const k = m.EventId || 'General'; byEvent[k] = (byEvent[k] || 0) + 1; });
  const evn = {};
  table_('Events').forEach(e => evn[e.EventId] = e.NameEn);
  const uploaders = {};
  media.forEach(m => { const k = m.Name || '?'; uploaders[k] = (uploaders[k] || 0) + 1; });
  const topUploaders = Object.keys(uploaders).map(k => ({ name: k, count: uploaders[k] })).sort((a, b) => b.count - a.count).slice(0, 10);
  const giftSum = {};
  gifts.forEach(g => { const c = g.Currency || 'NPR'; giftSum[c] = (giftSum[c] || 0) + (Number(g.Amount) || 0); });

  // Activity from the silent guest log
  const act = { today: 0, week: 0, activeToday: 0, activeWeek: 0, byHour: Array(24).fill(0), topPages: [], topActions: [], devices: { phone: 0, desktop: 0 } };
  try {
    const sh = logBook_('guest').getSheets()[0];
    const last = sh.getLastRow();
    if (last > 1) {
      const start = Math.max(2, last - 5000);
      const rows = sh.getRange(start, 1, last - start + 1, 8).getValues();
      const now = Date.now(), dayMs = 86400000;
      const uT = {}, uW = {}, pages = {}, actions = {}, sess = {};
      rows.forEach(r => {
        const t = new Date(r[0]).getTime();
        if (isNaN(t)) return;
        const who = r[2] || r[7];
        if (now - t < dayMs) { act.today++; uT[who] = 1; act.byHour[new Date(t).getHours()]++; }
        if (now - t < 7 * dayMs) { act.week++; uW[who] = 1; }
        pages[r[5] || '?'] = (pages[r[5] || '?'] || 0) + 1;
        actions[r[1]] = (actions[r[1]] || 0) + 1;
        if (!sess[r[7]]) { sess[r[7]] = 1; act.devices[/Mobi|Android|iPhone/i.test(r[6]) ? 'phone' : 'desktop']++; }
      });
      act.activeToday = Object.keys(uT).length;
      act.activeWeek = Object.keys(uW).length;
      const top = o => Object.keys(o).map(k => ({ k: k, n: o[k] })).sort((a, b) => b.n - a.n).slice(0, 8);
      act.topPages = top(pages);
      act.topActions = top(actions);
    }
  } catch (e) { /* log not created yet */ }

  return {
    notRegistered: guests.filter(g => !bool_(g.Registered)).map(g => ({ name: g.Name, phone: g.Phone, side: g.Side })).slice(0, 200),
    venues: Object.keys(venues).map(k => ({ venue: vnames[k] || k, guests: venues[k] })),
    ages: ages,
    accommodation: { requested: acc.filter(a => a.Status === 'Requested').length, unassigned: acc.filter(a => a.Status !== 'Assigned').length },
    invites: { requested: inv.filter(i => i.Status === 'Requested').length, approved: inv.filter(i => i.Status === 'Approved').length },
    proofsPending: proofs.filter(p => p.Status === 'Pending').length,
    media: { total: media.length, videos: media.filter(m => m.Type === 'video').length, sizeGB: Math.round(media.reduce((t, m) => t + (Number(m.SizeBytes) || 0), 0) / 1073741824 * 100) / 100,
      byEvent: Object.keys(byEvent).map(k => ({ event: evn[k] || k, count: byEvent[k] })), topUploaders: topUploaders },
    gifts: { count: gifts.length, notThanked: gifts.filter(g => !g.ThankedAt).length, totals: giftSum },
    activity: act
  };
}

