/** Resolves the person using the app: guest + member (falls back to primary member). */
function identity_(d, required) {
  const g = d.guestId ? tryGuest_(d.guestId) : null;
  if (!g) {
    if (required) throw new Error('Invalid guest link');
    return { guest: null, member: null };
  }
  const members = membersOf_(g.GuestId);
  let m = d.memberId ? members.filter(x => x.MemberId === d.memberId)[0] : null;
  if (!m) m = members.filter(x => bool_(x.IsPrimary))[0] || null;
  return { guest: g, member: m };
}

function personName_(id, d) {
  if (id.member) return id.member.Name;
  if (id.guest) return id.guest.Name;
  return str_(d && d.name).slice(0, 80) || 'Guest';
}

function personSide_(id, d) {
  if (id.member && id.member.RelationTo) return sideOf_(id.member.RelationTo);
  if (id.guest) return id.guest.Side || sideOf_(id.guest.RelationTo);
  return sideOf_(d && d.relationTo);
}

