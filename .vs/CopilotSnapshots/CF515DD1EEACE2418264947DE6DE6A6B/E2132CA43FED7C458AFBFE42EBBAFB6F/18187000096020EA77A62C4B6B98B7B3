function register_(d) {
  const s = settings_();
  if (s['feature.registration'] !== 'TRUE' || s['registration.open'] !== 'TRUE') throw new Error('Registration closed');
  const g = findGuest_(d.guestId);
  const f = d.form || {};
  ['Name', 'Phone', 'DOB', 'RelationTo', 'RelationType', 'Relation'].forEach(k => { if (!f[k]) throw new Error('Missing ' + k); });
  if (s['contact.requireEmail'] === 'TRUE' && !f.Email) throw new Error('Missing Email');
  if (RELATION_TO.indexOf(f.RelationTo) < 0) throw new Error('Invalid relation');
  const admit = Number(g.AdmitCount) || 1;
  const now = now_();
  const attending = f.Status === 'Attending' || f.Status === 'Maybe';

  const incoming = (d.members || []).filter(m => str_(m.Name)).slice(0, 20);
  incoming.forEach(m => {
    if (RELATION_TO.indexOf(m.RelationTo) < 0) throw new Error('Please choose relation for ' + m.Name);
  });
  const seen = [normName_(f.Name)];
  incoming.forEach(m => {
    const n = normName_(m.Name);
    if (seen.indexOf(n) >= 0) throw new Error('Duplicate name: ' + m.Name);
    seen.push(n);
  });
  const mine = membersOf_(g.GuestId).map(x => x.MemberId);
  [f.Name].concat(incoming.map(m => m.Name)).forEach(n => {
    const dup = nameOwner_(n, g.GuestId, mine);
    if (dup) throw new Error('Already registered: ' + n + ' - please select from the list instead');
  });
  const isGoing = m => m.Attending !== false && m.Attending !== 'FALSE';
  const attendingCount = attending ? 1 + incoming.filter(isGoing).length : 0;
  if (attendingCount > admit) throw new Error('Maximum ' + admit + ' people for this invitation');

  updateBy_('Guests', 'GuestId', g.GuestId, {
    Name: str_(f.Name), NameNe: str_(f.NameNe), Phone: str_(f.Phone), Email: str_(f.Email),
    DOB: str_(f.DOB), Age: ageFrom_(f.DOB), NonDrinker: bool_(f.NonDrinker) ? 'TRUE' : 'FALSE',
    RelationTo: str_(f.RelationTo), RelationType: str_(f.RelationType), Side: sideOf_(f.RelationTo),
    Relation: str_(f.Relation), RelationNe: str_(f.RelationNe),
    AttendingCount: attendingCount, Status: str_(f.Status) || 'Pending', Meal: str_(f.Meal), Allergies: str_(f.Allergies),
    Arrival: str_(f.Arrival), Departure: str_(f.Departure),
    ContactPref: str_(f.ContactPref) || (f.Email ? 'email' : 'whatsapp'), VenueId: str_(f.VenueId) || g.VenueId || '',
    Registered: 'TRUE', RegisteredAt: g.RegisteredAt || now
  });

  const existing = membersOf_(g.GuestId);
  let primary = existing.filter(m => bool_(m.IsPrimary))[0];
  const primaryRow = {
    GuestId: g.GuestId, Name: str_(f.Name), NameNe: str_(f.NameNe), RelationTo: str_(f.RelationTo),
    RelationType: str_(f.RelationType), Relation: str_(f.Relation), RelationNe: str_(f.RelationNe), DOB: str_(f.DOB),
    NonDrinker: bool_(f.NonDrinker) ? 'TRUE' : 'FALSE', Attending: attending ? 'TRUE' : 'FALSE', IsPrimary: 'TRUE'
  };
  if (primary) updateBy_('Members', 'MemberId', primary.MemberId, primaryRow);
  else { primary = Object.assign({ MemberId: id_(), CreatedAt: now }, primaryRow); appendObj_('Members', primary); }

  const keep = [primary.MemberId];
  incoming.forEach(m => {
    const own = m.MemberId && existing.some(x => x.MemberId === m.MemberId && !bool_(x.IsPrimary));
    const row = {
      GuestId: g.GuestId, Name: str_(m.Name).slice(0, 80), NameNe: str_(m.NameNe).slice(0, 80),
      RelationTo: str_(m.RelationTo), RelationType: str_(m.RelationType), Relation: str_(m.Relation).slice(0, 60),
      RelationNe: str_(m.RelationNe).slice(0, 60), DOB: str_(m.DOB), NonDrinker: bool_(m.NonDrinker) ? 'TRUE' : 'FALSE',
      Attending: attending && isGoing(m) ? 'TRUE' : 'FALSE', IsPrimary: 'FALSE'
    };
    if (own) { updateBy_('Members', 'MemberId', m.MemberId, row); keep.push(m.MemberId); }
    else { const nid = id_(); appendObj_('Members', Object.assign({ MemberId: nid, CreatedAt: now }, row)); keep.push(nid); }
  });
  existing.filter(x => keep.indexOf(x.MemberId) < 0).forEach(x => {
    if (softDelete_()) updateBy_('Members', 'MemberId', x.MemberId, { GuestId: 'removed:' + g.GuestId, Attending: 'FALSE' });
    else deleteBy_('Members', 'MemberId', x.MemberId);
  });

  const fresh = tryGuest_(g.GuestId);
  const allowed = visibleEvents_(fresh, null).filter(e => !e.locked).map(e => e.EventId);
  (d.events || []).forEach(ev => {
    if (allowed.indexOf(ev.EventId) < 0) return;
    upsertComposite_('EventRsvp', ['GuestId', 'EventId'], g.GuestId + '|' + ev.EventId, {
      GuestId: g.GuestId, EventId: ev.EventId, Response: str_(ev.Response),
      Count: Math.max(0, Math.min(attendingCount, Number(ev.Count) || 0)), UpdatedAt: now
    });
  });

  if (f.Email) {
    try {
      MailApp.sendEmail(f.Email, 'Registration confirmed / दर्ता पुष्टि भयो',
        'Namaste ' + f.Name + ',\n\nThank you for registering. Your family guest passes are ready in the wedding app.\n\nधन्यवाद');
    } catch (e) { /* quota or invalid address */ }
  }
  log_('register', g.GuestId);
  return { members: membersOf_(g.GuestId).map(publicMember_), primaryMemberId: primary.MemberId };
}

