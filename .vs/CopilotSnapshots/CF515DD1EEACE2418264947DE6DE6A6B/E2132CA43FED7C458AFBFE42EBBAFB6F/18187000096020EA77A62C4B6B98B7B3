// ---------- Thank-you engine: one row per household combining gifts + presence ----------
function adminThankQueue_() {
  const s = settings_();
  const couple = [s['couple.brideEn'], s['couple.groomEn']].filter(String).join(' & ');
  const evName = {};
  table_('Events').forEach(e => evName[e.EventId] = e.NameEn);
  const guests = {};
  table_('Guests').forEach(g => guests[g.GuestId] = g);
  const rs = table_('EventRsvp'), sent = table_('ThankYous');
  const out = {}, key = (gid, name) => gid || 'n:' + String(name).toLowerCase().trim();
  table_('Gifts').forEach(x => {
    const k = key(x.GuestId, x.Name), g = guests[x.GuestId] || {};
    const o = out[k] = out[k] || { key: k, guestId: x.GuestId, name: x.Name || g.Name, relation: x.Relation || g.Relation || '', phone: x.Phone || g.Phone || '', email: g.Email || '', gifts: [], events: [], giftIds: [] };
    o.gifts.push(/cash|envelope/i.test(x.Method) ? 'kind envelope' : x.Method ? 'gift via ' + x.Method : 'gift');
    o.giftIds.push(x.GiftId);
    if (x.EventId && evName[x.EventId]) o.events.push(evName[x.EventId]);
    if (x.ThankedAt) o.thankedAt = x.ThankedAt;
  });
  rs.filter(r => bool_(r.Attended) || (!r.Attended && r.Response === 'Yes')).forEach(r => {
    const g = guests[r.GuestId]; if (!g) return;
    const o = out[r.GuestId] = out[r.GuestId] || { key: r.GuestId, guestId: r.GuestId, name: g.Name, relation: g.Relation || '', phone: g.Phone || '', email: g.Email || '', gifts: [], events: [], giftIds: [] };
    if (evName[r.EventId] && o.events.indexOf(evName[r.EventId]) < 0) o.events.push(evName[r.EventId]);
  });
  return Object.keys(out).map(k => {
    const o = out[k];
    const gift = o.gifts.length ? Array.from(new Set(o.gifts)).join(' and ') : 'presence';
    const event = o.events.length ? o.events.join(', ') : 'our wedding';
    const fill = t => String(t || '').replace(/\{name\}/g, o.name).replace(/\{gift\}/g, gift).replace(/\{event\}/g, event).replace(/\{relation\}/g, o.relation).replace(/\{couple\}/g, couple);
    const last = sent.filter(t => (o.guestId && t.GuestId === o.guestId) || t.Name === o.name).pop();
    o.message = fill(o.gifts.length ? s['thanks.tplGift'] : s['thanks.tplPresence']);
    o.messageNe = fill(s['thanks.tplNe']);
    o.sentAt = last ? last.SentAt : o.thankedAt || '';
    o.sentVia = last ? last.Channel : '';
    return o;
  });
}

