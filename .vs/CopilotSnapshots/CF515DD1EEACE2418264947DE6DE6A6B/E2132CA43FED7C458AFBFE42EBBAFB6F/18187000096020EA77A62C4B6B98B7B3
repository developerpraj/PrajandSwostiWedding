  ss.getSheets()[0].appendRow(['Timestamp', 'Action', 'GuestId', 'MemberId', 'Name', 'Page', 'Device', 'Session', 'Details']);
  ss.getSheets()[0].setFrozenRows(1);
  DriveApp.getFileById(ss.getId()).moveTo(folder);
  props.setProperty(prop, ss.getId());
  return ss;
}

function activity_(kind, action, data, client) {
  try {
    if (kind === 'guest' && settings_()['log.activity'] === 'FALSE') return;
    const c = client || {};
    const clean = {};
    Object.keys(data || {}).forEach(k => {
      if (SECRET_KEYS_.test(k)) { clean[k] = '***'; return; }
      const v = data[k];
      clean[k] = typeof v === 'object' ? JSON.stringify(v).slice(0, 2000) : String(v).slice(0, 500);
    });
    const g = data && data.guestId ? tryGuest_(data.guestId) : null;
    logBook_(kind).getSheets()[0].appendRow([
      now_(), action, str_(data && data.guestId), str_(data && data.memberId), g ? g.Name : str_(data && data.name),
      str_(c.page).slice(0, 80), str_(c.ua).slice(0, 160), str_(c.sid).slice(0, 40), JSON.stringify(clean).slice(0, 45000)
    ]);
  } catch (e) { /* logging must never break the app */ }
}

// One sheet write for many events (saves Apps Script quota).
function activityBatch_(events, client) {
  try {
    if (settings_()['log.activity'] === 'FALSE' || !events.length) return;
    const c = client || {};
    const names = {};
    const rows = events.slice(0, 200).map(d => {
      const clean = {};
      Object.keys(d || {}).forEach(k => { const v = d[k]; clean[k] = SECRET_KEYS_.test(k) ? '***' : typeof v === 'object' ? JSON.stringify(v).slice(0, 2000) : String(v).slice(0, 500); });
      const gid = str_(d.guestId);
      if (gid && !(gid in names)) { const g = tryGuest_(gid); names[gid] = g ? g.Name : ''; }
      return [str_(d.at) || now_(), 'ui.' + str_(d.event).slice(0, 40), gid, str_(d.memberId), names[gid] || '',
        str_(d.page || c.page).slice(0, 80), str_(c.ua).slice(0, 160), str_(c.sid).slice(0, 40), JSON.stringify(clean).slice(0, 45000)];
    });
    const sh = logBook_('guest').getSheets()[0];
    sh.getRange(sh.getLastRow() + 1, 1, rows.length, rows[0].length).setValues(rows);
  } catch (e) { /* never break the app */ }
}

