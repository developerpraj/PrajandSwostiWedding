function rootFolder_() { return DriveApp.getFolderById(PropertiesService.getScriptProperties().getProperty('ROOT_FOLDER_ID')); }
function subFolder_(name) {
  const root = rootFolder_(), it = root.getFoldersByName(name);
  return it.hasNext() ? it.next() : root.createFolder(name);
}
function organizeDrive_() {
  ['Data', 'Uploads', 'Gift QR', 'Envelopes', 'Logs', 'Invites', 'Proofs', 'Mom', 'Backups'].forEach(subFolder_);
