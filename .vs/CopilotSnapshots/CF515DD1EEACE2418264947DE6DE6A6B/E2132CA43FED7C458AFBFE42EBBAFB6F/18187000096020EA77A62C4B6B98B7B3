// ---------- Household page / magic invitation codes ----------

function newCode_() {
  const used = {};
  table_('Guests').forEach(g => used[String(g.InviteCode).toUpperCase()] = 1);
  const chars = 'ABCDEFGHJKMNPQRSTUVWXYZ23456789';
  let c;
  do { c = ''; for (let i = 0; i < 6; i++) c += chars.charAt(Math.floor(Math.random() * chars.length)); } while (used[c]);
  return c;
}

function adminGenCodes_(d) {
  let n = 0;
  table_('Guests').forEach(g => {
    if (g.InviteCode && !bool_(d && d.regenerate)) return;
    updateBy_('Guests', 'GuestId', g.GuestId, { InviteCode: newCode_() }); n++;
  });
  return n;
}

function resolveCode_(d) {
  const c = str_(d.code).toUpperCase().replace(/[^A-Z0-9]/g, '');
  const g = c.length >= 6 ? table_('Guests').filter(x => String(x.InviteCode).toUpperCase() === c || String(x.GuestId).toUpperCase() === c)[0] : null;
  if (!g) { Utilities.sleep(600); throw new Error('Invitation code not found'); }
  linkGuard_(g);
  if (!bool_(g.InviteOpened)) updateBy_('Guests', 'GuestId', g.GuestId, { InviteOpened: 'TRUE' });
  return { guestId: g.GuestId };
}

function adminHousehold_(d) {
