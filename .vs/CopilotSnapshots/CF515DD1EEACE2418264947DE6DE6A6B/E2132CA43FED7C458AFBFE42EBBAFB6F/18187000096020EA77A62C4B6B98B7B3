// ---------- Media (photos & videos to Google Drive) ----------

/**
 * Creates a Google Drive resumable upload session owned by the script owner.
 * The browser PUTs the file bytes straight to Drive (no Apps Script size limit),
 * then calls finishUpload with the returned Drive file id.
 */
function startUpload_(d) {
  const s = settings_();
  if (s['feature.media'] !== 'TRUE') throw new Error('Sharing is off');
  const id = identity_(d, false);
  if (!id.guest && !(s['media.allowVisitors'] === 'TRUE' && str_(d.name))) throw new Error('Please tell us your name');
  const mime = str_(d.mimeType).toLowerCase();
  if (!/^(image|video)\//.test(mime)) throw new Error('Only photos and videos');
  const size = Number(d.size) || 0;
  const max = (Number(s['media.maxSizeMB']) || 500) * 1024 * 1024;
  if (!size || size > max) throw new Error('File too large (max ' + s['media.maxSizeMB'] + ' MB)');

  const name = personName_(id, d);
  const taken = d.takenAt && !isNaN(new Date(d.takenAt)) ? new Date(d.takenAt) : new Date();
  const ev = d.eventId ? table_('Events').filter(e => e.EventId === d.eventId)[0] : null;
  const fileName = (s['media.chronoNames'] === 'FALSE'
    ? Utilities.formatDate(new Date(), 'UTC', 'yyyyMMdd-HHmmss') + '_' + name + '_' + str_(d.fileName)
    : [ev ? str_(ev.NameEn || ev.EventId) : 'General', Utilities.formatDate(taken, Session.getScriptTimeZone(), 'yyyy-MM-dd_HH-mm-ss'),
      String(name).split(' ')[0], str_(d.fileName)].join('_'))
    .replace(/[\\/:*?"<>|\s]+/g, '_').slice(0, 150);
  const headers = {
    Authorization: 'Bearer ' + ScriptApp.getOAuthToken(),
    'X-Upload-Content-Type': mime,
    'X-Upload-Content-Length': String(size)
  };
  if (d.origin) headers.Origin = str_(d.origin);
  const res = UrlFetchApp.fetch('https://www.googleapis.com/upload/drive/v3/files?uploadType=resumable&fields=id', {
    method: 'post',
    contentType: 'application/json; charset=UTF-8',
    headers: headers,
    payload: JSON.stringify({ name: fileName, mimeType: mime, parents: [eventFolder_(str_(d.eventId)).getId()] }),
    muteHttpExceptions: true
  });
  const h = res.getAllHeaders();
  const url = h.Location || h.location;
  if (res.getResponseCode() >= 300 || !url) throw new Error('Upload could not start');

  const token = Utilities.getUuid();
  CacheService.getScriptCache().put('up_' + token, JSON.stringify({
    guestId: id.guest ? id.guest.GuestId : '', memberId: id.member ? id.member.MemberId : '',
    name: name, side: personSide_(id, d), eventId: str_(d.eventId).slice(0, 40), mime: mime, fileName: str_(d.fileName).slice(0, 120),
    takenAt: str_(d.takenAt).slice(0, 30), device: str_(d.device).slice(0, 80), size: size, purpose: ['gift', 'whisper'].indexOf(str_(d.purpose)) >= 0 ? str_(d.purpose) : '',
    anon: bool_(d.anon) || str_(d.purpose) === 'whisper',
    audioFlag: str_(d.audioFlag) === 'distorted' ? 'distorted' : str_(d.audioFlag) === 'ok' ? 'ok' : '', clipPct: Math.max(0, Math.min(100, Number(d.clipPct) || 0)),
    category: str_(d.category).slice(0, 40)
  }), 21600);
  return { uploadUrl: url, token: token };
}

function finishUpload_(d) {
  const raw = CacheService.getScriptCache().get('up_' + str_(d.token));
  if (!raw) throw new Error('Upload expired');
  const p = JSON.parse(raw);
  const file = DriveApp.getFileById(str_(d.fileId));
  const folderId = uploadsFolder_().getId();
  let inFolder = false;
  const parents = file.getParents();
  while (parents.hasNext()) {
    const pf = parents.next();
    if (pf.getId() === folderId) inFolder = true;
    const gp = pf.getParents();
    while (gp.hasNext()) if (gp.next().getId() === folderId) inFolder = true;
  }
  if (!inFolder) throw new Error('Invalid file');
  if (table_('Media').some(m => m.DriveFileId === file.getId())) throw new Error('Already saved');
  // View-only link: everyone can see & download; nobody else can edit or delete.
  if (!p.purpose) file.setSharing(DriveApp.Access.ANYONE_WITH_LINK, DriveApp.Permission.VIEW);
  if (p.anon) { try { file.setName('anon_' + Utilities.formatDate(new Date(), 'UTC', 'yyyyMMdd-HHmmss') + '_' + id_() + (p.fileName.match(/\.[^.]+$/) || [''])[0]); } catch (e) { } }
  const moderated = settings_()['media.moderation'] === 'TRUE';
  const row = {
    MediaId: id_(), GuestId: p.guestId, MemberId: p.memberId, Name: p.name, Side: p.side, EventId: p.eventId,
    DriveFileId: file.getId(), Type: /^video/.test(p.mime) ? 'video' : 'photo', MimeType: p.mime, FileName: p.fileName,
    Timestamp: now_(), TakenAt: p.takenAt || '', Device: p.device || '', SizeBytes: p.size || '', Anon: p.anon ? 'TRUE' : '',
        AudioFlag: p.audioFlag || '', ClipPct: p.clipPct || '', Category: p.category || '',
        Thumb: /^data:image\/jpeg;base64,[A-Za-z0-9+/=]+$/.test(str_(d.thumb)) && str_(d.thumb).length < 45000 ? str_(d.thumb) : ''
      };
      if (p.audioFlag === 'distorted') { try { file.setDescription('Audio distorted (' + p.clipPct + '% clipped) - use as muted B-roll'); } catch (e) { } }
  appendObj_('Media', row);
  CacheService.getScriptCache().remove('up_' + str_(d.token));
  return { pending: moderated, media: publicMedia_(row) };
}

function getGallery_(d) {
  if (settings_()['feature.media'] !== 'TRUE') throw new Error('Sharing is off');
  let list = approvedMedia_();
  if (d.eventId) list = list.filter(m => m.EventId === d.eventId);
  if (d.side) list = list.filter(m => m.Side === d.side);
  if (d.mine && d.guestId) list = list.filter(m => m.GuestId === d.guestId);
  return list.slice(0, Math.min(Number(d.limit) || 300, 500)).map(m => {
    const x = publicMedia_(m);
    x.mine = !!d.guestId && m.GuestId === d.guestId;
    return x;
  });
}

function deleteMedia_(d) {
  const g = findGuest_(d.guestId);
  const m = table_('Media').filter(x => x.MediaId === d.mediaId)[0];
  if (!m || m.GuestId !== g.GuestId) throw new Error('You can only remove your own uploads');
  // Guest always sees "deleted". With data.softDelete ON (admin only) the file and row are kept.
  updateBy_('Media', 'MediaId', m.MediaId, { Status: 'Deleted' });
  if (!softDelete_()) { try { DriveApp.getFileById(m.DriveFileId).setTrashed(true); } catch (e) { /* already gone */ } }
  return true;
