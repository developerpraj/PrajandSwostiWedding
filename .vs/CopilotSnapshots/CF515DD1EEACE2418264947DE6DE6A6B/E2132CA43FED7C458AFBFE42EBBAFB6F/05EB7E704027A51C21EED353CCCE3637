@import url('https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@400;600&display=swap');
body.memorial { background: #fbf7f0; font-family: 'Cormorant Garamond', 'Tiro Devanagari Hindi', Georgia, serif; font-size: 1.08rem; }
body.memorial .topbar { background: linear-gradient(135deg, #8a6d3b, #5b4526); }
body.memorial h1, body.memorial h2 { color: #6b4f1d; }

.tribute .frame {
  width: 200px; height: 200px; margin: 0 auto 1rem; border-radius: 50%;
  border: 8px solid #f2b631; box-shadow: 0 0 0 6px #f7d77a55, 0 0 30px #f2b63166;
  overflow: hidden; background: #f3eadb; display: flex; align-items: center; justify-content: center; font-size: 4rem;
}
.tribute .frame img { width: 100%; height: 100%; object-fit: cover; }
.dedication { font-size: 1.1rem; font-style: italic; }
blockquote { border-left: 4px solid #f2b631; margin: 1rem auto; padding: .5rem 1rem; max-width: 600px; text-align: left; }

.diyas { display: flex; flex-wrap: wrap; justify-content: center; gap: .25rem; min-height: 40px; font-size: 1.4rem; }
.diyas span { animation: flicker 2.5s infinite alternate; }
@keyframes flicker { from { opacity: .7; transform: scale(.95); } to { opacity: 1; transform: scale(1.05); } }
.diya-form { display: flex; gap: .5rem; max-width: 500px; margin: 1rem auto; flex-wrap: wrap; }
.diya-form input { flex: 1; min-width: 200px; }

.blessings { margin-top: 1rem; display: grid; gap: .5rem; }
.blessings div { background: #fff8e6; border-radius: 10px; padding: .5rem .8rem; text-align: left; }

.wall { display: grid; gap: .75rem; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); }
.memory { background: #fffdf8; border: 1px solid #efe2c8; border-radius: 12px; padding: 1rem; white-space: pre-wrap; }
.memory .who { margin-top: .5rem; color: #8a6d3b; font-weight: 600; white-space: normal; }
