// ---------- Setup / migration ----------

function setup() {
  const ss = SpreadsheetApp.getActive();
  Object.keys(SHEETS).forEach(name => {
    let sh = ss.getSheetByName(name);
    if (!sh) sh = ss.insertSheet(name);
    if (sh.getLastRow() === 0) {
      sh.appendRow(SHEETS[name]);
    } else {
      const head = sh.getRange(1, 1, 1, sh.getLastColumn()).getValues()[0];
      SHEETS[name].filter(c => head.indexOf(c) < 0).forEach(c => sh.getRange(1, sh.getLastColumn() + 1).setValue(c));
    }
    sh.setFrozenRows(1);
    sh.getRange(1, 1, 1, sh.getLastColumn()).setFontWeight('bold');
  });
  const existing = table_('Settings').map(s => s.Key);
  DEFAULT_SETTINGS.forEach(r => { if (existing.indexOf(r[0]) < 0) sheet_('Settings').appendRow(r); });
  const momKeys = table_('MomProfile').map(m => m.Key);
  DEFAULT_MOM.forEach(r => { if (momKeys.indexOf(r[0]) < 0) sheet_('MomProfile').appendRow(r); });
  if (table_('Games').length === 0) SAMPLE_GAMES.forEach(r => sheet_('Games').appendRow(r));

  const props = PropertiesService.getScriptProperties();
  if (!props.getProperty('ADMIN_PASSCODE')) props.setProperty('ADMIN_PASSCODE', 'change-me-now');
  if (!props.getProperty('ROOT_FOLDER_ID')) {
    const root = DriveApp.createFolder('Wedding');
    ['Invites', 'Mom'].forEach(n => root.createFolder(n));
    props.setProperty('ROOT_FOLDER_ID', root.getId());
  }
  uploadsFolder_();
  const def = ss.getSheetByName('Sheet1');
  if (def && ss.getSheets().length > 1 && def.getLastRow() === 0) ss.deleteSheet(def);
  CacheService.getScriptCache().remove('settings');
}

// ---------- Identity & relationship ----------

function sideOf_(relationTo) {
  const r = String(relationTo || '');
  if (/^bride/i.test(r)) return 'Bride';
  if (/^groom/i.test(r)) return 'Groom';
  return r ? 'Both' : '';
}

/** Groups used to target Events / Games: all, bride, groom, bride-family, groom-friend, family, friend, + admin Groups. */
function groupsFor_(g, m) {
  const out = ['all'];
  const relTo = (m && m.RelationTo) || (g && g.RelationTo) || '';
  const side = sideOf_(relTo) || (g && g.Side) || '';
  const type = String((m && m.RelationType) || (g && g.RelationType) || '').toLowerCase();
  const sides = side === 'Both' ? ['bride', 'groom', 'both'] : side ? [String(side).toLowerCase()] : [];
  sides.forEach(s => { out.push(s); if (type) out.push(s + '-' + type); });
  if (type) out.push(type);
  if (/family/i.test(relTo)) sides.forEach(s => out.push(s + '-family'));
  String((g && g.Groups) || '').split(',').map(x => x.trim().toLowerCase()).filter(String).forEach(x => out.push(x));
  return out.filter((x, i) => out.indexOf(x) === i);
}

function matches_(targetGroups, groups) {
  const t = String(targetGroups || 'All').split(',').map(x => x.trim().toLowerCase()).filter(String);
  return !t.length || t.indexOf('all') >= 0 || t.some(x => groups.indexOf(x) >= 0);
}

function membersOf_(guestId) {
  return table_('Members').filter(m => m.GuestId === guestId);
}

/** Resolves the person using the app: guest + member (falls back to primary member). */
function identity_(d, required) {
  const g = d.guestId ? tryGuest_(d.guestId) : null;
  if (!g) {
    if (required) throw new Error('Invalid guest link');
    return { guest: null, member: null };
  }
  const members = membersOf_(g.GuestId);
  let m = d.memberId ? members.filter(x => x.MemberId === d.memberId)[0] : null;
  if (!m) m = members.filter(x => bool_(x.IsPrimary))[0] || null;
  return { guest: g, member: m };
}

function personName_(id, d) {
  if (id.member) return id.member.Name;
  if (id.guest) return id.guest.Name;
  return str_(d && d.name).slice(0, 80) || 'Guest';
}

function personSide_(id, d) {
  if (id.member && id.member.RelationTo) return sideOf_(id.member.RelationTo);
  if (id.guest) return id.guest.Side || sideOf_(id.guest.RelationTo);
  return sideOf_(d && d.relationTo);
}

// ---------- Public actions ----------

function getConfig_() {
  const s = settings_();
  const pub = {};
  Object.keys(s).forEach(k => {
    if (/^(feature|lang|couple|wedding|theme|registration|accommodation|drink|app|media|engage|points)\./.test(k)) pub[k] = s[k];
  });
  pub.closed = isClosed_();
  pub.live = !pub.closed && s['feature.live'] === 'TRUE' ? activeLive_() : null;
  pub.relationTo = RELATION_TO;
  pub.relationTypes = RELATION_TYPES;
  return pub;
}

function getHome_(d) {
  const s = settings_();
  const id = identity_(d, false);
  const events = id.guest ? visibleEvents_(id.guest, id.member) : [];
  const now = new Date();
  const next = events.filter(e => !e.locked && e.DateTime && new Date(e.DateTime) > now)
    .sort((a, b) => new Date(a.DateTime) - new Date(b.DateTime))[0] || null;
  const approved = s['feature.media'] === 'TRUE' ? approvedMedia_() : [];
  const en = String(s['engage.promptsEn'] || '').split('|').filter(String);
  const ne = String(s['engage.promptsNe'] || '').split('|');
  const day = Math.floor(now.getTime() / 86400000);
  const lb = leaderboard_();
  let myPoints = 0;
  if (id.guest) {
    const key = id.guest.GuestId + '|' + (id.member ? id.member.MemberId : '');
    const me = lb.all.filter(x => x.key === key)[0];
    myPoints = me ? me.points : 0;
  }
  const pub = publicLeaderboard_(lb);
  return {
    nextEvent: next,
    upcomingCount: events.filter(e => !e.locked).length,
    lockedCount: events.filter(e => e.locked).length,
    media: approved.slice(0, 9).map(publicMedia_),
    mediaCount: approved.length,
    diyaCount: s['feature.memorial'] === 'TRUE' ? table_('MomDiyas').length : 0,
    teams: pub.teams,
    top: pub.top.slice(0, 5),
    myPoints: myPoints,
    prompt: en.length ? { en: en[day % en.length], ne: ne[day % en.length] || '' } : null,
    live: s['feature.live'] === 'TRUE' ? activeLive_() : null
  };
}

function getGuest_(d) {
  const id = identity_(d, true);
  const g = id.guest;
  markOpened_(g);
  const s = settings_();
  const accommodationOn = s['feature.accommodation'] === 'TRUE' && s['accommodation.open'] === 'TRUE' && bool_(g.AccommodationEligible);
  const rsvps = table_('EventRsvp').filter(r => r.GuestId === g.GuestId);
  const request = table_('Accommodation').filter(r => r.GuestId === g.GuestId)[0] || null;
  return {
    guest: publicGuest_(g),
    members: membersOf_(g.GuestId).map(publicMember_),
    memberId: id.member ? id.member.MemberId : '',
    groups: groupsFor_(g, id.member),
    events: visibleEvents_(g, id.member),
    rsvps: rsvps,
    accommodation: accommodationOn ? { eligible: true, request: request } : { eligible: false }
  };
}

function register_(d) {
  const s = settings_();
  if (s['feature.registration'] !== 'TRUE' || s['registration.open'] !== 'TRUE') throw new Error('Registration closed');
  const g = findGuest_(d.guestId);
  const f = d.form || {};
  ['Name', 'Phone', 'DOB', 'RelationTo', 'RelationType', 'Relation'].forEach(k => { if (!f[k]) throw new Error('Missing ' + k); });
  if (RELATION_TO.indexOf(f.RelationTo) < 0) throw new Error('Invalid relation');
  const admit = Number(g.AdmitCount) || 1;
  const now = now_();
  const attending = f.Status === 'Attending' || f.Status === 'Maybe';

  const incoming = (d.members || []).filter(m => str_(m.Name)).slice(0, 20);
  incoming.forEach(m => {
    if (RELATION_TO.indexOf(m.RelationTo) < 0) throw new Error('Please choose relation for ' + m.Name);
  });
  const isGoing = m => m.Attending !== false && m.Attending !== 'FALSE';
  const attendingCount = attending ? 1 + incoming.filter(isGoing).length : 0;
  if (attendingCount > admit) throw new Error('Maximum ' + admit + ' people for this invitation');

  updateBy_('Guests', 'GuestId', g.GuestId, {
    Name: str_(f.Name), NameNe: str_(f.NameNe), Phone: str_(f.Phone), Email: str_(f.Email),
    DOB: str_(f.DOB), Age: ageFrom_(f.DOB), NonDrinker: bool_(f.NonDrinker) ? 'TRUE' : 'FALSE',
    RelationTo: str_(f.RelationTo), RelationType: str_(f.RelationType), Side: sideOf_(f.RelationTo),
    Relation: str_(f.Relation), RelationNe: str_(f.RelationNe),
    AttendingCount: attendingCount, Status: str_(f.Status) || 'Pending', Meal: str_(f.Meal), Allergies: str_(f.Allergies),
    Arrival: str_(f.Arrival), Departure: str_(f.Departure),
    Registered: 'TRUE', RegisteredAt: g.RegisteredAt || now
  });

  const existing = membersOf_(g.GuestId);
  let primary = existing.filter(m => bool_(m.IsPrimary))[0];
  const primaryRow = {
    GuestId: g.GuestId, Name: str_(f.Name), NameNe: str_(f.NameNe), RelationTo: str_(f.RelationTo),
    RelationType: str_(f.RelationType), Relation: str_(f.Relation), RelationNe: str_(f.RelationNe), DOB: str_(f.DOB),
    NonDrinker: bool_(f.NonDrinker) ? 'TRUE' : 'FALSE', Attending: attending ? 'TRUE' : 'FALSE', IsPrimary: 'TRUE'
  };
  if (primary) updateBy_('Members', 'MemberId', primary.MemberId, primaryRow);
  else { primary = Object.assign({ MemberId: id_(), CreatedAt: now }, primaryRow); appendObj_('Members', primary); }

  const keep = [primary.MemberId];
  incoming.forEach(m => {
    const own = m.MemberId && existing.some(x => x.MemberId === m.MemberId && !bool_(x.IsPrimary));
    const row = {
      GuestId: g.GuestId, Name: str_(m.Name).slice(0, 80), NameNe: str_(m.NameNe).slice(0, 80),
      RelationTo: str_(m.RelationTo), RelationType: str_(m.RelationType), Relation: str_(m.Relation).slice(0, 60),
      RelationNe: str_(m.RelationNe).slice(0, 60), DOB: str_(m.DOB), NonDrinker: bool_(m.NonDrinker) ? 'TRUE' : 'FALSE',
      Attending: attending && isGoing(m) ? 'TRUE' : 'FALSE', IsPrimary: 'FALSE'
    };
    if (own) { updateBy_('Members', 'MemberId', m.MemberId, row); keep.push(m.MemberId); }
    else { const nid = id_(); appendObj_('Members', Object.assign({ MemberId: nid, CreatedAt: now }, row)); keep.push(nid); }
  });
  existing.filter(x => keep.indexOf(x.MemberId) < 0).forEach(x => deleteBy_('Members', 'MemberId', x.MemberId));

  const fresh = tryGuest_(g.GuestId);
  const allowed = visibleEvents_(fresh, null).filter(e => !e.locked).map(e => e.EventId);
  (d.events || []).forEach(ev => {
    if (allowed.indexOf(ev.EventId) < 0) return;
    upsertComposite_('EventRsvp', ['GuestId', 'EventId'], g.GuestId + '|' + ev.EventId, {
      GuestId: g.GuestId, EventId: ev.EventId, Response: str_(ev.Response),
      Count: Math.max(0, Math.min(attendingCount, Number(ev.Count) || 0)), UpdatedAt: now
    });
  });

  if (f.Email) {
    try {
      MailApp.sendEmail(f.Email, 'Registration confirmed / दर्ता पुष्टि भयो',
        'Namaste ' + f.Name + ',\n\nThank you for registering. Your family guest passes are ready in the wedding app.\n\nधन्यवाद');
    } catch (e) { /* quota or invalid address */ }
  }
  log_('register', g.GuestId);
  return { members: membersOf_(g.GuestId).map(publicMember_), primaryMemberId: primary.MemberId };
}

function requestAccommodation_(d) {
  const s = settings_();
  const g = findGuest_(d.guestId);
  if (s['feature.accommodation'] !== 'TRUE' || s['accommodation.open'] !== 'TRUE' || !bool_(g.AccommodationEligible)) {
    throw new Error('Accommodation not available');
  }
  const existing = table_('Accommodation').filter(r => r.GuestId === g.GuestId)[0];
  const row = {
    RequestId: existing ? existing.RequestId : id_(), GuestId: g.GuestId,
    Nights: Number(d.Nights) || 1, People: Math.min(Number(g.AdmitCount) || 1, Number(d.People) || 1),
    Needs: str_(d.Needs), Status: existing && existing.Status === 'Assigned' ? 'Assigned' : 'Requested',
    RoomId: existing ? existing.RoomId : '', UpdatedAt: now_()
  };
  upsert_('Accommodation', 'RequestId', row.RequestId, row);
  return row;
}

function getPass_(d) {
  const g = withDerived_(findGuest_(d.guestId));
  const req = table_('Accommodation').filter(r => r.GuestId === g.GuestId)[0];
  const room = req && req.RoomId ? table_('Rooms').filter(r => r.RoomId === req.RoomId)[0] : null;
  const showBand = settings_()['feature.drinkBand'] === 'TRUE';
  return {
    guestId: g.GuestId, name: g.Name, nameNe: g.NameNe, side: g.Side, relation: g.Relation, relationNe: g.RelationNe,
    table: g.Table, status: g.Status, registered: bool_(g.Registered), attendingCount: g.AttendingCount,
    band: showBand ? g.Band : null,
    members: membersOf_(g.GuestId).map(m => {
      const x = withDerivedMember_(m);
      return {
        memberId: x.MemberId, name: x.Name, nameNe: x.NameNe, relationTo: x.RelationTo, relation: x.Relation,
        relationNe: x.RelationNe, side: sideOf_(x.RelationTo), attending: bool_(x.Attending),
        isPrimary: bool_(x.IsPrimary), band: showBand ? x.Band : null
      };
    }),
    room: room ? { name: room.Name, location: room.Location, checkIn: room.CheckIn, checkOut: room.CheckOut } : null,
    accommodationStatus: req ? req.Status : null
  };
}

function getLive_() { return activeLive_(); }

