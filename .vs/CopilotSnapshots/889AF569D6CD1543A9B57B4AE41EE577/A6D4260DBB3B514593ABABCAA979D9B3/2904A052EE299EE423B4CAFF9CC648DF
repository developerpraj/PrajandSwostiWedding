// ---------- Entry points ----------

function doGet() {
  return json_({ ok: true, message: 'Wedding API running' });
}

function doPost(e) {
  try {
    const req = JSON.parse(e.postData.contents || '{}');
    const action = req.action || '';
    const data = req.data || {};
    if (action.indexOf('admin.') === 0) {
      if (!isAdmin_(req.adminKey)) return json_({ ok: false, error: 'unauthorized' });
      const fn = ADMIN_ACTIONS[action];
      if (!fn) return json_({ ok: false, error: 'unknown action' });
      return json_({ ok: true, data: fn(data) });
    }
    const fn = PUBLIC_ACTIONS[action];
    if (!fn) return json_({ ok: false, error: 'unknown action' });
    if (action !== 'getConfig' && isClosed_()) {
      const memorialAction = ['getMemorial', 'lightDiya', 'submitMemory'].indexOf(action) >= 0;
      if (!(memorialAction && settings_()['app.keepMemorialAfterEnd'] === 'TRUE')) return json_({ ok: false, error: 'closed' });
    }
    return json_({ ok: true, data: fn(data) });
  } catch (err) {
    return json_({ ok: false, error: String(err && err.message || err) });
  }
}

