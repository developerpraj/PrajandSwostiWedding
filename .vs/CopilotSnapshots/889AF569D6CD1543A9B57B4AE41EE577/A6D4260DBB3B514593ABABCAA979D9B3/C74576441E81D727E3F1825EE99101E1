<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="robots" content="noindex" />
  <title>Admin · Wedding</title>
  <link rel="stylesheet" href="../css/base.css" />
</head>
<body>
  <header class="topbar">
    <div class="brand">🪔 Admin</div>
    <nav>
      <a href="../index.html">Site</a>
      <a href="nametags.html">Name Tags &amp; Bands</a>
      <a href="#" id="logout" hidden>Logout</a>
    </nav>
    <div class="lang-switch" id="langSwitch"></div>
  </header>

  <main style="max-width:1200px">
    <div id="msg" class="msg" hidden></div>

    <form id="loginForm" class="card" style="max-width:400px;margin:auto">
      <h2>Admin Login</h2>
      <label>Passcode</label>
      <input type="password" name="key" required autocomplete="current-password" />
      <p><button class="btn">Login</button></p>
    </form>

    <div id="app" hidden>
      <div class="tabs" id="tabs">
        <button data-tab="dash" class="active">📊 Live Dashboard</button>
        <button data-tab="guests">👥 Guests</button>
        <button data-tab="acc">🏨 Accommodation</button>
        <button data-tab="live">🔴 Live Update</button>
        <button data-tab="memorial">🪔 Memorial</button>
        <button data-tab="settings">⚙️ Settings</button>
      </div>

      <!-- Dashboard -->
      <section class="panel active" id="panel-dash">
        <p class="muted">Auto-refreshes every 15 seconds · Last update: <span id="updatedAt">–</span></p>
        <div class="grid" id="stats"></div>
        <div class="grid">
          <div class="card"><h3>Per event</h3><div class="table-wrap"><table id="perEvent"></table></div></div>
          <div class="card"><h3>Meals (attending people)</h3><table id="meals"></table></div>
          <div class="card"><h3>Drinking bands</h3><table id="bands"></table></div>
          <div class="card"><h3>Accommodation</h3><table id="accStats"></table></div>
        </div>
        <p><button class="btn ghost sm" id="exportCsv">⬇️ Export guests CSV</button></p>
      </section>

      <!-- Guests -->
      <section class="panel" id="panel-guests">
        <form class="card" id="guestForm">
          <h3>Add / edit guest</h3>
          <input type="hidden" name="GuestId" />
          <div class="grid">
            <div><label>Name</label><input name="Name" required /></div>
            <div><label>Name (Nepali)</label><input name="NameNe" /></div>
            <div><label>Family</label><input name="Family" /></div>
            <div><label>Side</label><select name="Side"><option>Bride</option><option>Groom</option><option>Both</option></select></div>
            <div><label>Relation</label><input name="Relation" /></div>
            <div><label>Relation (Nepali)</label><input name="RelationNe" /></div>
            <div><label>Groups (comma separated)</label><input name="Groups" placeholder="Family, VIP" /></div>
            <div><label>Phone</label><input name="Phone" /></div>
            <div><label>Email</label><input name="Email" type="email" /></div>
            <div><label>Admit count</label><input name="AdmitCount" type="number" min="1" value="1" /></div>
            <div><label>Table</label><input name="Table" /></div>
            <div><label class="check"><input type="checkbox" name="AccommodationEligible" /> Offer accommodation</label></div>
          </div>
          <p><button class="btn">Save guest</button> <button type="reset" class="btn ghost">Clear</button></p>
        </form>

        <div class="card">
          <h3>Import CSV</h3>
          <p class="muted">Header row: Name,NameNe,Family,Side,Relation,RelationNe,Groups,Phone,Email,AdmitCount,AccommodationEligible</p>
          <input type="file" id="csvFile" accept=".csv" />
        </div>

        <div class="card">
          <input id="guestSearch" placeholder="Search guests…" />
          <div class="table-wrap"><table id="guestTable"></table></div>
        </div>
      </section>

      <!-- Accommodation -->
      <section class="panel" id="panel-acc">
        <form class="card" id="roomForm">
          <h3>Add room / hotel</h3>
          <input type="hidden" name="RoomId" />
          <div class="grid">
            <div><label>Name</label><input name="Name" required /></div>
            <div><label>Location</label><input name="Location" /></div>
            <div><label>Capacity (people)</label><input name="Capacity" type="number" min="1" value="2" /></div>
            <div><label>Check-in</label><input name="CheckIn" type="date" /></div>
            <div><label>Check-out</label><input name="CheckOut" type="date" /></div>
            <div><label>Notes</label><input name="Notes" /></div>
          </div>
          <p><button class="btn">Save room</button></p>
        </form>
        <div class="card"><h3>Rooms</h3><div class="table-wrap"><table id="roomTable"></table></div></div>
        <div class="card"><h3>Requests</h3><div class="table-wrap"><table id="reqTable"></table></div></div>
      </section>

      <!-- Live -->
      <section class="panel" id="panel-live">
        <form class="card" id="liveForm">
          <h3>What's happening now</h3>
          <label>Message (English)</label><input name="messageEn" />
          <label>Message (नेपाली)</label><input name="messageNe" />
          <p><button class="btn">Post</button> <button type="button" class="btn ghost" id="clearLive">Clear banner</button></p>
        </form>
      </section>

      <!-- Memorial -->
      <section class="panel" id="panel-memorial">
        <form class="card" id="momForm">
          <h3>Mom's profile</h3>
          <div class="grid">
            <div><label>Name (English)</label><input name="nameEn" /></div>
            <div><label>Name (नेपाली)</label><input name="nameNe" /></div>
            <div><label>Years (e.g., 1965 – 2022)</label><input name="years" /></div>
            <div><label>Photo URL</label><input name="photoUrl" /></div>
          </div>
          <label>Dedication (English)</label><textarea name="dedicationEn"></textarea>
          <label>Dedication (नेपाली)</label><textarea name="dedicationNe"></textarea>
          <label>Her quote (English)</label><input name="quoteEn" />
          <label>Her quote (नेपाली)</label><input name="quoteNe" />
          <p><button class="btn">Save profile</button></p>
        </form>
        <div class="card"><h3>Memories (moderation)</h3><div class="table-wrap"><table id="memTable"></table></div></div>
      </section>

      <!-- Settings -->
      <section class="panel" id="panel-settings">
        <div class="card"><div class="table-wrap" style="max-height:none"><table id="settingsTable"></table></div></div>
      </section>
    </div>
  </main>

  <script src="../js/config.js"></script>
  <script src="../js/api.js"></script>
  <script src="../js/i18n.js"></script>
  <script src="../js/app.js"></script>
  <script src="../js/admin.js"></script>
</body>
</html>
