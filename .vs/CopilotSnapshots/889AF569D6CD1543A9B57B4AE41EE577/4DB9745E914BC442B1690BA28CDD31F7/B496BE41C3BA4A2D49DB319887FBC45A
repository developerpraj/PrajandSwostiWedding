function activity_(kind, action, data, client) {
  try {
    if (kind === 'guest' && settings_()['log.activity'] === 'FALSE') return;
    const c = client || {};
    const clean = {};
    Object.keys(data || {}).forEach(k => {
      if (SECRET_KEYS_.test(k)) { clean[k] = '***'; return; }
      const v = data[k];
      clean[k] = typeof v === 'object' ? JSON.stringify(v).slice(0, 2000) : String(v).slice(0, 500);
    });
    const g = data && data.guestId ? tryGuest_(data.guestId) : null;
    logBook_(kind).getSheets()[0].appendRow([
      now_(), action, str_(data && data.guestId), str_(data && data.memberId), g ? g.Name : str_(data && data.name),
      str_(c.page).slice(0, 80), str_(c.ua).slice(0, 160), str_(c.sid).slice(0, 40), JSON.stringify(clean).slice(0, 45000)
    ]);
  } catch (e) { /* logging must never break the app */ }
}

// ---------- People search + duplicate names ----------

function normName_(n) { return str_(n).toLowerCase().replace(/[^a-z0-9\u0900-\u097f]+/g, ' ').trim(); }

function nameOwner_(name, guestId, ownMemberIds) {
  const n = normName_(name);
  if (!n) return null;
  const m = table_('Members').filter(x => normName_(x.Name) === n && x.GuestId !== guestId && !/^removed:/.test(x.GuestId) && (ownMemberIds || []).indexOf(x.MemberId) < 0)[0];
  if (m) return m;
  return table_('Guests').filter(x => x.GuestId !== guestId && bool_(x.Registered) && normName_(x.Name) === n)[0] || null;
}

/** Typeahead: returns names only (no phone/DOB), so guests can pick relatives and avoid duplicates. */
function searchPeople_(d) {
  identity_(d, true);
  const q = normName_(d.q);
  if (q.length < 2) return [];
  const out = [];
  table_('Members').forEach(m => {
    if (/^removed:/.test(m.GuestId)) return;
    if (normName_(m.Name).indexOf(q) >= 0 || normName_(m.NameNe).indexOf(q) >= 0) {
      out.push({ name: m.Name, nameNe: m.NameNe, relationTo: m.RelationTo, relation: m.Relation, mine: m.GuestId === d.guestId, memberId: m.GuestId === d.guestId ? m.MemberId : '' });
    }
  });
  table_('Guests').forEach(g => {
    if (normName_(g.Name).indexOf(q) >= 0 && !out.some(o => normName_(o.name) === normName_(g.Name))) {
      out.push({ name: g.Name, nameNe: g.NameNe, relationTo: g.RelationTo, relation: g.Relation, mine: g.GuestId === d.guestId, invited: true });
    }
  });
  return out.slice(0, 8);
}

function checkName_(d) {
  const id = identity_(d, true);
  const dup = nameOwner_(d.name, id.guest.GuestId, membersOf_(id.guest.GuestId).map(m => m.MemberId));
  return { duplicate: !!dup };
}

