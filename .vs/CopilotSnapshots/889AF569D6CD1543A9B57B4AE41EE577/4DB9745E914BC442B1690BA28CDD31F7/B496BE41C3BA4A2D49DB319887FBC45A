// ---------- Media (photos & videos to Google Drive) ----------

/**
 * Creates a Google Drive resumable upload session owned by the script owner.
 * The browser PUTs the file bytes straight to Drive (no Apps Script size limit),
 * then calls finishUpload with the returned Drive file id.
 */
function startUpload_(d) {
  const s = settings_();
  if (s['feature.media'] !== 'TRUE') throw new Error('Sharing is off');
  const id = identity_(d, false);
  if (!id.guest && !(s['media.allowVisitors'] === 'TRUE' && str_(d.name))) throw new Error('Please tell us your name');
  const mime = str_(d.mimeType).toLowerCase();
  if (!/^(image|video)\//.test(mime)) throw new Error('Only photos and videos');
  const size = Number(d.size) || 0;
  const max = (Number(s['media.maxSizeMB']) || 500) * 1024 * 1024;
  if (!size || size > max) throw new Error('File too large (max ' + s['media.maxSizeMB'] + ' MB)');

  const name = personName_(id, d);
  const fileName = (Utilities.formatDate(new Date(), 'UTC', 'yyyyMMdd-HHmmss') + '_' + name + '_' + str_(d.fileName))
    .replace(/[\\/:*?"<>|]/g, '_').slice(0, 150);
  const headers = {
    Authorization: 'Bearer ' + ScriptApp.getOAuthToken(),
    'X-Upload-Content-Type': mime,
    'X-Upload-Content-Length': String(size)
  };
  if (d.origin) headers.Origin = str_(d.origin);
  const res = UrlFetchApp.fetch('https://www.googleapis.com/upload/drive/v3/files?uploadType=resumable&fields=id', {
    method: 'post',
    contentType: 'application/json; charset=UTF-8',
    headers: headers,
    payload: JSON.stringify({ name: fileName, mimeType: mime, parents: [uploadsFolder_().getId()] }),
    muteHttpExceptions: true
  });
  const h = res.getAllHeaders();
  const url = h.Location || h.location;
  if (res.getResponseCode() >= 300 || !url) throw new Error('Upload could not start');

  const token = Utilities.getUuid();
  CacheService.getScriptCache().put('up_' + token, JSON.stringify({
    guestId: id.guest ? id.guest.GuestId : '', memberId: id.member ? id.member.MemberId : '',
    name: name, side: personSide_(id, d), eventId: str_(d.eventId).slice(0, 40), mime: mime, fileName: str_(d.fileName).slice(0, 120)
  }), 21600);
  return { uploadUrl: url, token: token };
}

function finishUpload_(d) {
  const raw = CacheService.getScriptCache().get('up_' + str_(d.token));
  if (!raw) throw new Error('Upload expired');
  const p = JSON.parse(raw);
  const file = DriveApp.getFileById(str_(d.fileId));
  const folderId = uploadsFolder_().getId();
  let inFolder = false;
  const parents = file.getParents();
  while (parents.hasNext()) if (parents.next().getId() === folderId) inFolder = true;
  if (!inFolder) throw new Error('Invalid file');
  if (table_('Media').some(m => m.DriveFileId === file.getId())) throw new Error('Already saved');
  // View-only link: everyone can see & download; nobody else can edit or delete.
  file.setSharing(DriveApp.Access.ANYONE_WITH_LINK, DriveApp.Permission.VIEW);
  const moderated = settings_()['media.moderation'] === 'TRUE';
  const row = {
    MediaId: id_(), GuestId: p.guestId, MemberId: p.memberId, Name: p.name, Side: p.side, EventId: p.eventId,
    DriveFileId: file.getId(), Type: /^video/.test(p.mime) ? 'video' : 'photo', MimeType: p.mime, FileName: p.fileName,
    Status: moderated ? 'Pending' : 'Approved', Timestamp: now_()
  };
  appendObj_('Media', row);
  CacheService.getScriptCache().remove('up_' + str_(d.token));
  return { pending: moderated, media: publicMedia_(row) };
}

function getGallery_(d) {
  if (settings_()['feature.media'] !== 'TRUE') throw new Error('Sharing is off');
  let list = approvedMedia_();
  if (d.eventId) list = list.filter(m => m.EventId === d.eventId);
  if (d.side) list = list.filter(m => m.Side === d.side);
  if (d.mine && d.guestId) list = list.filter(m => m.GuestId === d.guestId);
  return list.slice(0, Math.min(Number(d.limit) || 300, 500)).map(m => {
    const x = publicMedia_(m);
    x.mine = !!d.guestId && m.GuestId === d.guestId;
    return x;
  });
}

function deleteMedia_(d) {
  const g = findGuest_(d.guestId);
  const m = table_('Media').filter(x => x.MediaId === d.mediaId)[0];
  if (!m || m.GuestId !== g.GuestId) throw new Error('You can only remove your own uploads');
  // Guest always sees "deleted". With data.softDelete ON (admin only) the file and row are kept.
  updateBy_('Media', 'MediaId', m.MediaId, { Status: 'Deleted' });
  if (!softDelete_()) { try { DriveApp.getFileById(m.DriveFileId).setTrashed(true); } catch (e) { /* already gone */ } }
  return true;
}

function approvedMedia_() {
  return table_('Media').filter(m => m.Status === 'Approved').reverse();
}

function publicMedia_(m) {
  return { id: m.MediaId, fileId: m.DriveFileId, type: m.Type, name: m.Name, side: m.Side, eventId: m.EventId, at: m.Timestamp };
}

function uploadsFolder_() {
  const props = PropertiesService.getScriptProperties();
  const id = props.getProperty('UPLOADS_FOLDER_ID');
  if (id) { try { return DriveApp.getFolderById(id); } catch (e) { /* recreate */ } }
  const root = DriveApp.getFolderById(props.getProperty('ROOT_FOLDER_ID'));
  const it = root.getFoldersByName('Uploads');
  const folder = it.hasNext() ? it.next() : root.createFolder('Uploads');
  props.setProperty('UPLOADS_FOLDER_ID', folder.getId());
  return folder;
}

// ---------- Games (targeted by relationship) ----------

function getGames_(d) {
  if (settings_()['feature.games'] !== 'TRUE') throw new Error('Games are off');
  const id = identity_(d, true);
  const groups = groupsFor_(id.guest, id.member);
  const memberId = id.member ? id.member.MemberId : '';
  const answered = {};
  table_('Scores').filter(s => s.GuestId === id.guest.GuestId && s.MemberId === memberId).forEach(s => answered[s.GameId] = s);
  const proofs = {};
  table_('Proofs').filter(p => p.GuestId === id.guest.GuestId && p.MemberId === memberId && p.Status !== 'Rejected').forEach(p => proofs[p.GameId] = p.Status);
  const games = table_('Games')
    .filter(g => bool_(g.Active) && matches_(g.Groups, groups))
    .sort((a, b) => (Number(a.Order) || 0) - (Number(b.Order) || 0))
    .map(g => {
      const a = answered[g.GameId];
      return {
        gameId: g.GameId, type: g.Type, titleEn: g.TitleEn, titleNe: g.TitleNe, questionEn: g.QuestionEn, questionNe: g.QuestionNe,
        optionsEn: String(g.OptionsEn || '').split('|'), optionsNe: String(g.OptionsNe || '').split('|'),
        points: Number(g.Points) || 0, answered: !!a || !!proofs[g.GameId], proof: proofs[g.GameId] || null, correct: a ? bool_(a.Correct) : null, answer: a ? Number(g.Answer) : null
      };
    });
  return { games: games, groups: groups, leaderboard: publicLeaderboard_(leaderboard_()) };
}

function submitAnswer_(d) {
  const id = identity_(d, true);
  const lock = LockService.getScriptLock();
  lock.waitLock(10000);
  try {
    const memberId = id.member ? id.member.MemberId : '';
    const game = table_('Games').filter(g => g.GameId === d.gameId && bool_(g.Active))[0];
    if (!game || !matches_(game.Groups, groupsFor_(id.guest, id.member))) throw new Error('Game not available');
    if (table_('Scores').some(s => s.GuestId === id.guest.GuestId && s.MemberId === memberId && s.GameId === game.GameId)) {
      throw new Error('Already answered');
    }
    const correct = String(Number(d.choice)) === String(Number(game.Answer));
    const points = correct ? Number(game.Points) || 0 : 0;
    appendObj_('Scores', {
      GuestId: id.guest.GuestId, MemberId: memberId, Name: personName_(id), Side: personSide_(id),
      GameId: game.GameId, Correct: correct ? 'TRUE' : 'FALSE', Points: points, Timestamp: now_()
    });
    return { correct: correct, answer: Number(game.Answer), points: points };
  } finally {
    lock.releaseLock();
  }
}

/** Points: game points + shared uploads. Teams: Bride side vs Groom side. */
function leaderboard_() {
  const perUpload = Number(settings_()['points.upload']) || 0;
  const people = {};
  const add = (key, name, side, pts) => {
    if (!people[key]) people[key] = { key: key, name: name, side: side, points: 0 };
    people[key].points += pts;
  };
  table_('Scores').forEach(s => add(s.GuestId + '|' + s.MemberId, s.Name, s.Side, Number(s.Points) || 0));
  approvedMedia_().forEach(m => add(m.GuestId ? m.GuestId + '|' + m.MemberId : 'v|' + m.Name, m.Name, m.Side, perUpload));
  table_('Proofs').filter(p => p.Status === 'Approved').forEach(p => add(p.GuestId + '|' + p.MemberId, p.Name, p.Side, Number(p.Points) || 0));
  const all = Object.keys(people).map(k => people[k]).sort((a, b) => b.points - a.points);
  const teams = { Bride: 0, Groom: 0 };
  all.forEach(p => { if (teams[p.side] !== undefined) teams[p.side] += p.points; });
  return { teams: teams, all: all };
}

function publicLeaderboard_(lb) {
  return { teams: lb.teams, top: lb.all.slice(0, 10).map(p => ({ name: p.name, side: p.side, points: p.points })) };
}

