// ---------- Screenshot proofs for games/challenges ----------

/** Called after a screenshot was uploaded via startUpload/finishUpload. Links it to a game for review/points. */
function submitProof_(d) {
  const id = identity_(d, true);
  const media = table_('Media').filter(m => m.MediaId === d.mediaId && m.GuestId === id.guest.GuestId)[0];
  if (!media) throw new Error('Upload the screenshot first');
  const game = table_('Games').filter(g => g.GameId === d.gameId && bool_(g.Active))[0];
  if (!game) throw new Error('Game not available');
  const memberId = id.member ? id.member.MemberId : '';
  if (table_('Proofs').some(p => p.GuestId === id.guest.GuestId && p.MemberId === memberId && p.GameId === game.GameId && p.Status !== 'Rejected')) throw new Error('Already submitted');
  appendObj_('Proofs', { ProofId: id_(), GuestId: id.guest.GuestId, MemberId: memberId, Name: personName_(id), Side: personSide_(id),
    GameId: game.GameId, DriveFileId: media.DriveFileId, Status: 'Pending', Points: Number(game.Points) || 0, Timestamp: now_(), Hidden: '' });
  return { pending: true };
}