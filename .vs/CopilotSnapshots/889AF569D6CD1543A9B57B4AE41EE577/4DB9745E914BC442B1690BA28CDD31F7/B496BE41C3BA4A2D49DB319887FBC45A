function submitMemory_(d) {
  const g = d.guestId ? tryGuest_(d.guestId) : null;
  const text = str_(d.text).slice(0, 3000);
  if (!text) throw new Error('Empty memory');
  const moderated = settings_()['memorial.moderation'] === 'TRUE';
  sheet_('MomMemories').appendRow([id_(), g ? g.GuestId : '', str_(d.name || (g && g.Name) || 'Guest').slice(0, 80),
    str_(d.relation).slice(0, 80), 'text', text, '', moderated ? 'Pending' : 'Approved',
    bool_(d.isPrivate) ? 'TRUE' : 'FALSE', now_()]);
  return { pending: moderated };
}

// ---------- Admin actions ----------

function adminStats_() {
  const guests = table_('Guests').map(withDerived_);
  const members = table_('Members').map(withDerivedMember_);
  const events = table_('Events');
  const rsvps = table_('EventRsvp');
  const acc = table_('Accommodation');
  const rooms = table_('Rooms');
  const sum = (arr, f) => arr.reduce((t, x) => t + (Number(f(x)) || 0), 0);

  const byStatus = s => guests.filter(g => g.Status === s);
  const attending = byStatus('Attending');
  const meals = {};
  attending.forEach(g => { const m = g.Meal || 'Unspecified'; meals[m] = (meals[m] || 0) + (Number(g.AttendingCount) || 0); });

  const perEvent = events.map(e => {
    const r = rsvps.filter(x => x.EventId === e.EventId);
    return {
      eventId: e.EventId, nameEn: e.NameEn, nameNe: e.NameNe, dateTime: e.DateTime,
      yes: sum(r.filter(x => x.Response === 'Yes'), x => x.Count),
      maybe: sum(r.filter(x => x.Response === 'Maybe'), x => x.Count),
      no: r.filter(x => x.Response === 'No').length
    };
  });

  const going = members.filter(m => bool_(m.Attending));
  const bands = { green: 0, yellow: 0, red: 0, blue: 0 };
  going.forEach(m => { if (bands[m.Band] !== undefined) bands[m.Band]++; });
  const relations = {};
  going.forEach(m => { const k = m.RelationTo || 'Unspecified'; relations[k] = (relations[k] || 0) + 1; });
  const media = table_('Media');
  const players = {};
  table_('Scores').forEach(s => players[s.GuestId + '|' + s.MemberId] = 1);

  return {
