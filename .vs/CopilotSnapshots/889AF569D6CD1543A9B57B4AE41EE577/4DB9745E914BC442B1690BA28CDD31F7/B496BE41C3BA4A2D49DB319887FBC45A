// ---------- Setup / migration ----------

function setup() {
  const ss = SpreadsheetApp.getActive();
  Object.keys(SHEETS).forEach(name => {
    let sh = ss.getSheetByName(name);
    if (!sh) sh = ss.insertSheet(name);
    if (sh.getLastRow() === 0) {
      sh.appendRow(SHEETS[name]);
    } else {
      const head = sh.getRange(1, 1, 1, sh.getLastColumn()).getValues()[0];
      SHEETS[name].filter(c => head.indexOf(c) < 0).forEach(c => sh.getRange(1, sh.getLastColumn() + 1).setValue(c));
    }
    sh.setFrozenRows(1);
    sh.getRange(1, 1, 1, sh.getLastColumn()).setFontWeight('bold');
  });
  const existing = table_('Settings').map(s => s.Key);
  DEFAULT_SETTINGS.forEach(r => { if (existing.indexOf(r[0]) < 0) sheet_('Settings').appendRow(r); });
  const momKeys = table_('MomProfile').map(m => m.Key);
  DEFAULT_MOM.forEach(r => { if (momKeys.indexOf(r[0]) < 0) sheet_('MomProfile').appendRow(r); });
  if (table_('Games').length === 0) SAMPLE_GAMES.forEach(r => sheet_('Games').appendRow(r));
  if (table_('Traditions').length === 0) SAMPLE_TRADITIONS.forEach((r, i) => sheet_('Traditions').appendRow(['T' + (i + 1)].concat(r)));
  if (table_('Scenarios').length === 0) SAMPLE_SCENARIOS.forEach((r, i) => sheet_('Scenarios').appendRow(['S' + (i + 1)].concat(r)));

  const props = PropertiesService.getScriptProperties();
  if (!props.getProperty('ADMIN_PASSCODE')) props.setProperty('ADMIN_PASSCODE', 'change-me-now');
  if (!props.getProperty('ROOT_FOLDER_ID')) {
    const root = DriveApp.createFolder('Wedding');
    ['Invites', 'Mom'].forEach(n => root.createFolder(n));
    props.setProperty('ROOT_FOLDER_ID', root.getId());
  }
  uploadsFolder_();
  const def = ss.getSheetByName('Sheet1');
  if (def && ss.getSheets().length > 1 && def.getLastRow() === 0) ss.deleteSheet(def);
  CacheService.getScriptCache().remove('settings');
}

// ---------- Identity & relationship ----------

function sideOf_(relationTo) {
  const r = String(relationTo || '');
  if (/^bride/i.test(r)) return 'Bride';
  if (/^groom/i.test(r)) return 'Groom';
  return r ? 'Both' : '';
}

/** Groups used to target Events / Games: all, bride, groom, bride-family, groom-friend, family, friend, + admin Groups. */
function groupsFor_(g, m) {
  const out = ['all'];
  const relTo = (m && m.RelationTo) || (g && g.RelationTo) || '';
  const side = sideOf_(relTo) || (g && g.Side) || '';
  const type = String((m && m.RelationType) || (g && g.RelationType) || '').toLowerCase();
  const sides = side === 'Both' ? ['bride', 'groom', 'both'] : side ? [String(side).toLowerCase()] : [];
  sides.forEach(s => { out.push(s); if (type) out.push(s + '-' + type); });
  if (type) out.push(type);
  if (/family/i.test(relTo)) sides.forEach(s => out.push(s + '-family'));
  String((g && g.Groups) || '').split(',').map(x => x.trim().toLowerCase()).filter(String).forEach(x => out.push(x));
  return out.filter((x, i) => out.indexOf(x) === i);
}

function matches_(targetGroups, groups) {
  const t = String(targetGroups || 'All').split(',').map(x => x.trim().toLowerCase()).filter(String);
  return !t.length || t.indexOf('all') >= 0 || t.some(x => groups.indexOf(x) >= 0);
}

function membersOf_(guestId) {
  return table_('Members').filter(m => m.GuestId === guestId);
}

/** Resolves the person using the app: guest + member (falls back to primary member). */
function identity_(d, required) {
  const g = d.guestId ? tryGuest_(d.guestId) : null;
  if (!g) {
    if (required) throw new Error('Invalid guest link');
    return { guest: null, member: null };
  }
  const members = membersOf_(g.GuestId);
  let m = d.memberId ? members.filter(x => x.MemberId === d.memberId)[0] : null;
  if (!m) m = members.filter(x => bool_(x.IsPrimary))[0] || null;
  return { guest: g, member: m };
}

function personName_(id, d) {
  if (id.member) return id.member.Name;
  if (id.guest) return id.guest.Name;
  return str_(d && d.name).slice(0, 80) || 'Guest';
}

function personSide_(id, d) {
  if (id.member && id.member.RelationTo) return sideOf_(id.member.RelationTo);
  if (id.guest) return id.guest.Side || sideOf_(id.guest.RelationTo);
  return sideOf_(d && d.relationTo);
}

