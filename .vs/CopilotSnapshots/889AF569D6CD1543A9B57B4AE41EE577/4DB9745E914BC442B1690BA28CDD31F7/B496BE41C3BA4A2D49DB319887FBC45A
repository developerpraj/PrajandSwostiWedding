  table_('MomProfile').forEach(r => profile[r.Key] = r.Value);
  const moderated = s['memorial.moderation'] === 'TRUE';
  const memories = table_('MomMemories')
    .filter(m => !bool_(m.IsPrivate) && (!moderated || m.Status === 'Approved'))
