// ---------- Entry points ----------

function doGet() {
  return json_({ ok: true, message: 'Wedding API running' });
}

function doPost(e) {
  try {
    const req = JSON.parse(e.postData.contents || '{}');
    const action = req.action || '';
    const data = req.data || {};
    if (action.indexOf('admin.') === 0) {
      if (!isAdmin_(req.adminKey)) { activity_('admin', 'admin.denied', {}, req.client); return json_({ ok: false, error: 'unauthorized' }); }
      const fn = ADMIN_ACTIONS[action];
      if (!fn) return json_({ ok: false, error: 'unknown action' });
      const out = fn(data);
      if (!/^admin\.(login|stats|guests|people|rooms|settings|events|media|games|memories|venues|planner|invites|proofs|logs)$/.test(action)) activity_('admin', action, data, req.client);
      return json_({ ok: true, data: out });
    }
    if (action === 'track') { activity_('guest', 'ui.' + str_(data.event).slice(0, 40), data, req.client); return json_({ ok: true, data: true }); }
    if (!/^(getConfig|getHome|getGuest|getPass|getLive|getGallery|getGames|getLeaderboard|getMemorial|searchPeople|getNudges|getInvite)$/.test(action)) activity_('guest', action, data, req.client);
    const fn = PUBLIC_ACTIONS[action];
    if (!fn) return json_({ ok: false, error: 'unknown action' });
    if (action !== 'getConfig' && isClosed_()) {
      const memorialAction = ['getMemorial', 'lightDiya', 'submitMemory'].indexOf(action) >= 0;
      if (!(memorialAction && settings_()['app.keepMemorialAfterEnd'] === 'TRUE')) return json_({ ok: false, error: 'closed' });
    }
    return json_({ ok: true, data: fn(data) });
  } catch (err) {
    return json_({ ok: false, error: String(err && err.message || err) });
  }
}

