/* Phone-first layer (90%+ of guests are on phone browsers). Loaded after base.css. */
html { -webkit-text-size-adjust: 100%; }
body { overscroll-behavior-y: contain; padding-bottom: env(safe-area-inset-bottom); }
input, select, textarea, button { font-size: 16px; } /* stops iOS zoom on focus */
.btn, button, .opt, .seg label, select, input:not([type=checkbox]):not([type=radio]) { min-height: 44px; } /* thumb-size targets */
.btn.block { display: flex; width: 100%; justify-content: center; align-items: center; gap: .4rem; }
.btn-row { display: flex; flex-wrap: wrap; gap: .5rem; }
img { max-width: 100%; height: auto; }
.lang-switch button { min-height: 36px; padding: .3rem .6rem; }

/* Top nudge banner */
.nudge { position: sticky; top: 0; z-index: 30; display: flex; align-items: center; gap: .6rem; padding: .7rem .9rem;
  background: linear-gradient(90deg, var(--primary), var(--accent)); color: #fff; text-decoration: none; font-weight: 600;
  box-shadow: 0 2px 10px rgba(0,0,0,.15); animation: nudgeIn .4s ease-out; }
.nudge-icon { font-size: 1.4rem; }
.nudge-text { flex: 1; line-height: 1.3; }
.nudge-go { font-size: 1.6rem; }
.nudge-x { background: transparent; border: 0; color: #fff; font-size: 1.4rem; min-height: 32px; padding: 0 .3rem; }
@keyframes nudgeIn { from { transform: translateY(-100%); } to { transform: none; } }

/* Relative typeahead */
.ta { position: relative; }
.ta-list { position: absolute; left: 0; right: 0; top: 100%; z-index: 20; background: #fff; border: 1px solid #e3d3c3; border-radius: 12px;
  box-shadow: 0 8px 24px rgba(0,0,0,.12); max-height: 50vh; overflow: auto; }
.ta-list button { display: block; width: 100%; text-align: left; background: #fff; border: 0; border-bottom: 1px solid #f2e8de; padding: .7rem .8rem; }
.ta-list button:active { background: #fff3e6; }
.ta-h { padding: .4rem .8rem; font-size: .8rem; }
.err-text { color: #b00020; }

@media (max-width: 640px) {
  main { padding: .6rem; }
  .card { padding: .9rem; border-radius: 14px; }
  .grid { grid-template-columns: 1fr !important; }
  .topbar { flex-wrap: wrap; gap: .3rem; padding: .5rem .7rem; }
  .topbar nav { order: 3; width: 100%; display: flex; overflow-x: auto; gap: .4rem; scrollbar-width: none; -webkit-overflow-scrolling: touch; }
  .topbar nav::-webkit-scrollbar { display: none; }
  .topbar nav a { white-space: nowrap; flex: none; }
  .venue { flex-direction: column; align-items: stretch; }
  .venue-actions { justify-content: stretch; } .venue-actions > * { flex: 1; }
  .event-row { flex-direction: column; align-items: stretch; gap: .4rem; }
  .table-wrap { overflow-x: auto; -webkit-overflow-scrolling: touch; }
  .install-fab { bottom: calc(1rem + env(safe-area-inset-bottom)); }
  h1 { font-size: 1.6rem; } h2 { font-size: 1.25rem; }
}


/* Digital gift */
.gift-qrs { display: grid; grid-template-columns: repeat(auto-fill, minmax(150px, 1fr)); gap: .8rem; margin-top: .8rem; }
.gift-qr { margin: 0; background: #fff; border-radius: 12px; padding: .6rem; box-shadow: 0 2px 8px rgba(0,0,0,.08); text-align: center; }
.gift-qr img { width: 100%; aspect-ratio: 1; object-fit: contain; }
.gift-qr figcaption { font-weight: 600; margin: .3rem 0; }
.stat-list { list-style: none; padding: 0; margin: 0; } .stat-list li { display: flex; justify-content: space-between; padding: .3rem 0; border-bottom: 1px solid #f2e8de; }
.hours { display: flex; align-items: flex-end; gap: 2px; height: 80px; } .hours span { flex: 1; background: var(--primary, #b3122e); min-height: 2px; border-radius: 2px 2px 0 0; }

/* Anonymous toggle, secret notes, cash-envelope sheet */
.anon-toggle { display: flex; align-items: center; gap: .5rem; justify-content: center; margin: .5rem 0; opacity: .85; }
.whisper { text-align: center; max-width: 520px; margin: auto; }
.whisper-icon { font-size: 3rem; }
.whisper textarea { width: 100%; }
dialog.sheet { border: 0; border-radius: 18px; padding: 1rem; width: min(440px, 94vw); }
dialog.sheet::backdrop { background: rgba(0,0,0,.5); }
dialog.sheet .stack { display: flex; flex-direction: column; gap: .6rem; }
dialog.sheet .row { display: flex; gap: .5rem; }
dialog.sheet .row > * { flex: 1; }
@media (max-width: 600px) { dialog.sheet { margin: auto 0 0; width: 100vw; max-width: 100vw; border-radius: 18px 18px 0 0; } }
/* Admin guest directory */
.toolbar { display: flex; flex-wrap: wrap; gap: .5rem; align-items: center; margin-bottom: .5rem; }
.toolbar input[type=search] { flex: 1 1 220px; }
.tag { display: inline-block; font-size: .75rem; padding: .1rem .5rem; margin: .15rem .2rem 0 0; border-radius: 999px; background: rgba(160,90,200,.15); text-decoration: none; }
dialog.sheet.wide { width: min(760px, 96vw); max-height: 92vh; overflow: auto; }
dialog.sheet.wide .grid label { display: flex; flex-direction: column; font-size: .85rem; }
.big-num { font-size: 1.3rem; }
.danger { color: #b00020; }
.install-fab.pulse { animation: pulse 1.6s ease-in-out 4; }
@keyframes pulse { 50% { transform: scale(1.08); } }
/* Thank-you engine, attended chips */
.tq-list { display: grid; gap: .75rem; }
.tq-item { border: 1px solid rgba(0,0,0,.08); border-radius: 14px; padding: .75rem; }
.tq-item textarea { width: 100%; margin: .4rem 0; }
.chips { display: flex; flex-wrap: wrap; gap: .5rem; }
.chip input { display: none; }
.chip span { display: inline-block; padding: .55rem .9rem; border-radius: 999px; border: 1px solid currentColor; opacity: .7; }
.chip input:checked + span { background: var(--primary, #b3122e); color: #fff; opacity: 1; border-color: transparent; }
.bar { background: rgba(0,0,0,.08); border-radius: 6px; height: 8px; min-width: 80px; }
.bar span { display: block; height: 100%; border-radius: 6px; background: var(--primary, #b3122e); }

.q-thumb { width: 44px; height: 44px; object-fit: cover; border-radius: 8px; margin-right: .5rem; }
.msg.warn { background: #fff4d6; color: #7a5200; padding: .4rem .6rem; border-radius: 8px; }

/* ---------- Editorial Warmth polish ---------- */
h1, h2 { letter-spacing: .01em; }
h3 { font-size: 1.1rem; }
.btn { border-radius: 999px; letter-spacing: .01em; transition: transform .12s ease, box-shadow .12s ease; }
.btn:active { transform: scale(.97); }
.btn.ghost { border-color: var(--line); }
.muted { color: var(--muted); }
.rit-hero { background: radial-gradient(120% 140% at 50% 0%, #fff7e3 0%, var(--card) 60%); }
.rit-hero h1::after, .card.center > h1::after { content: ''; display: block; width: 56px; height: 3px; margin: .5rem auto 0; border-radius: 3px; background: var(--accent); }

/* Pocket Pandit */
.rit-list { list-style: none; padding: 0; margin: 0; display: grid; gap: .75rem; }
.rit-card { display: flex; gap: .9rem; align-items: flex-start; background: var(--card); border: 1px solid var(--line); border-radius: var(--radius); padding: 1rem 1.1rem; transition: transform .35s ease, opacity .35s ease; }
.rit-card h3 { margin: .1rem 0 .3rem; }
.rit-card p { margin: 0; color: var(--text); opacity: .85; font-size: .95rem; }
.rit-card.now { border: 2px solid var(--accent); background: linear-gradient(180deg, #fff6df, var(--card)); animation: ritFlip .6s ease; box-shadow: 0 10px 30px -14px #e3a01880; }
.rit-card.done { opacity: .55; }
.rit-ico { font-size: 1.8rem; line-height: 1; flex: none; }
.rit-badge { display: inline-block; font-size: .72rem; font-weight: 600; color: #fff; background: var(--primary); border-radius: 999px; padding: .1rem .55rem; animation: pulse 1.8s ease-in-out infinite; }
.rit-done { color: var(--forest); font-weight: 700; }
@keyframes ritFlip { from { transform: rotateX(70deg); opacity: 0; } to { transform: none; opacity: 1; } }
.rit-admin { display: grid; gap: .5rem; }
.rit-row { display: flex; gap: .6rem; align-items: center; padding: .6rem; border: 1px solid var(--line); border-radius: 12px; }
.rit-row.now { border-color: var(--accent); background: #fff6df; }
.rit-row.done { opacity: .6; }
.rit-txt { flex: 1; min-width: 0; }
.rit-txt .muted { display: -webkit-box; -webkit-line-clamp: 1; -webkit-box-orient: vertical; overflow: hidden; }

/* Envelope scanner */
.scan-btn { display: block; text-align: center; }
.scan-prev { width: 100%; max-height: 180px; object-fit: contain; border-radius: 12px; background: var(--sand); }