@import url('https://fonts.googleapis.com/css2?family=Noto+Sans+Devanagari:wght@400;600;700&family=Poppins:wght@400;600;700&family=Tiro+Devanagari+Hindi&display=swap');

:root {
  --primary: #b3122e;
  --accent: #e8a317;
  --bride: #e8a317;
  --groom: #7a1f3d;
  --bg: #fff8ef;
  --card: #ffffff;
  --text: #2b1d16;
  --muted: #7a6a5e;
  --green: #2e9e4f;
  --yellow: #e6b800;
  --red: #d32f2f;
  --blue: #1e88e5;
  --radius: 14px;
}

* { box-sizing: border-box; }
body {
  margin: 0;
  font-family: 'Poppins', 'Noto Sans Devanagari', system-ui, sans-serif;
  background: var(--bg);
  color: var(--text);
  line-height: 1.5;
}

.topbar {
  background: linear-gradient(135deg, var(--primary), #6d0b1c);
  color: #fff;
  padding: .75rem 1rem;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: .5rem;
  flex-wrap: wrap;
}
.topbar .brand { font-family: 'Tiro Devanagari Hindi', serif; font-size: 1.3rem; }
.topbar nav { display: flex; gap: .75rem; flex-wrap: wrap; }
.topbar nav a { color: #fff; text-decoration: none; opacity: .9; }
.topbar nav a:hover { opacity: 1; text-decoration: underline; }

.lang-switch { display: inline-flex; border: 1px solid #fff8; border-radius: 20px; overflow: hidden; }
.lang-switch button { background: transparent; color: #fff; border: 0; padding: .3rem .7rem; cursor: pointer; font: inherit; }
.lang-switch button.active { background: #fff; color: var(--primary); }

main { max-width: 900px; margin: 1.5rem auto; padding: 0 1rem; }
.card { background: var(--card); border-radius: var(--radius); padding: 1.25rem; margin-bottom: 1rem; box-shadow: 0 2px 10px #0000000d; }
.center { text-align: center; }
.muted { color: var(--muted); font-size: .9rem; }
h1, h2, h3 { font-family: 'Tiro Devanagari Hindi', 'Poppins', serif; color: var(--primary); margin-top: 0; }

.grid { display: grid; gap: 1rem; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); }
label { display: block; font-weight: 600; margin: .6rem 0 .25rem; }
input, select, textarea {
  width: 100%; padding: .6rem .7rem; border: 1px solid #d9cbbd; border-radius: 10px; font: inherit; background: #fff;
}
textarea { min-height: 90px; }
.check { display: flex; gap: .5rem; align-items: center; font-weight: 400; }
.check input { width: auto; }

.btn {
  display: inline-block; background: var(--primary); color: #fff; border: 0; border-radius: 10px;
  padding: .65rem 1.2rem; font: inherit; font-weight: 600; cursor: pointer; text-decoration: none;
}
.btn.alt { background: var(--accent); color: #2b1d16; }
.btn.ghost { background: transparent; color: var(--primary); border: 1px solid var(--primary); }
.btn.sm { padding: .3rem .7rem; font-size: .85rem; }
.btn:disabled { opacity: .6; cursor: wait; }

.msg { padding: .7rem 1rem; border-radius: 10px; margin: .75rem 0; }
.msg.ok { background: #e7f6ec; color: #1b5e20; }
.msg.err { background: #fdecea; color: #8b1a1a; }

.live-banner {
  background: var(--accent); color: #2b1d16; padding: .6rem 1rem; text-align: center; font-weight: 600;
  animation: pulse 2s infinite;
}
@keyframes pulse { 50% { opacity: .8; } }

.countdown { font-size: 3rem; font-weight: 700; color: var(--primary); }

.event-row { display: flex; justify-content: space-between; align-items: center; gap: .5rem; padding: .6rem 0; border-bottom: 1px dashed #e5d8ca; flex-wrap: wrap; }
.event-row.locked { opacity: .6; }
.seg { display: inline-flex; border: 1px solid #d9cbbd; border-radius: 8px; overflow: hidden; }
.seg label { margin: 0; font-weight: 400; padding: .3rem .7rem; cursor: pointer; }
.seg input { display: none; }
.seg input:checked + span { color: var(--primary); font-weight: 700; }

.band { display: inline-flex; align-items: center; gap: .4rem; padding: .3rem .8rem; border-radius: 20px; color: #fff; font-weight: 600; }
.band.green { background: var(--green); }
.band.yellow { background: var(--yellow); color: #2b1d16; }
.band.red { background: var(--red); }
.band.blue { background: var(--blue); }

.pass { max-width: 420px; margin: 0 auto; text-align: center; border-top: 8px solid var(--primary); }
.pass .qr svg { width: 220px; height: 220px; }
.side-tag { display: inline-block; padding: .2rem .7rem; border-radius: 20px; color: #fff; font-size: .85rem; }
.side-tag.Bride { background: var(--bride); color: #2b1d16; }
.side-tag.Groom { background: var(--groom); }
.side-tag.Both { background: linear-gradient(90deg, var(--bride), var(--groom)); }

table { width: 100%; border-collapse: collapse; font-size: .9rem; }
th, td { padding: .45rem; border-bottom: 1px solid #eee2d6; text-align: left; vertical-align: top; }
th { background: #fbf1e6; position: sticky; top: 0; }
.table-wrap { overflow: auto; max-height: 60vh; }

.stat { text-align: center; }
.stat .n { font-size: 2rem; font-weight: 700; color: var(--primary); }
.stat .l { color: var(--muted); font-size: .85rem; }

.tabs { display: flex; gap: .5rem; flex-wrap: wrap; margin-bottom: 1rem; }
.tabs button { background: #fff; border: 1px solid #d9cbbd; border-radius: 20px; padding: .4rem 1rem; cursor: pointer; font: inherit; }
.tabs button.active { background: var(--primary); color: #fff; border-color: var(--primary); }
.panel { display: none; }
.panel.active { display: block; }

footer { text-align: center; color: var(--muted); padding: 2rem 1rem; font-size: .85rem; }

/* ---------- Side themes ---------- */
/* Bride side: "Gulabi Marigold" - rose pink + marigold */
body.side-bride {
  --bg: #fff4f7;
  --text: #3a1424;
  --muted: #8a5a6c;
  background:
    radial-gradient(circle at 10% 0%, #ffd9e533 0, transparent 40%),
    radial-gradient(circle at 90% 100%, #ffe0a633 0, transparent 40%),
    var(--bg);
}
body.side-bride .topbar { background: linear-gradient(135deg, var(--primary), #f06292 60%, var(--accent)); }
body.side-bride .card { border-top: 4px solid var(--accent); }
body.side-bride .countdown { color: var(--primary); text-shadow: 0 2px 0 #f4a30055; }

/* Groom side: "Royal Peacock" - peacock teal + gold */
body.side-groom {
  --bg: #f1f7f6;
  --text: #0e2a2c;
  --muted: #4f6e70;
  background:
    radial-gradient(circle at 90% 0%, #0f5c6322 0, transparent 40%),
    radial-gradient(circle at 10% 100%, #d4a01722 0, transparent 40%),
    var(--bg);
}
body.side-groom .topbar { background: linear-gradient(135deg, #0a3d42, var(--primary) 55%, #1b7f7a); border-bottom: 3px solid var(--accent); }
body.side-groom .card { border-top: 4px solid var(--accent); }
body.side-groom .btn.alt { background: var(--accent); color: #0e2a2c; }

/* ---------- Closed (after wedding end date) ---------- */
.closed { padding: 3rem 1.5rem; }

/* ---------- Install app ---------- */
.install-fab {
  position: fixed; right: 1rem; bottom: 1rem; z-index: 50;
  background: var(--accent); color: #2b1d16; border: 0; border-radius: 30px;
  padding: .7rem 1.1rem; font: inherit; font-weight: 700; cursor: pointer;
  box-shadow: 0 6px 18px #0003; animation: bob 3s ease-in-out infinite;
}
@keyframes bob { 50% { transform: translateY(-4px); } }
.install-sheet {
  position: fixed; inset: 0; background: #0008; z-index: 100;
  display: flex; align-items: flex-end; justify-content: center;
}
.install-card {
  background: #fff; width: 100%; max-width: 480px; border-radius: 20px 20px 0 0;
  padding: 1.5rem 1.25rem calc(1.5rem + env(safe-area-inset-bottom)); text-align: center;
  animation: slideUp .25s ease-out;
}
@keyframes slideUp { from { transform: translateY(100%); } }
.install-card ol { text-align: left; line-height: 1.9; padding-left: 1.4rem; }
.install-icon img { width: 72px; height: 72px; border-radius: 16px; box-shadow: 0 4px 12px #0002; }
.ios-arrow { font-size: 2rem; animation: bob 1.5s infinite; }

/* ---------- Mobile app view (phones + installed app) ---------- */
.topbar nav a.current { font-weight: 700; text-decoration: underline; }

@media (max-width: 700px), (display-mode: standalone) {
  .topbar {
    position: sticky; top: 0; z-index: 20;
    padding-top: calc(.6rem + env(safe-area-inset-top));
  }
  .topbar nav {
    position: fixed; left: 0; right: 0; bottom: 0; z-index: 30;
    background: #fff; box-shadow: 0 -2px 12px #0002;
    display: grid; grid-auto-flow: column; grid-auto-columns: 1fr; gap: 0;
    padding-bottom: env(safe-area-inset-bottom);
  }
  .topbar nav a {
    color: var(--muted); text-align: center; font-size: .68rem; line-height: 1.2;
    padding: .45rem .2rem; opacity: 1; overflow: hidden; text-overflow: ellipsis;
    display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical;
  }
  .topbar nav a::before { content: attr(data-icon); display: block; font-size: 1.35rem; margin-bottom: .1rem; }
  .topbar nav a.current { color: var(--primary); font-weight: 700; text-decoration: none; }
  .topbar nav a[hidden] { display: none; }
  main { margin-top: 1rem; padding-bottom: calc(5rem + env(safe-area-inset-bottom)); }
  footer { padding-bottom: calc(6rem + env(safe-area-inset-bottom)); }
  .install-fab { bottom: calc(4.8rem + env(safe-area-inset-bottom)); }
  .card { border-radius: 18px; }
  .btn { padding: .8rem 1.2rem; }
  .pass .qr svg { width: 70vw; height: 70vw; max-width: 260px; max-height: 260px; }
  h1 { font-size: 1.6rem; }
}

@media (display-mode: standalone) {
  body { -webkit-user-select: none; user-select: none; overscroll-behavior-y: none; }
  input, textarea { -webkit-user-select: text; user-select: text; }
}

/* ---------- Engagement hub, photos, games ---------- */
.row-between { display: flex; justify-content: space-between; align-items: center; gap: .5rem; flex-wrap: wrap; }
.pill { background: var(--accent); color: #2b1d16; border-radius: 999px; padding: .1rem .6rem; font-size: .85rem; font-weight: 700; }
.who-switch { text-align: right; margin: .25rem 0 .5rem; }
.who-switch select { width: auto; display: inline-block; }
.hub { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: .75rem; }
.hub-tile { display: flex; flex-direction: column; gap: .35rem; text-decoration: none; color: inherit; margin: 0; }
.hub-tile small { text-transform: uppercase; letter-spacing: .05em; color: var(--primary); font-weight: 700; }
.hub-tile .btn { align-self: flex-start; }
.big-num { font-size: 2.2rem; color: var(--primary); }
.team-bar { display: flex; height: 12px; border-radius: 999px; overflow: hidden; background: #eee; margin: .4rem 0; }
.team-bar .bride { background: var(--bride); transition: width .6s; }
.team-bar .groom { background: var(--groom); transition: width .6s; }
.btn.big { font-size: 1.1rem; padding: .9rem 1.4rem; cursor: pointer; }
.upload-buttons { display: flex; gap: .6rem; justify-content: center; flex-wrap: wrap; }
.upload-queue { display: flex; flex-direction: column; gap: .3rem; text-align: left; }
.upload-item { display: grid; grid-template-columns: 1fr 90px auto; gap: .5rem; align-items: center; font-size: .9rem; }
.upload-item .name { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.upload-item.failed { color: #b00020; cursor: pointer; }
.gallery { display: grid; grid-template-columns: repeat(auto-fill, minmax(110px, 1fr)); gap: 4px; }
.tile { position: relative; aspect-ratio: 1; padding: 0; border: 0; background: #eee; overflow: hidden; border-radius: 6px; cursor: pointer; display: block; }
.tile img { width: 100%; height: 100%; object-fit: cover; display: block; }
.tile .play { position: absolute; inset: 0; display: grid; place-items: center; color: #fff; font-size: 2rem; text-shadow: 0 0 8px #000; }
.tile .by { position: absolute; left: 0; right: 0; bottom: 0; font-size: .7rem; color: #fff; background: linear-gradient(transparent, rgba(0,0,0,.6)); padding: .6rem .3rem .2rem; text-align: left; }
.viewer { position: fixed; inset: 0; background: rgba(0,0,0,.9); z-index: 1000; display: grid; place-items: center; padding: 1rem; }
.viewer-inner { max-width: 100%; max-height: 100%; display: flex; flex-direction: column; gap: .5rem; }
.viewer-inner img, .viewer-inner iframe { max-width: 95vw; max-height: 78vh; border: 0; border-radius: 8px; }
.viewer-inner iframe { width: 95vw; height: 70vh; }
.viewer-bar { display: flex; gap: .5rem; align-items: center; justify-content: center; flex-wrap: wrap; color: #fff; }
.opts { display: grid; grid-template-columns: repeat(auto-fit, minmax(140px, 1fr)); gap: .4rem; }
.opt { padding: .7rem; border-radius: 10px; border: 2px solid #e5d6c6; background: #fff; cursor: pointer; font: inherit; }
.opt:hover:not(:disabled) { border-color: var(--primary); }
.opt.right { border-color: #1b8a3a; background: #e6f6ea; }
.leader { padding-left: 1.2rem; }
.leader li { display: flex; justify-content: space-between; padding: .3rem 0; border-bottom: 1px dashed #eadccd; }
.member-row { background: #fffaf3; }

@media print {
  .topbar, .no-print, footer { display: none !important; }
  body { background: #fff; }
  main { margin: 0; max-width: none; }
}

/* ---------- Venues / sign-in ---------- */
.venues { display: flex; flex-direction: column; gap: .5rem; }
.venue { display: flex; justify-content: space-between; align-items: center; gap: .6rem; padding: .7rem; border: 1px solid #eadccd; border-radius: 12px; background: #fff; flex-wrap: wrap; }
.venue.chosen { border: 2px solid var(--primary); background: #fff8f2; }
.venue-actions { display: flex; gap: .4rem; }
.signin { max-width: 440px; margin: 0 auto; }
.signin input { font-size: 1.15rem; }
#nextNav { margin: -.4rem 0 .6rem; }

