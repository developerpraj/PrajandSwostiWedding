// Per-request memo: each sheet is read at most once per API call (big speed win).
const MEMO_ = {};
const SHEET_MEMO_ = {};

function sheet_(name) {
  if (SHEET_MEMO_[name]) return SHEET_MEMO_[name];
  const sh = SpreadsheetApp.getActive().getSheetByName(name);
  if (!sh) throw new Error('Missing sheet ' + name + ' - run setup()');
  return (SHEET_MEMO_[name] = sh);
}

function headers_(name) {
  if (MEMO_[name]) return MEMO_[name].head;
  const sh = sheet_(name);
  return sh.getRange(1, 1, 1, Math.max(1, sh.getLastColumn())).getValues()[0];
}

function table_(name) {
  if (!MEMO_[name]) {
    const values = sheet_(name).getDataRange().getValues();
    const head = values.shift() || [];
    MEMO_[name] = {
      head: head,
      rows: values.filter(r => r.join('') !== '').map(r => {
        const o = {};
        head.forEach((h, i) => o[h] = r[i] instanceof Date ? r[i].toISOString() : r[i]);
        return o;
      })
    };
  }
  return MEMO_[name].rows.map(r => Object.assign({}, r));
}

function dirty_(name) {
  delete MEMO_[name];
  if (name !== 'AuditLog' && name !== 'Vibe' && name !== 'Traditions' && name !== 'Scenarios') CacheService.getScriptCache().remove('config');
}

function appendObj_(name, obj) {
  sheet_(name).appendRow(headers_(name).map(h => obj[h] !== undefined ? obj[h] : ''));
  dirty_(name);
}

function updateBy_(name, keyCol, keyVal, patch) {
  const sh = sheet_(name);
  const values = sh.getDataRange().getValues();
  const head = values[0];
  const k = head.indexOf(keyCol);
  for (let i = 1; i < values.length; i++) {
    if (String(values[i][k]) === String(keyVal)) {
      const row = head.map((h, ci) => patch[h] !== undefined ? patch[h] : values[i][ci]);
      sh.getRange(i + 1, 1, 1, head.length).setValues([row]);
      dirty_(name);
      if (name === 'Settings') CacheService.getScriptCache().remove('settings');
      return true;
    }
  }
  return false;
}

function deleteBy_(name, keyCol, keyVal) {
  const sh = sheet_(name);
  const values = sh.getDataRange().getValues();
  const k = values[0].indexOf(keyCol);
  for (let i = values.length - 1; i >= 1; i--) {
    if (String(values[i][k]) === String(keyVal)) sh.deleteRow(i + 1);
  }
  dirty_(name);
}

function upsert_(name, keyCol, keyVal, row) {
  if (!updateBy_(name, keyCol, keyVal, row)) appendObj_(name, row);
  if (name === 'Settings') CacheService.getScriptCache().remove('settings');
  return true;
}

function upsertComposite_(name, cols, key, row) {
  const sh = sheet_(name);
  const values = sh.getDataRange().getValues();
  const head = values[0];
  const idx = cols.map(c => head.indexOf(c));
  for (let i = 1; i < values.length; i++) {
    if (idx.map(j => String(values[i][j])).join('|') === key) {
      sh.getRange(i + 1, 1, 1, head.length).setValues([head.map((h, ci) => row[h] !== undefined ? row[h] : values[i][ci])]);
      dirty_(name);
      return true;
    }
  }
  appendObj_(name, row);
  return true;
}

function ageFrom_(dob) {
  const d = new Date(dob);
  if (isNaN(d)) return '';
  const now = new Date();
  let age = now.getFullYear() - d.getFullYear();
  const m = now.getMonth() - d.getMonth();
  if (m < 0 || (m === 0 && now.getDate() < d.getDate())) age--;
  return age;
}

function id_() {
  const chars = 'ABCDEFGHJKLMNPQRSTUVWXYZ23456789';
  let s = '';
  for (let i = 0; i < 8; i++) s += chars.charAt(Math.floor(Math.random() * chars.length));
  return s;
}

function now_() { return new Date().toISOString(); }
function bool_(v) { return v === true || String(v).toUpperCase() === 'TRUE'; }
function str_(v) { return v === undefined || v === null ? '' : String(v).trim(); }
function log_(action, details) { try { appendObj_('AuditLog', { Timestamp: now_(), Action: action, Details: details }); } catch (e) { /* ignore */ } }
function json_(o) { return ContentService.createTextOutput(JSON.stringify(o)).setMimeType(ContentService.MimeType.JSON); }