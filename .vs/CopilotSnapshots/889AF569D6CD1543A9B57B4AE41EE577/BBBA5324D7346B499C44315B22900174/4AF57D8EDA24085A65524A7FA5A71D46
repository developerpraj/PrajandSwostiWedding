function adminStats_() {
  const guests = table_('Guests').map(withDerived_);
  const members = table_('Members').map(withDerivedMember_);
  const events = table_('Events');
  const rsvps = table_('EventRsvp');
  const acc = table_('Accommodation');
  const rooms = table_('Rooms');
  const sum = (arr, f) => arr.reduce((t, x) => t + (Number(f(x)) || 0), 0);

  const byStatus = s => guests.filter(g => g.Status === s);
  const attending = byStatus('Attending');
  const meals = {};
  attending.forEach(g => { const m = g.Meal || 'Unspecified'; meals[m] = (meals[m] || 0) + (Number(g.AttendingCount) || 0); });

  const perEvent = events.map(e => {
    const r = rsvps.filter(x => x.EventId === e.EventId);
    return {
      eventId: e.EventId, nameEn: e.NameEn, nameNe: e.NameNe, dateTime: e.DateTime,
      yes: sum(r.filter(x => x.Response === 'Yes'), x => x.Count),
      maybe: sum(r.filter(x => x.Response === 'Maybe'), x => x.Count),
      no: r.filter(x => x.Response === 'No').length
    };
  });

  const going = members.filter(m => bool_(m.Attending));
  const bands = { green: 0, yellow: 0, red: 0, blue: 0 };
  going.forEach(m => { if (bands[m.Band] !== undefined) bands[m.Band]++; });
  const relations = {};
  going.forEach(m => { const k = m.RelationTo || 'Unspecified'; relations[k] = (relations[k] || 0) + 1; });
  const media = table_('Media');
  const players = {};
  table_('Scores').forEach(s => players[s.GuestId + '|' + s.MemberId] = 1);

  return {
    updatedAt: now_(),
    invited: guests.length,
    invitedPeople: sum(guests, g => g.AdmitCount),
    registered: guests.filter(g => bool_(g.Registered)).length,
    attendingGuests: attending.length,
    attendingPeople: sum(attending, g => g.AttendingCount),
    notAttending: byStatus('Not attending').length,
    maybe: byStatus('Maybe').length,
    pending: guests.filter(g => !bool_(g.Registered)).length,
    brideSide: going.filter(m => sideOf_(m.RelationTo) === 'Bride').length,
    groomSide: going.filter(m => sideOf_(m.RelationTo) === 'Groom').length,
    checkedIn: members.filter(m => bool_(m.CheckedIn)).length +
      guests.filter(g => bool_(g.CheckedIn) && !members.some(m => m.GuestId === g.GuestId)).length,
    meals: meals,
    bands: bands,
    relations: relations,
    perEvent: perEvent,
    media: {
      photos: media.filter(m => m.Type === 'photo' && m.Status === 'Approved').length,
      videos: media.filter(m => m.Type === 'video' && m.Status === 'Approved').length,
      pending: media.filter(m => m.Status === 'Pending').length
    },
    players: Object.keys(players).length,
    accommodation: {
      eligible: guests.filter(g => bool_(g.AccommodationEligible)).length,
      requested: acc.filter(a => a.Status === 'Requested').length,
      assigned: acc.filter(a => a.Status === 'Assigned').length,
      people: sum(acc, a => a.People),
      capacity: sum(rooms, r => r.Capacity)
    }
  };
}

