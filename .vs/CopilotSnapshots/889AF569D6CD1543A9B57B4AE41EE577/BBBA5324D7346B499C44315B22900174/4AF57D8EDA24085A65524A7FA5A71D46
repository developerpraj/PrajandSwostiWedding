/**
 * method 'phone': phone + (invite code OR date of birth of anyone in the household).
 * method 'google': Google ID token (verified with Google), matched to Email/GoogleEmail.
 * Optional guestId links a Google account to an already-open invitation.
 */
function signIn_(d) {
  const s = settings_();
  let g = null;
  if (d.method === 'phone') {
    if (s['auth.phone'] !== 'TRUE') throw new Error('Phone sign-in is off');
    const p = digits_(d.phone);
    const code = str_(d.code).toUpperCase();
    if (p.length < 7 || !code) throw new Error('Enter phone and code');
    const guests = table_('Guests').filter(x => digits_(x.Phone) === p);
    g = guests.filter(x => {
      if (String(x.GuestId).toUpperCase() === code) return true;
      const dob = dateKey_(code);
      if (!dob) return false;
      return dateKey_(x.DOB) === dob || membersOf_(x.GuestId).some(m => dateKey_(m.DOB) === dob);
    })[0];
    if (!g) { Utilities.sleep(800); throw new Error('No invitation matches that phone and code'); }
  } else if (d.method === 'google') {
    if (s['auth.google'] !== 'TRUE' || !s['auth.googleClientId']) throw new Error('Google sign-in is off');
    const res = UrlFetchApp.fetch('https://oauth2.googleapis.com/tokeninfo?id_token=' + encodeURIComponent(str_(d.credential)), { muteHttpExceptions: true });
    if (res.getResponseCode() !== 200) throw new Error('Google sign-in failed');
    const t = JSON.parse(res.getContentText());
    if (t.aud !== s['auth.googleClientId'] || String(t.email_verified) !== 'true') throw new Error('Google sign-in failed');
    const email = String(t.email).toLowerCase();
    g = table_('Guests').filter(x => String(x.GoogleEmail).toLowerCase() === email || String(x.Email).toLowerCase() === email)[0];
    if (!g && d.guestId) {
      g = findGuest_(d.guestId);
      updateBy_('Guests', 'GuestId', g.GuestId, { GoogleEmail: email });
    }
    if (!g) throw new Error('This Google account is not linked to an invitation yet. Open your invite link first, then sign in with Google.');
    if (!g.GoogleEmail) updateBy_('Guests', 'GuestId', g.GuestId, { GoogleEmail: email });
  } else {
    throw new Error('Unknown sign-in method');
  }
  log_('signIn:' + d.method, g.GuestId);
  return { guestId: g.GuestId, members: membersOf_(g.GuestId).map(publicMember_), registered: bool_(g.Registered) };
}

