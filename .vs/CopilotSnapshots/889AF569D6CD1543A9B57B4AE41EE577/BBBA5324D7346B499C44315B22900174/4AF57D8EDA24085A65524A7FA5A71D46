function digits_(p) { return String(p || '').replace(/\D/g, '').slice(-10); }

function dateKey_(v) {
  const d = new Date(v);
  return isNaN(d) ? '' : Utilities.formatDate(d, 'UTC', 'yyyy-MM-dd');
