function bandFor_(dob, nonDrinker, verified) {
  const legal = Number(settings_()['drink.legalAge']) || 18;
  const age = dob ? ageFrom_(dob) : '';
  if (bool_(nonDrinker)) return { age: age, band: 'blue' };
  if (age === '' || age < legal) return { age: age, band: 'red' };
  return { age: age, band: bool_(verified) ? 'green' : 'yellow' };
}

