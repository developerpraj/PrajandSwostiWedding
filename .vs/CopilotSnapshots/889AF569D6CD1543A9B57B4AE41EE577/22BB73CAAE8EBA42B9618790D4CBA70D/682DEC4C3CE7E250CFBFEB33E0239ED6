// Shared helpers: guest ID, config/theme, language switcher, QR, escaping.
window.App = (function () {
  function esc(s) {
    return String(s == null ? '' : s).replace(/[&<>"']/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
  }

  function guestId() {
    const fromUrl = new URLSearchParams(location.search).get('g');
    if (fromUrl) localStorage.setItem('guestId', fromUrl.trim());
    return fromUrl || localStorage.getItem('guestId') || '';
  }

  function withGuest(href) {
    const g = guestId();
    return g ? href + (href.indexOf('?') >= 0 ? '&' : '?') + 'g=' + encodeURIComponent(g) : href;
  }

  // ---------- Remembered person & relatives (household) ----------
  function memberId() {
    const fromUrl = new URLSearchParams(location.search).get('m');
    if (fromUrl) localStorage.setItem('memberId', fromUrl.trim());
    return fromUrl || localStorage.getItem('memberId') || '';
  }

  function household() {
    try { return JSON.parse(localStorage.getItem('household') || '[]'); } catch (e) { return []; }
  }

  function remember(members, preferId) {
    localStorage.setItem('household', JSON.stringify(members || []));
    const cur = memberId();
    if (preferId && !cur) localStorage.setItem('memberId', preferId);
    else if (cur && !(members || []).some(m => m.MemberId === cur)) {
      const p = (members || []).filter(m => m.IsPrimary)[0];
      localStorage.setItem('memberId', p ? p.MemberId : '');
    }
    const me = currentMember();
    if (me && me.RelationTo) setSide(/^Bride/.test(me.RelationTo) ? 'Bride' : /^Groom/.test(me.RelationTo) ? 'Groom' : 'Both');
  }

  function currentMember() {
    const id = memberId();
    const list = household();
    return list.filter(m => m.MemberId === id)[0] || list.filter(m => m.IsPrimary)[0] || null;
  }

  function setMember(id) {
    localStorage.setItem('memberId', id || '');
    remember(household());
    document.dispatchEvent(new CustomEvent('memberchange', { detail: currentMember() }));
  }

  function who() {
    return { guestId: guestId(), memberId: (currentMember() || {}).MemberId || '' };
  }

  // Small "Who is using this phone?" chip so each relative plays/uploads as themselves.
  function profileSwitcher(el) {
    if (!el) return;
    const list = household();
    if (list.length < 2) { el.hidden = true; return; }
    const cur = currentMember();
    el.hidden = false;
    el.innerHTML = '<label>' + esc(I18N.t('who.label')) + ' <select>' + list.map(m =>
      '<option value="' + esc(m.MemberId) + '"' + (cur && cur.MemberId === m.MemberId ? ' selected' : '') + '>' +
      esc(I18N.bi(m.Name, m.NameNe || m.Name)) + '</option>').join('') + '</select></label>';
    el.querySelector('select').onchange = e => setMember(e.target.value);
  }

  async function refreshHousehold() {
    const g = guestId();
    if (!g) return null;
    try {
      const d = await API.call('getGuest', { guestId: g, memberId: memberId() });
      remember(d.members, d.memberId);
      if (d.guest && d.guest.Side) localStorage.setItem('side', d.guest.Side);
      return d;
    } catch (e) { return null; }
  }

  function siteUrl(page) {
    return location.origin + location.pathname.replace(/[^/]*$/, '').replace(/admin\/$/, '') + page;
  }

  async function config() {
    const cached = sessionStorage.getItem('config');
    if (cached) return JSON.parse(cached);
    const c = await API.call('getConfig', {}, { onFresh: v => sessionStorage.setItem('config', JSON.stringify(v)) });
    sessionStorage.setItem('config', JSON.stringify(c));
    return c;
  }

  // ---------- Venues + Google Maps ----------
  function venueCard(v, chosen) {
    return '<div class="venue' + (chosen ? ' chosen' : '') + '" data-venue="' + esc(v.VenueId) + '"><div><b>' + esc(I18N.bi(v.NameEn, v.NameNe || v.NameEn)) +
      '</b><div class="muted">' + esc(v.Address || '') + '</div>' + (v.Notes ? '<div class="muted">' + esc(v.Notes) + '</div>' : '') + '</div>' +
      '<div class="venue-actions"><a class="btn sm" target="_blank" rel="noopener" href="' + esc(v.Map) + '">🧭 ' + esc(I18N.t('venue.navigate')) + '</a>' +
      (v.Selectable ? ' <button type="button" class="btn ghost sm" data-choose>' + esc(chosen ? '✅' : I18N.t('venue.choose')) + '</button>' : '') + '</div></div>';
  }

  function mapsUrl(place) {
    return 'https://www.google.com/maps/dir/?api=1&destination=' + encodeURIComponent(place || '');
  }

  // ---------- Sign-in ----------
  function signedIn(res) {
    localStorage.setItem('guestId', res.guestId);
    remember(res.members || []);
  }

  function signOut() {
    ['guestId', 'memberId', 'household', 'side'].forEach(k => localStorage.removeItem(k));
    API.clearCache();
    location.href = 'index.html';
  }

  function on(c, key) { return String(c[key]).toUpperCase() === 'TRUE'; }

  function applyTheme(c) {
    const r = document.documentElement.style;
    if (c['theme.primary']) r.setProperty('--primary', c['theme.primary']);
    if (c['theme.accent']) r.setProperty('--accent', c['theme.accent']);
    if (c['theme.brideColor']) r.setProperty('--bride', c['theme.brideColor']);
    if (c['theme.groomColor']) r.setProperty('--groom', c['theme.groomColor']);
    if (c['lang.default']) window.__defaultLang = c['lang.default'];
    applySideTheme(c);
  }

  // Auto theme by side: Bride = "Gulabi Marigold", Groom = "Royal Peacock".
  function setSide(side, c) {
    if (side === 'Bride' || side === 'Groom' || side === 'Both') localStorage.setItem('side', side);
    applySideTheme(c || JSON.parse(sessionStorage.getItem('config') || '{}'));
  }

  function applySideTheme(c) {
    const side = localStorage.getItem('side');
    const cls = document.body.classList;
    cls.remove('side-bride', 'side-groom');
    const rs = document.documentElement.style;
    rs.setProperty('--primary', c['theme.primary'] || '#b3122e');
    rs.setProperty('--accent', c['theme.accent'] || '#e8a317');
    if (!on(c, 'feature.sideThemes') || (side !== 'Bride' && side !== 'Groom')) return;
    const key = side === 'Bride' ? 'bride' : 'groom';
    cls.add('side-' + key);
    const r = document.documentElement.style;
    if (c['theme.' + key + 'Primary']) r.setProperty('--primary', c['theme.' + key + 'Primary']);
    if (c['theme.' + key + 'Accent']) r.setProperty('--accent', c['theme.' + key + 'Accent']);
    const meta = document.querySelector('meta[name="theme-color"]');
    if (meta) meta.content = getComputedStyle(document.documentElement).getPropertyValue('--primary').trim();
  }

  function isClosed(c) {
    if (c.closed) return true;
    const end = new Date(c['wedding.endDate']);
    return !isNaN(end) && new Date() > end;
  }

  function showClosed(c) {
    const main = document.querySelector('main');
    if (!main) return;
    const mem = on(c, 'app.keepMemorialAfterEnd') && on(c, 'feature.memorial');
    main.innerHTML = '<section class="card center closed"><div style="font-size:3rem">🪔</div>' +
      '<h1>' + esc(I18N.t('closed.title')) + '</h1><p>' + esc(I18N.t('closed.text')) + '</p>' +
      (mem ? '<p><a class="btn" href="memorial.html">' + esc(I18N.t('nav.memorial')) + '</a></p>' : '') + '</section>';
    document.querySelectorAll('.topbar nav, #live').forEach(el => el.hidden = true);
  }

  // ---------- Install as app (iOS + Android) ----------
  let deferredPrompt = null;
  window.addEventListener('beforeinstallprompt', e => { e.preventDefault(); deferredPrompt = e; });

  function isStandalone() {
    return window.matchMedia('(display-mode: standalone)').matches || window.navigator.standalone === true;
  }

  function platform() {
    const ua = navigator.userAgent;
    if (/iPhone|iPad|iPod/i.test(ua) || (navigator.platform === 'MacIntel' && navigator.maxTouchPoints > 1)) return 'ios';
    if (/Android/i.test(ua)) return 'android';
    return 'other';
  }

  function inAppBrowser() {
    return /FBAN|FBAV|Instagram|WhatsApp|Line\/|Snapchat|wv\)/i.test(navigator.userAgent);
  }

  function setupInstall(c) {
    if ('serviceWorker' in navigator && location.protocol === 'https:') {
      navigator.serviceWorker.register('sw.js').catch(() => { });
    }
    if (!on(c, 'feature.installApp') || isStandalone() || document.getElementById('installBtn')) return;
    const btn = document.createElement('button');
    btn.id = 'installBtn';
    btn.className = 'install-fab';
    btn.innerHTML = '📲 <span>' + esc(I18N.t('pwa.install')) + '</span>';
    btn.onclick = installApp;
    document.body.appendChild(btn);
    document.addEventListener('langchange', () => btn.querySelector('span').textContent = I18N.t('pwa.install'));
    window.addEventListener('appinstalled', () => btn.remove());
  }

  async function installApp() {
    if (deferredPrompt) {
      deferredPrompt.prompt();
      await deferredPrompt.userChoice;
      deferredPrompt = null;
      return;
    }
    const p = platform();
    let steps;
    if (inAppBrowser()) {
      steps = [I18N.t('pwa.inApp'), p === 'ios' ? I18N.t('pwa.openSafari') : I18N.t('pwa.openChrome')];
    } else if (p === 'ios') {
      steps = [I18N.t('pwa.iosStep1'), I18N.t('pwa.iosStep2'), I18N.t('pwa.iosStep3')];
    } else {
      steps = [I18N.t('pwa.androidStep1'), I18N.t('pwa.androidStep2')];
    }
    const sheet = document.createElement('div');
    sheet.className = 'install-sheet';
    sheet.innerHTML = '<div class="install-card"><div class="install-icon"><img src="icons/icon-192.png" alt=""></div>' +
      '<h3>' + esc(I18N.t('pwa.title')) + '</h3><ol>' + steps.map(s => '<li>' + esc(s) + '</li>').join('') + '</ol>' +
      (inAppBrowser() ? '<p><button class="btn alt" data-copy>' + esc(I18N.t('pwa.copyLink')) + '</button></p>' : '') +
      (p === 'ios' && !inAppBrowser() ? '<div class="ios-arrow">⬇️</div>' : '') +
      '<p><button class="btn ghost" data-close>' + esc(I18N.t('pwa.close')) + '</button></p></div>';
    sheet.addEventListener('click', async e => {
      if (e.target === sheet || e.target.closest('[data-close]')) sheet.remove();
      if (e.target.closest('[data-copy]')) { try { await navigator.clipboard.writeText(location.href); e.target.textContent = '✅'; } catch (x) { } }
    });
    document.body.appendChild(sheet);
  }

  // ---------- Silent activity tracking ----------
  let tracking = false;
  function startTracking() {
    if (tracking) return;
    tracking = true;
    API.track('view', { title: document.title, lang: I18N.mode() });
    const label = el => (el.getAttribute('data-track') || el.getAttribute('aria-label') || el.textContent || el.name || el.id || '').trim().slice(0, 60);
    document.addEventListener('click', e => {
      const el = e.target.closest('a,button,[data-track]');
      if (el) API.track('click', { target: label(el), href: el.getAttribute('href') || '' });
    }, true);
    document.addEventListener('change', e => {
      const el = e.target;
      if (!el || !el.name && !el.id) return;
      const secret = /pass|code|dob|key/i.test((el.name || '') + el.type);
      const value = el.type === 'file' ? Array.from(el.files || []).map(f => f.name + ' (' + Math.round(f.size / 1024) + 'KB)').join(', ')
        : el.type === 'checkbox' ? el.checked : secret ? '***' : String(el.value).slice(0, 300);
      API.track('input', { field: el.name || el.id, value: value, form: (el.form && el.form.id) || '' });
    }, true);
    document.addEventListener('submit', e => API.track('submit', { form: e.target.id || e.target.name || '' }), true);
    document.addEventListener('langchange', () => API.track('language', { lang: I18N.mode() }));
    document.addEventListener('visibilitychange', () => { if (document.visibilityState === 'hidden') API.track('leave', { seconds: Math.round(performance.now() / 1000) }); });
  }

  // ---------- Top banner: personal things to do ----------
  async function nudges(c) {
    if (!on(c, 'feature.nudges') || document.getElementById('nudge')) return;
    let list;
    try { list = await API.call('getNudges', who()); } catch (e) { return; }
    if (!list || !list.length) return;
    const today = Math.floor(Date.now() / 86400000);
    const seen = JSON.parse(sessionStorage.getItem('nudgeSeen') || '[]');
    const fresh = list.filter(n => seen.indexOf(n.en) < 0);
    const pool = fresh.length ? fresh : list;
    // Tasks (non-prompts) first, then a random fun prompt.
    const tasks = pool.filter(n => n.icon !== '✨');
    const n = tasks.length ? tasks[0] : pool[(today + Math.floor(Math.random() * pool.length)) % pool.length];
    const bar = document.createElement('a');
    bar.id = 'nudge';
    bar.className = 'nudge';
    bar.setAttribute('data-track', 'nudge:' + n.en);
    bar.href = withGuest(n.href);
    const paint = () => bar.innerHTML = '<span class="nudge-icon">' + esc(n.icon) + '</span><span class="nudge-text">' + esc(I18N.bi(n.en, n.ne)) +
      '</span><span class="nudge-go">›</span><button type="button" class="nudge-x" aria-label="close">×</button>';
    paint();
    document.addEventListener('langchange', paint);
    bar.addEventListener('click', e => {
      seen.push(n.en);
      sessionStorage.setItem('nudgeSeen', JSON.stringify(seen));
      if (e.target.closest('.nudge-x')) { e.preventDefault(); bar.remove(); }
    });
    const top = document.querySelector('.topbar');
    if (top) top.after(bar); else document.body.prepend(bar);
  }

  function langSwitcher(el) {
    if (!el) return;
    el.innerHTML = ['en', 'ne', 'mix'].map(m =>
      '<button type="button" data-lang="' + m + '" class="' + (I18N.mode() === m ? 'active' : '') + '">' +
      (m === 'en' ? 'English' : m === 'ne' ? 'नेपाली' : 'Nepanglish') + '</button>').join('');
    el.onclick = e => {
      const b = e.target.closest('button[data-lang]');
      if (!b) return;
      I18N.set(b.dataset.lang);
      langSwitcher(el);
    };
  }

  function qr(el, text, size) {
    if (!el || typeof qrcode === 'undefined') return;
    const q = qrcode(0, 'M');
    q.addData(text);
    q.make();
    el.innerHTML = q.createSvgTag({ cellSize: size || 5, margin: 2, scalable: true });
  }

  function passUrl(id) {
    return location.origin + location.pathname.replace(/[^/]*$/, '').replace(/admin\/$/, '') + 'pass.html?g=' + encodeURIComponent(id);
  }

  function msg(el, text, type) {
    if (!el) return;
    el.textContent = text;
    el.className = 'msg ' + (type || '');
    el.hidden = !text;
  }

  async function boot() {
    try {
      const c = await config();
      applyTheme(c);
      I18N.apply();
      langSwitcher(document.getElementById('langSwitch'));
      document.querySelectorAll('a[data-guest-link]').forEach(a => a.href = withGuest(a.getAttribute('href')));
      const navMem = document.getElementById('navMemorial');
      if (navMem) navMem.hidden = !on(c, 'feature.memorial');
      document.querySelectorAll('[data-feature]').forEach(el => { if (!on(c, el.dataset.feature)) el.hidden = true; });
      memberId();
      profileSwitcher(document.getElementById('whoSwitch'));
      document.addEventListener('memberchange', () => profileSwitcher(document.getElementById('whoSwitch')));
      document.querySelectorAll('.topbar nav a[href^="register.html"]').forEach(a => a.hidden = !on(c, 'feature.registration'));
      const isAdminPage = /\/admin\//.test(location.pathname);
      if (!isAdminPage && isClosed(c)) {
        const memorialPage = /memorial\.html$/.test(location.pathname);
        if (!(memorialPage && on(c, 'app.keepMemorialAfterEnd'))) {
          showClosed(c);
          throw new Error('closed');
        }
      }
      if (!isAdminPage) { setupInstall(c); startTracking(); nudges(c); }
      return c;
    } catch (e) {
      I18N.apply();
      langSwitcher(document.getElementById('langSwitch'));
      throw e;
    }
  }

  return {
    esc, guestId, withGuest, config, on, applyTheme, setSide, langSwitcher, qr, passUrl, msg, boot, isStandalone,
    memberId, household, remember, currentMember, setMember, who, profileSwitcher, refreshHousehold, siteUrl,
    venueCard, mapsUrl, signedIn, signOut
  };
})();
