      (r.Summary ? '<div><b>' + esc(r.Summary) + '</b></div>' : '') + '</td><td>' + esc(r.Status) + '</td><td>' +
      '<button class="btn ghost sm" data-star>' + (r.Starred === 'TRUE' ? '⭐' : '☆') + '</button> <button class="btn ghost sm" data-note>📝</button> ' +
      '<button class="btn sm" data-status="Approved">Show</button> <button class="btn ghost sm" data-status="Hidden">Hide</button></td></tr>').join('');
  }
  $('mediaSearch').addEventListener('input', renderMedia);
  $('mediaFilter').addEventListener('change', renderMedia);
  $('mediaTable').addEventListener('click', async e => {
    const tr = e.target.closest('tr[data-media]'); if (!tr) return;
    const r = mediaRows.find(x => x.MediaId === tr.dataset.media);
    const save = p => call('admin.mediaNote', Object.assign({ mediaId: r.MediaId, transcript: r.Transcript, summary: r.Summary, category: r.Category, starred: r.Starred === 'TRUE', audioFlag: r.AudioFlag }, p)).then(() => { Object.assign(r, p.raw || {}); renderMedia(); });
    if (e.target.closest('[data-star]')) save({ starred: r.Starred !== 'TRUE', raw: { Starred: r.Starred === 'TRUE' ? '' : 'TRUE' } });
    if (e.target.closest('[data-note]')) {
      const t = prompt('Transcript (what is said — Nepali or English):', r.Transcript || ''); if (t == null) return;
      const s = prompt('One-line summary (e.g. "Grandfather wishing long life"):', r.Summary || ''); if (s == null) return;
      save({ transcript: t, summary: s, raw: { Transcript: t, Summary: s } });
    }
  });
  $('mediaTable').addEventListener('click', async e => {
    const b = e.target.closest('[data-status]');
    if (!b) return;
    await call('admin.moderateMedia', { mediaId: b.closest('tr').dataset.media, status: b.dataset.status });
    loadMedia();
  });

  $('exportMedia').addEventListener('click', async () => {
    const rows = await call('admin.mediaExport');
    if (!rows.length) return msg('No uploads yet');
    const cols = Object.keys(rows[0]);
    const q = v => '"' + String(v == null ? '' : v).replace(/"/g, '""') + '"';
    const csv = '\ufeff' + [cols.join(',')].concat(rows.map(r => cols.map(c => q(r[c])).join(','))).join('\r\n');
    const a = document.createElement('a');
    a.href = URL.createObjectURL(new Blob([csv], { type: 'text/csv;charset=utf-8' }));
    a.download = 'wedding-media.csv';
    a.click();
  });

  // ---------- Games ----------
  let games = [];
  async function loadGames() {
    games = await call('admin.games');
    $('gameTable').innerHTML = '<tr><th>Game</th><th>Who</th><th>Points</th><th>Active</th><th></th></tr>' + games.map(g =>
      '<tr data-g="' + esc(g.GameId) + '"><td>' + esc(g.TitleEn) + '<div class="muted">' + esc(g.QuestionEn || '') + '</div></td><td>' + esc(g.Groups) +
      '</td><td>' + esc(g.Points) + '</td><td>' + (yes(g.Active) ? '✅' : '') + '</td><td><button class="btn sm" data-edit>Edit</button></td></tr>').join('');
  }
  $('gameTable').addEventListener('click', e => {
    if (!e.target.closest('[data-edit]')) return;
    const g = games.find(x => x.GameId === e.target.closest('tr').dataset.g);
    const f = $('gameForm');
    Object.keys(g).forEach(k => { if (f[k]) { if (f[k].type === 'checkbox') f[k].checked = yes(g[k]); else f[k].value = g[k]; } });
    f.scrollIntoView({ behavior: 'smooth' });
  });
  $('gameForm').addEventListener('submit', async e => {
    e.preventDefault();
    const d = Object.fromEntries(new FormData(e.target).entries());
    d.Active = e.target.Active.checked;
    await call('admin.saveGame', d);
    e.target.reset();
    msg('Game saved 🎲', 'ok');
    loadGames();
  });

  // ---------- Memorial ----------
  async function loadMemorial() {
    try {
      const m = await API.call('getMemorial');
      const f = $('momForm');
      Object.keys(m.profile || {}).forEach(k => { if (f[k]) f[k].value = m.profile[k]; });
    } catch (e) { /* memorial may be disabled */ }
    const rows = await call('admin.memories');
    $('memTable').innerHTML = '<tr><th>From</th><th>Memory</th><th>Private</th><th>Status</th><th></th></tr>' +
      rows.slice().reverse().map(r => '<tr data-mem="' + esc(r.MemoryId) + '"><td>' + esc(r.Name) + '<div class="muted">' + esc(r.Relation) + '</div></td><td style="white-space:pre-wrap">' +
        esc(r.Text) + '</td><td>' + (yes(r.IsPrivate) ? '🔒' : '') + '</td><td>' + esc(r.Status) + '</td><td>' +
        '<button class="btn sm" data-status="Approved">Approve</button> <button class="btn ghost sm" data-status="Hidden">Hide</button></td></tr>').join('');
  }

  $('memTable').addEventListener('click', async e => {
    const b = e.target.closest('[data-status]');
    if (!b) return;
    await call('admin.moderateMemory', { memoryId: b.closest('tr').dataset.mem, status: b.dataset.status });
    loadMemorial();
  });

  $('momForm').addEventListener('submit', async e => {
    e.preventDefault();
    await call('admin.saveMom', Object.fromEntries(new FormData(e.target).entries()));
    msg("Mom's profile saved 🙏", 'ok');
  });

  // ---------- Settings ----------
  async function loadSettings() {
    const rows = await call('admin.settings');
    $('settingsTable').innerHTML = '<tr><th>Setting</th><th>Value</th><th>Group</th></tr>' + rows.map(r => {
      const t = String(r.Type || 'text');
      const v = String(r.Value);
      let input;
      if (t === 'toggle') input = '<input type="checkbox"' + (yes(v) ? ' checked' : '') + '>';
      else if (t === 'color') input = '<input type="color" value="' + esc(v) + '">';
      else if (t === 'number') input = '<input type="number" value="' + esc(v) + '">';
      else if (t === 'datetime') input = '<input type="datetime-local" value="' + esc(v.slice(0, 16)) + '">';
      else if (t.indexOf('select:') === 0) input = '<select>' + t.slice(7).split(',').map(o => '<option' + (o === v ? ' selected' : '') + '>' + esc(o) + '</option>').join('') + '</select>';
      else input = '<input value="' + esc(v) + '">';
      return '<tr data-key="' + esc(r.Key) + '" data-type="' + esc(t) + '"><td><b>' + esc(r.Description || r.Key) + '</b><div class="muted">' + esc(r.Key) + '</div></td><td>' + input + '</td><td>' + esc(r.Group) + '</td></tr>';
    }).join('');
  }

  $('settingsTable').addEventListener('change', async e => {
    const tr = e.target.closest('tr[data-key]');
    if (!tr) return;
    const value = tr.dataset.type === 'toggle' ? (e.target.checked ? 'TRUE' : 'FALSE') : e.target.value;
    await call('admin.saveSetting', { key: tr.dataset.key, value: value });
    sessionStorage.removeItem('config');
    msg('Saved: ' + tr.dataset.key, 'ok');
  });

  // ---------- Boot ----------
  I18N.apply();
  App.langSwitcher($('langSwitch'));
  if (sessionStorage.getItem('adminKey')) {
    API.call('admin.login').then(start).catch(() => sessionStorage.removeItem('adminKey'));
  }
})();
